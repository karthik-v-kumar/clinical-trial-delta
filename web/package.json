{
  "name": "clinical-trial-delta-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clinical Trial Delta: static site that reads the committed data/ JSON.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "copy-data": "node scripts/copy-data.mjs",
    "predev": "npm run copy-data",
    "dev": "vite",
    "prebuild": "npm run copy-data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && node scripts/check-fetch-targets.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
