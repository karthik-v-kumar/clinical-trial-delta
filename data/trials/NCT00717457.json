 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "adult patients, 18-75 years of age;"
   },
   {
    "text": "type 2 diabetes receiving metformin and/or pioglitazone or rosiglitazone for at least 12 weeks;"
   },
   {
    "text": "HbA1c >=7.0% and <=10% at screening;"
   },
   {
    "text": "BMI >=25kg/m2 (>23kg/m2 for Asians) and <=45kg/m2 at screening;"
   },
   {
    "text": "stable weight +/- 5% for at least 12 weeks prior to screening."
   }
  ],
  "exclusion": [
   {
    "text": "history of type 1 diabetes, diabetes resulting from pancreatic injury or secondary forms of diabetes;"
   },
   {
    "text": "history of acute metabolic diabetic complications within the previous 6 months;"
   },
   {
    "text": "evidence of clinically significant diabetic complications;"
   },
   {
    "text": "known proliferative diabetic retinopathy;"
   },
   {
    "text": "myocardial infarction (MI), coronary artery bypass surgery, post-transplantation cardiomyopathy (PTCM) or stroke within the past 6 months;"
   },
   {
    "text": "any abnormality in clinical laboratory test or ECG, which precludes safe involvement in the study as judged by the investigator;"
   },
   {
    "text": "known hemoglobinopathy or chronic anemia;"
   },
   {
    "text": "clinically significant gastrointestinal disease."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
