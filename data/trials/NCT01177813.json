 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Diagnosis of type 2 diabetes mellitus prior to informed consent;"
   },
   {
    "text": "Male and female patients on diet and exercise regimen who are drug-naïve;"
   },
   {
    "text": "HbA1c >= 7.0% and <= 10.0% at Visit 1 (screening) for randomised treatment; HbA1c > 10.0% at visit 1 (screening) for the open-label BI 10773 arm;"
   },
   {
    "text": "Age >= 20 (Japan); Age >= 18 (countries other than Japan);"
   },
   {
    "text": "BMI <= 45 kg/m2 at Visit 1 (screening);"
   },
   {
    "text": "Signed and dated written informed consent by date of Visit 1"
   }
  ],
  "exclusion": [
   {
    "text": "Uncontrolled hyperglycaemia;"
   },
   {
    "text": "Acute coronary syndrome (non-STEMI, STEMI and unstable angina pectoris), stroke or TIA within 3 months prior to informed consent;"
   },
   {
    "text": "Indication of liver disease, either ALT, AST, or alkaline phosphatase above 3 x ULN;"
   },
   {
    "text": "Impaired renal function (eGFR<50 ml/min);"
   },
   {
    "text": "Bariatric surgery within the past two years or other GI surgeries;"
   },
   {
    "text": "Medical history of cancer;"
   },
   {
    "text": "Contraindications to sitagliptin;"
   },
   {
    "text": "Blood dyscrasias or any disorders causing haemolysis or unstable red blood cell;"
   },
   {
    "text": "Treatment with any anti-diabetes drug within 12 weeks prior to randomisation;"
   },
   {
    "text": "Treatment with anti-obesity drugs or any other treatment leading to unstable body weight;"
   },
   {
    "text": "Current treatment with systemic steroids or change in dosage of thyroid hormones within 6 weeks prior to informed consent or any other uncontrolled endocrine disorder except T2DM;"
   },
   {
    "text": "Pre-menopausal women who are nursing or pregnant or are of child-bearing potential and not practicing an acceptable method of birth control;"
   },
   {
    "text": "Alcohol or drug abuse;"
   },
   {
    "text": "Intake of an investigational drug in another trial within 30 days prior to intake of study medication in this trial;"
   },
   {
    "text": "Any other clinical condition that would jeopardize patients safety while participating in this clinical trial"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
