 "registry_url": "https://clinicaltrials.gov/study/NCT03399370",
 "content_hash": "d22b640c29785c10",
 "collections": [
  "cholesterol-lipids"
 ],
 "matched_queries": [
  "lipids-drugs"
 ],
 "sponsors_of_note": [],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Male or female participants ≥18 years of age."
   },
   {
    "text": "History of ASCVD (coronary heart disease [CHD], cardiovascular disease [CVD], or peripheral arterial disease [PAD])."
   },
   {
    "text": "Serum LDL-C ≥1.8 millimole (mmol)/liter (L) (≥70 mg/dL)."
   },
   {
    "text": "Fasting triglyceride <4.52 mmol/L (<400 mg/dL) at screening."
   },
   {
    "text": "Participants on statins should be receiving a maximally tolerated dose."
   },
   {
    "text": "Participants not receiving statins must have documented evidence of intolerance to all doses of at least 2 different statins."
   },
   {
    "text": "Subjects on lipid-lower therapies (such as a statin and/or ezetimibe) should be on a stable dose for ≥30 days before screening with no planned medication or dose change during study participation."
   }
  ],
  "exclusion": [
   {
    "text": "New York Heart Association (NYHA) class IV heart failure."
   },
   {
    "text": "Uncontrolled cardiac arrhythmia"
   },
   {
    "text": "Uncontrolled severe hypertension"
   },
   {
    "text": "Active liver disease"
   },
   {
    "text": "Females who are pregnant or nursing, or who are of childbearing potential and unwilling to use at least 2 methods of highly effective contraception (failure rate less than 1% per year) (for example, combined oral contraceptives, barrier methods, approved contraceptive implant, long-term injectable contraception, or intrauterine device) for the entire duration of the study. Exemptions from this criterion:",
    "sub_items": [
     "Women >2 years postmenopausal (defined as 1 year or longer since last menstrual period) and more than 55 years of age.",
     "Postmenopausal women (as defined above) and less than 55 years of age with a negative pregnancy test within 24 hours of randomization.",
     "Women who are surgically sterilized at least 3 months prior to enrollment."
    ]
   },
   {
    "text": "Males who are unwilling to use an acceptable method of birth control during the entire study period (such as condom with spermicide)."
   },
   {
    "text": "Treatment with other investigational products or devices within 30 days or 5 half-lives of the screening visit, whichever is longer."
   },
   {
    "text": "Treatment (within 90 days of screening) with monoclonal antibodies directed towards PCSK9"
   },
   {
    "text": "The above information is not intended to contain all considerations relevant to a participant's potential participation in a clinical trial."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
