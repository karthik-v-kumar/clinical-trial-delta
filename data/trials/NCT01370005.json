 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Patients >=18 years with type 2 diabetes"
   },
   {
    "text": "HbA1c of >= 7.0% (53 mmol/mol) and =< 10% (86 mmol/mol)"
   },
   {
    "text": "Mean seated systolic blood pressure 130-159 mmHg and diastolic blood pressure 80-99 mmHg"
   }
  ],
  "exclusion": [
   {
    "text": "Uncontrolled hyperglycaemia with a glucose level >240 mg/dl (>13.3 mmol/L) after an overnight fast before randomization"
   },
   {
    "text": "Known or suspected secondary hypertension"
   },
   {
    "text": "Acute coronary syndrome (non-STEMI, STEMI and unstable angina pectoris), stroke or transient ischemic attack within 3 months prior to informed consent"
   }
  ],
  "notes": []
 },
