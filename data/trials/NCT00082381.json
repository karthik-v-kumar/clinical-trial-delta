 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Patients have been treated with a stable dose of one of the following for at least 3 months prior to screening: 1. 1500 to 2550 mg/day immediate-release metformin (or 1500 to 2000 mg/day extended-release metformin) and at least an optimally effective dose of a sulfonylurea, or 2. a fixed-dose sulfonylurea/metformin combination therapy with the same sulfonylurea and metformin requirements as for the individual components."
   },
   {
    "text": "HbA1c between 7.0% and 10.0%, inclusive."
   },
   {
    "text": "History of stable body weight (not varying by >10% for at least three months prior to screening)."
   },
   {
    "text": "Female patients are not breastfeeding, and female patients of childbearing potential (not surgically sterilized and between menarche and 1-year postmenopause)"
   }
  ],
  "exclusion": [
   {
    "text": "Patients are investigator site personnel directly affiliated with the study, or are immediate family of investigator site personnel directly affiliated with the study."
   },
   {
    "text": "Patients are employed by Lilly or Amylin."
   },
   {
    "text": "Patients have participated in this study previously or any other study using AC2993 or GLP-1 analogs."
   },
   {
    "text": "Patients have participated in an interventional medical, surgical, or pharmaceutical study within 30 days prior to screening. This criterion includes drugs that have not received regulatory approval for any indication at the time of study entry."
   },
   {
    "text": "Patients have had greater than three episodes of severe hypoglycemia within 6 months prior to screening."
   },
   {
    "text": "Patients are undergoing therapy for a malignancy, other than basal cell or squamous cell skin cancer."
   },
   {
    "text": "Patients have cardiac disease that is Class III or IV, according to the New York Heart Association criteria."
   },
   {
    "text": "Patients have a known allergy or hypersensitivity to insulin glargine, AC2993, or excipients contained in these agents."
   },
   {
    "text": "Patients have characteristics contraindicating metformin or sulfonylurea use, according to product-specific label, in the opinion of the investigator."
   },
   {
    "text": "Patients have a history of renal transplantation or are currently receiving renal dialysis or have serum creatinine >=1.5 mg/dL for males and >=1.3 mg/dL for females."
   },
   {
    "text": "Patients have obvious clinical signs or symptoms of liver disease, acute or chronic hepatitis, or alanine aminotransferase/serum glutamicpyruvic transaminase greater than three times the upper limit of the reference range."
   },
   {
    "text": "Patients have known hemoglobinopathy or chronic anemia."
   },
   {
    "text": "Patients are receiving chronic (lasting longer than 2 weeks) systemic glucocorticoid therapy (excluding topical and inhaled preparations) or have received such therapy within 2 weeks immediately prior to screening."
   },
   {
    "text": "Patients have used any prescription drug to promote weight loss within 3 months prior to screening."
   },
   {
    "text": "Patients have any other condition (including known drug or alcohol abuse or psychiatric disorder) that precludes them from following and completing the protocol, in the opinion of the investigator."
   },
   {
    "text": "Patients fail to satisfy the investigator of suitability to participate for any other reason."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
