 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "BMI above or equal to 25 and below or equal to 40 kg/m^2"
   },
   {
    "text": "Subjects diagnosed with T2D (Type 2 diabetes) treated with diet and exercise and/or who have been on a stable dose of metformin for at least 30 days prior to screening"
   },
   {
    "text": "HbA1c 7.0-9.5% (53-80 mmol/mol) (both inclusive)"
   }
  ],
  "exclusion": [
   {
    "text": "Subjects on selected oral medication with a narrow therapeutic window, such as warfarin, digoxin, tricyclic antidepressants, lithium, aminophylline, theophylline and anticonvulsants"
   },
   {
    "text": "History of chronic pancreatitis or idiopathic acute pancreatitis"
   },
   {
    "text": "Chronic malabsorption, regardless of aetiology"
   },
   {
    "text": "History of Crohn's disease, ulcerative colitis, or other inflammatory bowel disease"
   },
   {
    "text": "Treatment with glucose lowering agent(s) other than metformin as stated in the inclusion criteria in a period of 90 days before the screening visit"
   }
  ],
  "notes": []
 },
