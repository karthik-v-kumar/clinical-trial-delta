 "registry_url": "https://clinicaltrials.gov/study/NCT02320721",
 "content_hash": "483fbef09def5c5a",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-drugs"
 ],
 "sponsors_of_note": [],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Participants ≥65 years old with type 2 diabetes mellitus, inadequately controlled on antidiabetic regimens either including no insulin, or with basal insulin as their only insulin."
   },
   {
    "text": "Signed informed consent."
   }
  ],
  "exclusion": [
   {
    "text": "HbA1c at screening visit:",
    "sub_items": [
     "<7.0% or >10.0% for participants taking basal insulin.",
     "<7.5% or >11.0% for insulin-naïve participants."
    ]
   },
   {
    "text": "History of type 2 diabetes mellitus for less than 1 year before screening."
   },
   {
    "text": "Participants not on stable basal insulin dose (±10% in the last 8 weeks prior to screening visit)."
   },
   {
    "text": "Change in dose of antidiabetic treatment or initiation of new glucose-lowering medications in the last 8 weeks prior to screening."
   },
   {
    "text": "Chronic (>10 days continuous use in previous 6 months) use of bolus insulin injections, whether given separately or as part of a combination with basal insulin, e.g. premix insulin; For insulin-naïve individuals: current or previous insulin use except for a maximum of 10 consecutive days (e.g. acute illness, surgery) during the last year prior to screening."
   },
   {
    "text": "Cognitive disorder and dementia assessed clinically and by Mini-Mental State Examination (MMSE) score <24, or any neurologic disorder that would likely affect the participant's ability to follow the study procedure. The participant would be eligible despite an MMSE score <24 if the investigator determined that the low score reflected educational or cultural background and not dementia as long as the participant was otherwise able to meet the study requirements."
   },
   {
    "text": "Participants who had end-stage renal disease (<15 mL/min/1.73m^2, per estimated Glomerular filtration rate (eGFR) measurement by Modification of Diet in Renal Disease (MDRD)."
   },
   {
    "text": "The above information was not intended to contain all considerations relevant to a participant's potential participation in a clinical trial."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
