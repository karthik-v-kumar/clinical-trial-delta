 "registry_url": "https://clinicaltrials.gov/study/NCT02461589",
 "content_hash": "064f2d389a5e9d93",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-sponsors"
 ],
