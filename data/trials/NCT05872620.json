 "registry_url": "https://clinicaltrials.gov/study/NCT05872620",
 "content_hash": "2984a3565c4fe6eb",
 "collections": [
  "glp1-obesity",
  "type-2-diabetes"
 ],
 "matched_queries": [
  "glp1-obesity-drugs",
  "glp1-obesity-sponsors",
  "t2d-sponsors"
 ],
 "sponsors_of_note": [
  "Eli Lilly"
 ],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Have a body mass index (BMI) ≥27.0 kilogram/square meter (kg/m²)."
   },
   {
    "text": "Have a history of at least 1 self-reported unsuccessful dietary effort to lose body weight."
   },
   {
    "text": "Have a diagnosis of Type 2 Diabetes (T2D), with HbA1c ≥7% (≥53 mmol/mol) to ≤10% (86 mmol/mol) and are on stable treatment for T2D for at least 90 days prior to screening, consisting of:",
    "sub_items": [
     "either diet/exercise alone or",
     "up to 3 oral antihyperglycemic medications (excluding dipeptidyl peptidase IV inhibitors (DPP-4i) or glucagon-like peptide-1 (GLP-1) receptor agonists (RA)."
    ]
   }
  ],
  "exclusion": [
   {
    "text": "Have Type 1 Diabetes (T1D), history of ketoacidosis or hyperosmolar state/coma, or any other types of diabetes except T2D."
   },
   {
    "text": "Have a self-reported change in body weight >5 kg (11 pounds) within 90 days prior to screening."
   },
   {
    "text": "Are currently receiving or planning to receive treatment for diabetic retinopathy and/or macular edema (for example, laser photocoagulation or intravitreal injections of anti-vascular endothelial growth factor inhibitors)."
   },
   {
    "text": "Have family (first-degree relative) or personal history of medullary thyroid cancer (MTC) or multiple endocrine neoplasia 2 (MEN2) syndrome."
   },
   {
    "text": "Have had a history of chronic or acute pancreatitis."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
