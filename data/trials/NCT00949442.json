 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Insulin-naïve type 2 diabetes mellitus"
   },
   {
    "text": "Type 2 diabetes mellitus diagnosed for at least 1 year"
   },
   {
    "text": "Treated with at least one OAD (Metformin [daily dose of at least 1000mg], Sulfonylurea, glinides or alpha-glucosidase inhibitor) at stable dose for at least 3 months."
   },
   {
    "text": "HbA1c > or = 7.0% and < or = 10.5%"
   },
   {
    "text": "BMI < 40 kg/m²"
   },
   {
    "text": "Ability and willingness to perform plasma glucose monitoring using the sponsor-provided glucose meter and patient diary at home"
   },
   {
    "text": "Informed consent obtained in writing at enrolment into the study"
   },
   {
    "text": "Willingness and ability to comply with the study protocol"
   }
  ],
  "exclusion": [
   {
    "text": "Treatment with GLP-1 agonists or with DPP-IV inhibitors in the 3 months prior to study entry"
   },
   {
    "text": "Treatment with TZD as monotherapy"
   },
   {
    "text": "Diabetes mellitus other than Type 2 (e.g. secondary to pancreatic disorders, drugs or chemical agents intake...)"
   },
   {
    "text": "Active proliferative retinopathy, as defined by a photocoagulation or vitrectomy occurrence in the 6 months prior to visit 1, or any other unstable (rapidly progressing) retinopathy that may require photocoagulation or surgical treatment during the study (an optic fundus examination should have been performed within the 2 years prior to study entry)"
   },
   {
    "text": "Impaired renal function: serum creatinine > or =1.5 mg/dL (> or = 133µmol/L) or > or = 1.4 mg/dL (> or = 124 µmol/L) in men and women, respectively"
   },
   {
    "text": "History of sensitivity to the study drugs or to drugs with a similar chemical structure"
   },
   {
    "text": "Impaired hepatic function (ALT and/or AST > 3 x upper limit of normal range)"
   },
   {
    "text": "Pregnant or lactating women (women of childbearing potential must have a negative pregnancy test at study entry and a medically approved contraception method),"
   },
   {
    "text": "Treatment with systemic corticosteroids within the 3 months prior to study entry or likelihood of requiring treatments during the study which are not permitted."
   },
   {
    "text": "Treatment with an investigational product in the 30 days prior to visit 1"
   },
   {
    "text": "Alcohol or drug abuse in the last year"
   },
   {
    "text": "Presence of any condition (medical, psychological, social or geographical), current or anticipated that the Investigator feels would compromise the patient's safety or limit the patient successful participation in the study (including night shift worker)"
   },
   {
    "text": "The above information is not intended to contain all considerations relevant to a patient's potential participation in a clinical trial."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
