 "registry_url": "https://clinicaltrials.gov/study/NCT06066515",
 "content_hash": "652e0a04da0024d6",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-sponsors"
 ],
 "sponsors_of_note": [
  "Boehringer Ingelheim"
 ],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Male or female, age ≥18 years at the time of signing informed consent, and at least the legal age of consent in countries where it is >18 years"
   },
   {
    "text": "Body mass index (BMI) ≥30 kg/m^2 at screening, OR BMI ≥27 kg/m^2 with the presence of at least one of the obesity-related complications (treated or untreated) e.g,:",
    "sub_items": [
     "Hypertension (defined as repeated, i.e. at least 3 measurements in resting condition, systolic blood pressure (SBP) values of ≥140 millimetre of mercury (mmHg) and/or diastolic blood pressure (DBP) values of ≥90 mmHg in the absence of anti-hypertensive treatment, or intake of at least 1 anti-hypertensive drug to maintain a normotensive blood pressure)",
     "Dyslipidaemia (defined as at least 1 lipid-lowering treatment required to maintain normal blood lipid levels, or low-density lipoprotein (LDL) cholesterol ≥160 mg/dL (≥4.1 mmol/L), or triglycerides ≥150 mg/dL (≥1.7 mmol/L), or high-density lipoprotein (HDL) cholesterol <40 mg/dL (<1.0 mmol/L) for men or HDL cholesterol 50 mg/dL (<1.3 mmol/L) for women)",
     "Obstructive sleep apnoea",
     "Others."
    ]
   },
   {
    "text": "History of at least one self-reported unsuccessful dietary effort to lose body weight."
   },
   {
    "text": "Further inclusion criteria apply."
   }
  ],
  "exclusion": [
   {
    "text": "Body weight change (self-reported) of >5% within 3 months before screening."
   },
   {
    "text": "Treatment with any medication for the indication obesity within 3 months before screening."
   },
   {
    "text": "Glycosylated haemoglobin A1c (HbA1c) ≥6.5% (≥48 mmol/mol) as measured by the central laboratory at screening."
   },
   {
    "text": "History of type 1 diabetes mellitus (T1DM) or type 2 diabetes mellitus (T2DM) or treatment with glucose lowering agent started within 3 months before the screening up to and including the randomisation visit."
   },
   {
    "text": "Heart failure (HF) with New York Heart Association (NYHA) functional class IV."
   },
   {
    "text": "Known clinically significant gastric emptying abnormality (e.g. severe diabetic gastroparesis or gastric outlet obstruction)."
   },
   {
    "text": "History of either chronic or acute pancreatitis or elevation of serum lipase or serum pancreatic amylase >2x upper limit of normal (ULN) as measured by the central laboratory at screening."
   },
   {
    "text": "Personal or family history of medullary thyroid carcinoma (MTC) or multiple endocrine neoplasia syndrome type 2 (MEN 2)."
   },
   {
    "text": "Further exclusion criteria apply."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
