 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "All patients must have a diagnosis of T2DM and be currently treated with metformin IR"
   },
   {
    "text": "Patients in the study must have a HbA1c between >=7 and <=10.5%"
   },
   {
    "text": "Patients must have a fasting plasma glucose (FPG) <270 mg/dL (15 mmol/L)"
   }
  ],
  "exclusion": [
   {
    "text": "History of diabetic ketoacidosis, type 1 diabetes mellitus (T1DM), pancreas or beta cell transplantation, diabetes secondary to pancreatitis or pancreatectomy, or a severe hypoglycemic episode within 6 months before screening"
   }
  ],
  "notes": []
 },
