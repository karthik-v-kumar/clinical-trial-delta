  {
   "measure": "Mean Change in Meal Stimulated Insulin Secretion Rate (ISR) Relative to Glucose 0-2 Hours, From Baseline to 4 Weeks.",
   "time_frame": "Baseline, 4 weeks"
  }
 ],
 "brief_summary": "This was a 10-week, placebo-controlled, randomized study to investigate the effect of injectable IL-1B antagonist, Canakinumab , in participants with impaired glucose tolerance or Type 2 Diabetes Mellitus (T2DM) already treated on different background diabetes therapies.",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n1. Patient must fulfill all criteria in one of the following groups:\n\n   * Impaired Glucose Tolerance (IGT) as diagnosed per protocol and not on an anti-diabetic medicine during the study\n   * Diagnosis of Type 2 diabetes in stable treatment with metformin\n   * Diagnosis of Type 2 diabetes in stable treatment with metformin (at least 1000 mg/day) in combination with a sulfonylurea\n   * Diagnosis of Type 2 diabetes in stable treatment with metformin (at least 1000 mg/day), sulfonylurea and thiazolidinedione combination therapy\n   * Diagnosis of Type 2 diabetes in stable treatment with at least two insulin injections a day with or without metformin\n2. HbA1c between 6.5% and 8%, inclusive, at Screening; this criterion does not apply to the IGT group\n3. Age from 18-74 years, inclusive, and of either sex\n\nExclusion Criteria:\n\n1. Type 1 diabetes or diabetes that is a result of pancreatic injury or other secondary forms of diabetes\n2. History or current findings of active pulmonary disease (e.g. tuberculosis, fungal diseases) as defined in the protocol:\n3. Known presence or suspicion of active or recurrent bacterial, fungal or viral infection at the time of enrollment proven.",
  "sex": "ALL",
  "minimum_age": "18 Years",
  "maximum_age": "74 Years",
  "healthy_volunteers": false,
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
