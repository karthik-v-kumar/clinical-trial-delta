 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Participants with hypercholesterolemia and hypertriglyceridemia."
   },
   {
    "text": "Participants had the following fasting lipid results following a greater than or equal to 12 hour fasting period (measured at the Screening Visit(s)):",
    "sub_items": [
     "Triglycerides level greater than or equal to 150 milligrams/deciliter (mg/dL) and less than 400 milligrams/deciliter, and",
     "Low-density lipoprotein cholesterol greater than or equal to 160 milligrams/deciliter and less than or equal to 240 milligrams/deciliter."
    ]
   }
  ],
  "exclusion": [
   {
    "text": "Participants with certain chronic or unstable medical conditions."
   },
   {
    "text": "Participants receiving coumarin anticoagulants, systemic cyclosporins, or certain other medications."
   },
   {
    "text": "Pregnant or lactating women, or women intending to become pregnant."
   },
   {
    "text": "Participants with diabetes mellitus that is poorly controlled."
   },
   {
    "text": "Participant was of Asian ancestry (having Filipino, Chinese, Japanese, Korean, Vietnamese, or Asian-Indian origin)."
   }
  ],
