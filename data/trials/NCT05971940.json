 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Have Type 2 Diabetes"
   },
   {
    "text": "Have HbA1c ≥7.0% (53 mmol/mol) to ≤9.5% (80 mmol/mol) despite diet and exercise treatment, as determined by the central laboratory at screening."
   },
   {
    "text": "Are naïve to insulin therapy except for gestational diabetes or ≤14 days use for acute treatment and have not used any oral or injectable antihyperglycemic medications during the 90 days preceding screening or between screening and randomization."
   },
   {
    "text": "Are of stable weight (±5%) for at least 90 days prior to screening and agree to not initiate an intensive diet or exercise program during the study with the intent of reducing body weight other than the lifestyle and/or dietary measures for diabetes treatment."
   },
   {
    "text": "Have a body mass index (BMI) ≥23.0 kilogram/square meter (kg/m²) at screening."
   }
  ],
  "exclusion": [
   {
    "text": "Have Type 1 Diabetes"
   },
   {
    "text": "Have a history of ketoacidosis or hyperosmolar state or coma within the last 6 months prior to screening, or between screening and randomization."
   },
   {
    "text": "Currently receiving or planning to receive treatment for diabetic retinopathy and/or macular edema"
   },
   {
    "text": "Have New York Heart Association functional classification IV congestive heart failure."
   },
   {
    "text": "Have acute or chronic pancreatitis"
   }
  ],
  "notes": []
 },
