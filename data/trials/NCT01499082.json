 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Participants with type 2 diabetes mellitus"
   },
   {
    "text": "Completion of the 6-month study period in main study (Visit 10)"
   },
   {
    "text": "Randomized and treated with insulin glargine new formulation during the 6-month treatment period (Baseline - month 6)"
   }
  ],
  "exclusion": [
   {
    "text": "Age less than (<) 18 years"
   },
   {
    "text": "HbA1c <7.0% or greater than (>) 10% at screening"
   },
   {
    "text": "Diabetes other than type 2 diabetes mellitus"
   },
   {
    "text": "Less than 1 year on basal plus mealtime insulin and self-monitoring of blood glucose"
   },
   {
    "text": "Any contraindication to use of insulin glargine as defined in the national product label"
   },
   {
    "text": "Participants using human regular insulin as mealtime insulin in the last 3 months before screening visit"
   },
   {
    "text": "Use of an insulin pump in the last 6 months before screening visit"
   },
   {
    "text": "Initiation of new glucose-lowering agents and/or weight loss drugs in the last 3 months before screening visit"
   },
   {
    "text": "History or presence of significant diabetic retinopathy or macular edema likely to require laser or injectable drugs or surgical treatment during the study period"
   },
   {
    "text": "Pregnant or breast-feeding women or women who intend to become pregnant during the study period"
   },
   {
    "text": "Participant not willing to use the adaptable injection intervals on at least two days per week"
   },
   {
    "text": "The above information is not intended to contain all considerations relevant to a participant's potential participation in a clinical trial."
   }
  ],
  "notes": []
 },
