  "Regeneron"
 ],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Participants diagnosed with Type 1 or Type 2 diabetes at least one year prior to the screening visit (Week -3)."
   },
   {
    "text": "Signed written informed consent"
   },
   {
    "text": "Participants with type 1 or type 2 diabetes treated with insulin whose LDL-C levels were not adequately controlled with maximally tolerated lipid-modifying therapy"
   },
   {
    "text": "LDL-C of 70 mg/dL or greater"
   },
   {
    "text": "18 years of age or more"
   },
   {
    "text": "Glycosylated hemoglobin (HbA1c) less than 10%"
   },
   {
    "text": "History of cardiovascular disease (including coronary heart disease [CHD] and/or CHD risk equivalents) and/or at least one additional cardiovascular risk factor"
   }
  ],
  "exclusion": [
   {
    "text": "Not on a stable dose of statin or other lipid modifying therapy for at least 4 weeks prior to screening or from screening to randomization, unless statin intolerant"
   },
   {
    "text": "Triglycerides >400 mg/dL"
   },
   {
    "text": "Estimated glomerular filtration rate (eGFR) <15 mL/min/1.73 m² according to the Modification of Diet in Renal Disease (MDRD) equation"
   },
   {
    "text": "Currently received or planned to receive renal replacement therapy (for example, hemodialysis)"
   },
   {
    "text": "Change in weight of more than 5 kilograms within the prior 2 months"
   },
   {
    "text": "Not on a stable dose/regimen of insulin or other antidiabetic drugs for the past 3 months or planned to intensify insulin regimen during the study"
   },
   {
    "text": "Not treated with insulin for at least 6 months"
   },
   {
    "text": "Planned to start new lipid modifying therapy or change dose of current lipid modifying therapy during the study"
   },
   {
    "text": "Body mass index (BMI) >45 kg/m² or planned to undergo bariatric surgery, weight loss program, or initiate weight loss drugs during the study"
   },
   {
    "text": "History of recent decompensation of diabetes within the prior 2 months (for example, diabetic ketoacidosis)"
   },
   {
    "text": "The above information was not intended to contain all considerations relevant to a participant's potential participation in a clinical trial."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
