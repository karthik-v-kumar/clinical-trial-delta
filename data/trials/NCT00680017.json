 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Dyslipidemic participants with Chronic Kidney Disease Stage 3"
   },
   {
    "text": "For entry into the Treatment Phase (Visit 3), the participant satisfied the following laboratory criteria (measured at the Screening Visit[s]):",
    "sub_items": [
     "Estimated glomerular filtration rate between 30 and 59 mL/min/1.73 m2 (Chronic Kidney Disease Stage 3) by simplified 4 variable Modification of Diet in Renal Disease formula (this includes a 10 percent variation in the upper limit of estimated glomerular filtration rate that was allowed for the enrollment of participants to account for variability in the creatinine assay).",
     "Fasting lipid results following greater than or equal to 12-hour fasting period:"
    ]
   },
   {
    "text": "Triglycerides level greater than or equal to 150 mg/dL,"
   },
   {
    "text": "High-density lipoprotein cholesterol less than 40 mg/dL for males and less than 50 mg/dL for females, and"
   },
   {
    "text": "Low-density lipoprotein cholesterol greater than or equal to 130 mg/dL Exclusion Criteria"
   },
   {
    "text": "Participants with certain chronic or unstable medical conditions."
   },
   {
    "text": "Participants with unstable dose of medications or receiving coumarin anticoagulants, systemic cyclosporine, or certain other medications."
   },
   {
    "text": "Pregnant or lactating women, or women intending to become pregnant."
   },
   {
    "text": "Participants with diabetes mellitus that is poorly controlled."
   },
   {
    "text": "Participants of Asian ancestry (having Filipino, Chinese, Japanese, Korean, Vietnamese, or Asian-Indian origin)."
   }
  ],
  "exclusion": [],
  "notes": []
 },
