 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Diagnosis typ 2 diabetes mellitus"
   },
   {
    "text": "Male and female on diet and exercise regimen, pre-treated with metformin 12 weeks prior to randomisation"
   },
   {
    "text": "HbA1c equal or greater than 7.0% and less than or equal to 10% at visit 1"
   },
   {
    "text": "18 years or more"
   },
   {
    "text": "BMI equal or less than 45Kg/m2"
   }
  ],
  "exclusion": [
   {
    "text": "Uncontrolled hyperglycemia defined as glucose more that 13.3 mmol/L after overnight fast during placebo run-in"
   },
   {
    "text": "Any other antidiabetic drug within 12 weeks prior to randomisation except metformin"
   },
   {
    "text": "Acute coronary syndrome (non-STEMI, STEMI unstable angina pectoris), stroke or transient ischemic attack within 12 weeks of informed consent"
   },
   {
    "text": "Indication of liver disease"
   },
   {
    "text": "Moderate to severe renal impairment"
   },
   {
    "text": "Bariatric surgery within past 2 years"
   },
   {
    "text": "Medical history of cancer or treatment for cancer within last 5 years"
   },
   {
    "text": "Blood dyscrasias or any disorders causing haemolysis or unstable red blood cell"
   },
   {
    "text": "Contraindications hypersensitivity to concomitant drugs"
   },
   {
    "text": "Treatment with anti-obesity drugs"
   }
  ],
  "notes": []
 },
