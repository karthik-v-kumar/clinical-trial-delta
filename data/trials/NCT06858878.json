  "parsed": true,
  "inclusion": [
   {
    "text": "Age ≥ 18 years."
   },
   {
    "text": "Body mass index ≥ 27 kg/m^2."
   },
   {
    "text": "History of at least 1 self-reported unsuccessful attempt at weight loss by diet and exercise."
   },
   {
    "text": "Diagnosis of T2DM."
   }
  ],
  "exclusion": [
   {
    "text": "Type 1 diabetes mellitus."
   },
   {
    "text": "Self-reported change in body weight > 5 kg within 90 days before screening."
   },
   {
    "text": "Proliferative diabetic retinopathy OR diabetic macular edema OR non-proliferative diabetic retinopathy that requires acute treatment."
   },
   {
    "text": "Obesity induced by other endocrinologic disorders."
   },
   {
    "text": "Family (first-degree relative[s]) or personal history of medullary thyroid carcinoma (MTC) or multiple endocrine neoplasia syndrome type 2."
   },
   {
    "text": "History of chronic pancreatitis or history of acute pancreatitis within 180 days before screening."
   },
   {
    "text": "History of unstable major depressive disorder (MDD) or other severe psychiatric disorder within 2 years before screening."
   },
   {
    "text": "Lifetime history of suicide attempt."
   }
  ],
