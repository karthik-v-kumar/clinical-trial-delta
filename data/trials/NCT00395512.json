 "registry_url": "https://clinicaltrials.gov/study/NCT00395512",
 "content_hash": "dbea7ade514a5f3b",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-drugs"
 ],
 "sponsors_of_note": [],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Historical diagnosis of type 2 diabetes."
   },
   {
    "text": "Failed treatment with diet and exercise for at least 2 months prior to Screening."
   },
   {
    "text": "Is experiencing inadequate glycemic control as defined as glycosylated hemoglobin concentration between 7.5-11%, inclusive."
   },
   {
    "text": "Has received any antidiabetic therapy for less than 7 days within 3 months prior to Screening."
   },
   {
    "text": "Has a body mass index greater than or equal to 23 kg/m2 and less than or equal to45 kg/m2."
   },
   {
    "text": "Fasting C-peptide greater than or equal to 0.8 ng per mL."
   },
   {
    "text": "Regular use of other, non-excluded medications is allowed if participant is on a stable dose for at least 4 weeks prior to Screening."
   },
   {
    "text": "Females of childbearing potential who are sexually active must agree to use adequate contraception, and can neither be pregnant nor lactating from Screening throughout the duration of the study."
   },
   {
    "text": "Must be willing and able to monitor their blood concentrations with a home glucose monitor."
   }
  ],
  "exclusion": [
   {
    "text": "Systolic blood pressure greater than or equal to 160 mmHg and diastolic blood pressure greater than or equal to 100 mmHg."
   },
   {
    "text": "Hemoglobin less than or equal to 12 g per dL for males and less than or equal to 10 g per dL for females."
   },
   {
    "text": "Alanine aminotransferase greater than or equal to 2.5times the upper limit of normal."
   },
   {
    "text": "Serum creatinine greater than 2.0 mg per dL."
   },
   {
    "text": "Thyroid stimulating hormone level greater than the upper limit of normal range."
   },
   {
    "text": "Major illness or debility that in the investigator's opinion prohibits the subject from completing the study."
   },
   {
    "text": "Urine albumin to creatinine ratio of greater than 1000 ug per mg at Screening. If elevated, the subject may be rescreened within 1 week."
   },
   {
    "text": "History of cancer, other than squamous cell or basal cell carcinoma of the skin, that has not been in full remission for at least 5 years prior to Screening"
   },
   {
    "text": "History of laser treatment for proliferative diabetic retinopathy within 6 months prior to Screening."
   },
   {
    "text": "History of gastroparesis."
   },
   {
    "text": "Has New York Heart Association Class I to IV heart failure regardless of therapy."
   },
   {
    "text": "History of coronary angioplasty, coronary stent placement, coronary bypass surgery, or myocardial infarction within 6 months prior to Screening."
   },
   {
    "text": "History of any hemoglobinopathy that may affect determination of glycosylated hemoglobin."
   },
   {
    "text": "History of infection with hepatitis B, hepatitis C, or human immunodeficiency virus."
   },
   {
    "text": "History of a psychiatric disorder that will affect participant's ability to participate in the study."
   },
   {
    "text": "History of angioedema in association with use of angiotensin-converting enzyme inhibitors or angiotensin-II receptor inhibitors."
   },
   {
    "text": "Any alteration in angiotensin-II receptor inhibitors within 2 months prior to Randomization, if applicable."
   },
   {
    "text": "History of alcohol (defined as regular or daily consumption of more than 4 alcoholic drinks per day) or substance abuse (defined as illicit drug use) within 2 years prior to Screening."
   },
   {
    "text": "Received any investigational drug within 30 days prior to Screening or a history of receipt of an investigational antidiabetic drug within 3 months prior to Screening."
   },
   {
    "text": "Previously participated in an investigational study of SYR-322."
   },
   {
    "text": "Glycosylated hemoglobin concentration between 7.5-11%, inclusive, and a fasting plasma glucose less than 310 mg per dL."
   },
   {
    "text": "At least 75% compliant with the single-blind placebo regimen during the run-in/stabilization period."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
