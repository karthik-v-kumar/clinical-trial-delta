  "inclusion": [
   {
    "text": "Subjects with mixed dyslipidemia (trigylcerides, > or = to 150 mg/dL to < 400 mg/dL; HDL-C < 40 mg/dL for males, < 50 mg/dL for females; LDL-C, > or = to 130 mg/dL)."
   },
   {
    "text": "Subjects must agree to use adequate birth control methods and to adhere to the American Heart Association (AHA) Diet."
   }
  ],
  "exclusion": [
   {
    "text": "Subjects with unstable or uncontrolled medical conditions considered inappropriate in a clinical trial."
   },
   {
    "text": "Subjects with an unstable dose of medications or receiving Coumadin, oral, intravenous or intramuscular cyclosporine, statins, or certain other medications."
   },
   {
    "text": "Women who are pregnant or plan on becoming pregnant, or women who are lactating."
   }
