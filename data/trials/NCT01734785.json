 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Diagnosis of type 2 diabetes mellitus."
   },
   {
    "text": "Male and female patients on diet and exercise regimen, pre-treated with immediate release metformin for at least 12 weeks, and patients should be on a dose higher or equal to 1500 mg/day of metformin, or maximum tolerated dose, or maximum dose as per local label."
   },
   {
    "text": "HbA1c higher or equal to 8.0% and lower or equal to 10.5% at screening visit."
   },
   {
    "text": "Age 18 years or more at screening."
   },
   {
    "text": "Body Mass Index lower or equal to 45 kg/m2 at screening visit."
   },
   {
    "text": "Signed and dated written informed consent."
   }
  ],
  "exclusion": [
   {
    "text": "Uncontrolled hyperglycemia with glucose level above 270 mg/dl (above 15 mmol/dl) after an overnight fast."
   },
   {
    "text": "Use of any other antidiabetic drug (except metformin background therapy)."
   },
   {
    "text": "Acute coronary syndrome, stroke or TIA within 3 months prior to informed consent."
   },
   {
    "text": "Indication of liver disease."
   },
   {
    "text": "Impaired renal function."
   },
   {
    "text": "Gastrointestinal surgery."
   },
   {
    "text": "Treatment with anti-obesity drugs within 3 months prior to screening, or any other treatment at the time of screening (i.e. surgery, aggressive diet regimen, etc.) leading to unstable body weight."
   },
   {
    "text": "Current treatment with systemic steroids at time of informed consent or uncontrolled endocrine disorder except type 2 diabetes mellitus."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
