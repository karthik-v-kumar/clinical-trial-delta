 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Males and females (age 18-75 years)."
   },
   {
    "text": "Non-pregnant, non-lactating females"
   },
   {
    "text": "Women of child bearing potential should use sustained contraceptive preparations or an approved mechanical contraceptive method."
   },
   {
    "text": "Eligible and able to participate and have given informed consent"
   },
   {
    "text": "Must have been following a restrictive diet and does not eat or drink grapefruit"
   },
   {
    "text": "Diagnosis of primary hypercholesterolemia or combined dyslipidemia"
   },
   {
    "text": "Available for every clinic visit, which will occur in the morning."
   }
  ],
  "exclusion": [
   {
    "text": "Homozygous familial hypercholesterolemia or familial hypoalphalipoproteinemia"
   },
   {
    "text": "Conditions which may cause secondary dyslipidemia."
   },
   {
    "text": "Condition which might significantly alter the absorption, distribution, metabolism, or excretion of any drug."
   },
   {
    "text": "History of pancreatic injury or pancreatitis, or impaired pancreatic function/injury"
   },
   {
    "text": "Liver injury"
   },
   {
    "text": "Impaired renal function"
   },
   {
    "text": "Current obstruction of the urinary tract or difficulty in voiding due to mechanical as well as inflammatory conditions, which is likely to require intervention during the course of the study or is regarded as clinically meaningful by the investigator"
   },
   {
    "text": "Serum creatine kinase (CK) >5 x upper limit of the reference range (ULRR)."
   },
   {
    "text": "Uncontrolled hypothyroidism"
   },
   {
    "text": "Severe acute illness or severe trauma in the last 3 months"
   },
   {
    "text": "Major surgery, 3 months prior to Visit 1"
   },
   {
    "text": "Significant cardiovascular disease (CVD) prior to randomization"
   },
   {
    "text": "Evidence of symptomatic heart failure, gross cardiac enlargement; significant heart block or cardiac arrhythmias. History of uncontrolled complex ventricular arrhythmias, uncontrolled atrial fibrillation/flutter or uncontrolled supraventricular tachycardias with a ventricular response rate of >100 beats per minute at rest."
   },
   {
    "text": "Left ventricular (LV) ejection fraction < 0.25"
   },
   {
    "text": "History of symptomatic cerebrovascular disease"
   },
   {
    "text": "Conditions at the discretion of the investigator"
   },
   {
    "text": "Known HIV infection"
   },
   {
    "text": "Poorly controlled or uncontrolled hypertension."
   },
   {
    "text": "Known muscular or neuromuscular disease of any type"
   },
   {
    "text": "Neoplastic disease"
   },
   {
    "text": "Drug abuse or continuous consumption of more than 65 mL pure alcohol per day"
   },
   {
    "text": "Exposure to any investigational new drug within 30 days of study entry or ingestion of any drug known to be toxic to a major organ system"
   },
   {
    "text": "Current or recent use of supplements known to alter lipid metabolism"
   },
   {
    "text": "Hypersensitivity reactions to other HMG-CoA reductase inhibitors"
   },
   {
    "text": "Concomitant medication not permitted"
   },
   {
    "text": "Resistant to lipid-lowering medications. Known hypersensitivity or intolerance to any lipid lowering agent"
   },
   {
    "text": "Excessive obesity"
   },
   {
    "text": "Regular clinic attendance in the morning impractical"
   },
   {
    "text": "Signs of mental dysfunction or other factors likely to limit ability to cooperate"
   }
  ],
