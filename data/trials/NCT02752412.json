 "registry_url": "https://clinicaltrials.gov/study/NCT02752412",
 "content_hash": "9118c99069c50b93",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-drugs"
 ],
 "sponsors_of_note": [],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Patient with type 2 diabetes mellitus (T2DM) diagnosed for at least 1 year before the screening visit (V1)."
   },
   {
    "text": "Patient treated with a stable, once a day basal insulin regimen (ie, type of insulin and time/frequency of the injection), for at least 3 months before the screening visit."
   },
   {
    "text": "The total daily basal insulin dose should be stable (± 20%) and <15 U/day for at least 1 month before the screening visit."
   },
   {
    "text": "Patient receiving 1 or 2 oral anti-diabetic drugs (OADs): the OAD dose(s) must be stable during the 3 months before the screening visit. The OADs can be 1 to 2 out of:"
   },
   {
    "text": "Metformin;"
   },
   {
    "text": "Sulfonylurea (SU);"
   },
   {
    "text": "Glinide;"
   },
   {
    "text": "Dipeptidyl-peptidase-4 (DPP-4) inhibitor;"
   },
   {
    "text": "Sodium glucose co-transporter 2 (SGLT2) inhibitor;"
   },
   {
    "text": "Alpha glucosidase inhibitor (alpha-GI)."
   },
   {
    "text": "Signed written informed consent."
   }
  ],
  "exclusion": [
   {
    "text": "Age <20 years at screening visit."
   },
   {
    "text": "HbA1c at screening visit <7.5% or >9.5%."
   },
   {
    "text": "Fasting plasma glucose (FPG) >180 mg/dL (10.0 mmol/L) at screening visit."
   },
   {
    "text": "Pregnancy or lactation, women of childbearing potential with no effective contraceptive method."
   },
   {
    "text": "Use of oral or injectable glucose-lowering agents other than those stated in the inclusion criteria in the 3 months before screening visit."
   },
   {
    "text": "Previous use of insulin regimen other than basal insulin, eg, prandial or pre-mixed insulin."
   },
   {
    "text": "Use of thiazolidinedione (TZD) within 6 months prior to screening visit."
   },
   {
    "text": "History of discontinuation of a previous treatment with a glucagon-like peptide-1(GLP-1) receptor agonist due to safety/ tolerability issues or lack of efficacy."
   },
   {
    "text": "Laboratory findings at the screening visit; including:"
   },
   {
    "text": "Amylase and/or lipase >3 times the upper limit of the normal (ULN) laboratory range;"
   },
   {
    "text": "Alanine aminotransferase (ALT) or aspartate aminotransferase (AST) >3 ULN;"
   },
   {
    "text": "Calcitonin ≥20 pg/mL (5.9 pmol/L);"
   },
   {
    "text": "Positive serum pregnancy test."
   },
   {
    "text": "Any contraindication to metformin use according to local labeling."
   },
   {
    "text": "History of hypersensitivity to any GLP-1 receptor agonist or to metacresol."
   },
   {
    "text": "Contraindication to use of insulin glargine or lixisenatide according to local labeling. History of hypersensitivity to insulin glargine or to any of the excipients."
   },
   {
    "text": "Personal or immediate family history of medullary thyroid cancer (MTC) or genetic condition that predisposes to MTC (eg, multiple endocrine neoplasia syndromes)."
   },
   {
    "text": "History of pancreatitis (unless pancreatitis was related to gallstones and cholecystectomy has now been performed), pancreatitis during previous treatment with incretin therapies, chronic pancreatitis, pancreatectomy, stomach/gastric surgery."
   },
   {
    "text": "Exclusion criteria for randomization at the end of the run-in phase:"
   },
   {
    "text": "HbA1c <7.5% or >9.5% at visit 6 (Week -1)."
   },
   {
    "text": "Mean fasting self monitored plasma glucose (SMPG) >160 mg/dL (8.9 mmol/L), calculated from all available (minimum of 4 self-measurements) values during the 7 days prior to randomization."
   },
   {
    "text": "Average insulin glargine daily dose ≥15 U/day or <5U/day calculated for the last 3 days before Visit 7."
   },
   {
    "text": "Metformin total daily dose <750 mg/day."
   },
   {
    "text": "Amylase and/or lipase >3 ULN at Visit 6 (Week -1)."
   },
   {
    "text": "The above information is not intended to contain all considerations relevant to a patient's potential participation in a clinical trial."
   }
  ],
  "notes": [
   "Note: Short-term treatment (≤10 days) due to intercurrent illness including gestational diabetes is allowed at the discretion of the Investigator.",
   "Note:fasting SMPG on the day of randomization can be included if assessed before randomization."
  ]
 },
 "in_watchlist": true,
 "history": []
