 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "adult patients, 18-75 years of age;"
   },
   {
    "text": "type 2 diabetes receiving metformin (>=1500mg/day) for at least 12 weeks;"
   },
   {
    "text": "HbA1c >=7.0% and <=10.0% at screening;"
   },
   {
    "text": "BMI >=25 (>23 for Asians) and <=45kg/m2 at screening;"
   },
   {
    "text": "stable weight +/- 5% for at least 12 weeks prior to screening."
   }
  ],
  "exclusion": [
   {
    "text": "history of type 1 diabetes mellitus or acute metabolic diabetic complications such as ketoacidosis or hyperosmolar coma in the previous 6 months;"
   },
   {
    "text": "evidence of clinically significant diabetic complications;"
   },
   {
    "text": "clinically symptomatic gastrointestinal disease;"
   },
   {
    "text": "myocardial infarction, coronary artery bypass surgery, post-transplantation cardiomyopathy or stroke within the previous 6 months;"
   },
   {
    "text": "known hemoglobinopathy or chronic anemia."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
