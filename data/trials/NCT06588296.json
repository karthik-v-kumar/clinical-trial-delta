 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Have signs and/or symptoms or documented diagnosis of Psoriatic Arthritis (PsA) for at least 6 months and currently fulfilling the classification of Psoriatic Arthritis (CASPAR) criteria."
   },
   {
    "text": "Have active PsA, defined as the presence of at least 3 of 68 tender joints and at least 3 of 66 swollen joints."
   },
   {
    "text": "Have obesity, body mass index of ≥30 kilograms per meter squared (BMI ≥30 kg/m²) or overweight (BMI ≥27 to <30 kg/m²) in the presence of at least 1 of these weight-related comorbid conditions (hypertension, dyslipidemia, obstructive sleep apnea, cardiovascular disease, or T2DM)."
   }
  ],
  "exclusion": [
   {
    "text": "Medical Conditions"
   },
   {
    "text": "Have Type 1 Diabetes Mellitus (T1DM)."
   },
   {
    "text": "Have insulin-treated Type 2 Diabetes Mellitus (T2DM)."
   },
   {
    "text": "Have a prior or planned surgical treatment for obesity."
   },
   {
    "text": "Have a family or personal history of medullary thyroid carcinoma (MTC) or multiple endocrine neoplasia (MEN) syndrome type 2."
   },
   {
    "text": "Have active, or a history of inflammatory bowel disease (Crohn's or ulcerative colitis)."
   },
   {
    "text": "Have a diagnosis or history of malignant disease within the 5 years prior to randomization, with the following exceptions:",
    "sub_items": [
     "basal cell or squamous epithelial carcinomas of the skin that have been resected, with no evidence of metastatic disease for 3 years.",
     "cervical carcinoma in situ, with no evidence of recurrence within the 5 years prior to randomization."
    ]
   },
   {
    "text": "Have a serious disorder or illness other than PsA."
   },
   {
    "text": "Have a history of chronic or acute pancreatitis."
   },
   {
    "text": "Have any prior use of ixekizumab or tirzepatide."
   },
   {
    "text": "Diagnosis of other inflammatory arthritis, such as Rheumatoid Arthritis (RA), ankylosing spondylitis, reactive arthritis, gout, or enteropathic arthritis."
   },
   {
    "text": "Have a previous failure or intolerance to an interleukin 17 inhibitor (IL-17i) or glucagon-like peptide 1 (GLP-1) receptor agonists."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
