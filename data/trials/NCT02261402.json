 "primary_outcomes": [
  {
   "measure": "Adherence by Morisky 8-item Medication Adherence Scale (MMAS-8) at 7 weeks",
   "time_frame": "7 weeks after dispensing the new medicine"
  },
  {
   "measure": "Adherence by Morisky 8-item Medication Adherence Scale (MMAS-8) at 18 weeks",
   "time_frame": "18 weeks after dispensing the new medicine"
  }
 ],
 "brief_summary": "\"Medisinstart\" is a new service developed for use in Norwegian pharmacies. It is intended for patients that are about to start a new medicine for a chronic or long-term condition. It is based on research showing that problems with newly prescribed medicines appear rapidly and that a significant portion of patients quickly becomes non-adherent. The service consists of two follow-up consultations with a pharmacist. The first at 1-2 weeks and the second at 3-5 weeks after start of the new medicine.\n\nThe main purpose of this study is to investigate whether \"Medisinstart\" increases patients' adherence to the prescribed medication. Patients' beliefs about their medicines and their motivation for adherence will also be examined. The study also aims at revealing if \"Medisinstart\" has additional benefits for the patient, the society and the pharmacies.",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\nFirst time prescription for a drug belonging to one of the following groups (ATC-code):\n\n* Dabigatran etexilate (B01AE07)\n* Rivaroxaban (B01AF01)\n* Apixaban (B01AF02)\n* Beta blocking agents (C07)\n* Calcium channel blockers (C08)\n* Agents acting on the renin-angiotensin system (C09)\n* HMG CoA reductase inhibitors (statins) (C10AA)\n\nExclusion Criteria:\n\n* Prior use (within the last 3 years) of the drug in question independent of strength, dose and formulation",
  "sex": "ALL",
  "minimum_age": "18 Years",
  "maximum_age": null,
  "healthy_volunteers": false,
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
