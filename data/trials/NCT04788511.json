 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Male or female, age above or equal to 18 years at the time of signing informed consent."
   },
   {
    "text": "Body mass index (BMI) greater than or equal to 30.0 kg/m^2"
   },
   {
    "text": "New York Heart Association (NYHA) Class II-IV"
   },
   {
    "text": "Left ventricular ejection fraction (LVEF) greater than or equal to 45 percentage at screening"
   }
  ],
  "exclusion": [
   {
    "text": "A self-reported change in body weight greater than 5 kg (11 lbs) within 90 days before screening irrespective of medical records"
   },
   {
    "text": "Haemoglobin A1c (HbA1c) greater than or equal to 6.5 percentage (48 mmol/mol) based on latest available value from medical records, no older than 3 months or if unavailable a local measurement at screening"
   }
  ],
  "notes": []
 },
