 ],
 "sponsors_of_note": [
  "Eli Lilly"
 ],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Have a body mass index (BMI) of 27 kilograms per square meter (kg/m²) or higher at screening"
   },
   {
    "text": "Have a stable body weight (less than 5% body weight change) for 90 days prior to screening"
   },
   {
    "text": "Have tried at least once to lose weight through diet but were unsuccessful"
   },
   {
    "text": "Have osteoarthritis of the knee and at least one of the following conditions:",
    "sub_items": [
     "Be over 50 years old",
     "Have morning knee stiffness that lasts about 30 minutes",
     "Have a crackling or grinding sound or feeling in the knee"
    ]
   }
  ],
  "exclusion": [
   {
    "text": "Have a prior or planned surgical treatment for obesity (liposuction, cryolipolysis, or abdominoplasty allowed if performed greater than 1 year before screening)"
   },
   {
    "text": "Have a prior or planned endoscopic procedure and/or device-based therapy for obesity (prior device-based therapy acceptable if device removal was more than 6 months prior to screening)"
   },
   {
    "text": "Have type 1 diabetes, type 2 diabetes, or any other type of diabetes"
   },
   {
    "text": "Have an active knee infection"
   },
   {
    "text": "Have had within 90 days prior to screening:",
    "sub_items": [
     "heart attack",
     "stroke",
     "coronary artery revascularization",
     "unstable angina, or",
     "hospitalization due to congestive heart failure"
    ]
   },
   {
    "text": "Have a history or diagnosis of New York Heart Association Functional Classification Class IV congestive heart failure"
   },
   {
    "text": "Have taken medications or alternative remedies intended for weight loss within 90 days of screening"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
