 "primary_outcomes": [
  {
   "measure": "To assess the additional lowering of HbA1C achieved by addition of colesevelam hydrochloride to current antidiabetic therapy",
   "time_frame": null
  }
 ],
 "brief_summary": "The purpose of the study is to see how safe and effective and tolerable the use of colesevelam hydrochloride is for type 2 diabetes when added to metformin alone or in combination with other anti-diabetic drugs.",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Age 18-75 years, inclusive\n* Diagnosed with type 2 diabetes\n* Hemoglobin (HbA1c) between 7.5% to 9.5%\n* Prescribed an ADA accepted diet\n* Receiving stable dose of metformin alone or in combination with other oral anti-diabetic medications for 90 days before Visit 1\n\nExclusion Criteria:\n\n* History of type 1 diabetes or ketoacidosis\n* History of chronic (more than 2 months) insulin therapy or the initiation of insulin for chronic treatment\n* History of pancreatitis\n* Uncontrolled hypertension\n* Recent severe cardiovascular disease\n* Allergy or toxic response to colesevelam or any of its components\n* Body mass index (BMI) \\>45 kg/m2",
  "sex": "ALL",
  "minimum_age": "18 Years",
  "maximum_age": "75 Years",
  "healthy_volunteers": false,
