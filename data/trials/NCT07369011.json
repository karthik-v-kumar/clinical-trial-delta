 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Confirmed history of moderate-to-severe OSA"
   },
   {
    "text": "Have an AHI ≥ 15 on polysomnography (PSG) as part of the study at screening"
   },
   {
    "text": "Have a BMI ≥27 kg/m2 at screening"
   },
   {
    "text": "Have a stable body weight (<5% body weight change) for 90 days prior to screening"
   },
   {
    "text": "Have a history of at least one self-reported unsuccessful dietary effort to reduce body weight"
   },
   {
    "text": "Are unable or unwilling to use PAP therapy",
    "group": "For YSA1 Participants"
   },
   {
    "text": "Have been on PAP therapy for at least three consecutive months prior to screening and plan to continue PAP therapy during the study",
    "group": "For YSA2 Participants"
   }
  ],
  "exclusion": [
   {
    "text": "Have a prior or planned surgical treatment for obesity (liposuction, cryolipolysis, or abdominoplasty allowed if performed >1 year before screening)"
   },
   {
    "text": "Have a prior or planned endoscopic procedure and/or device-based therapy for obesity (prior device-based therapy acceptable if device removal was more than 6 months prior to screening)"
   },
   {
    "text": "Any previous or planned surgery for sleep apnea or major ear, nose or throat surgery that still may affect breathing at time of screening"
   },
   {
    "text": "Have type 1 diabetes, type 2 diabetes, or any other type of diabetes"
   },
   {
    "text": "Have had within 90 days prior to screening:",
    "sub_items": [
     "acute myocardial infarction",
     "cerebrovascular accident (stroke)",
     "coronary artery revascularization",
     "unstable angina, or",
     "hospitalization due to congestive heart failure"
    ]
   },
   {
    "text": "Have a history or diagnosis of New York Heart Association Functional Classification Class IV congestive heart failure"
   },
   {
    "text": "Have taken medications or alternative remedies intended for weight loss within 90 days of screening"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
