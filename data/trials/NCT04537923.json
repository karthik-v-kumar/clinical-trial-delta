 "registry_url": "https://clinicaltrials.gov/study/NCT04537923",
 "content_hash": "d50f3d69651bf5f4",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-drugs",
  "t2d-sponsors"
 ],
 "sponsors_of_note": [
  "Eli Lilly"
 ],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Have been diagnosed with type 2 diabetes mellitus (T2DM)"
   },
   {
    "text": "Have HbA1c between ≥7.5% and ≤11%"
   },
   {
    "text": "Have been treated for at least 90 days prior to day of screening with once or twice daily basal insulin with or without stable dose of metformin ≥1500 mg/day and up to maximum approved dose per country specific approved label, sulfonylureas or dipeptidyl peptidase 4 inhibitors"
   },
   {
    "text": "Be of stable weight (± 5%) for at least 90 days"
   },
   {
    "text": "Have a BMI ≥23 kilograms per meter squared (kg/m²) and ≤45 kg/m² at screening"
   }
  ],
  "exclusion": [
   {
    "text": "Have type 1 diabetes mellitus"
   },
   {
    "text": "Have had chronic or acute pancreatitis any time prior to study entry"
   },
   {
    "text": "Have proliferative diabetic retinopathy or diabetic macular edema or nonproliferative diabetic retinopathy requiring immediate or urgent treatment"
   },
   {
    "text": "Have disorders associated with slowed emptying of the stomach, have had any stomach surgeries for the purpose of weight loss, or are chronically taking drugs that directly affect gastrointestinal motility"
   },
   {
    "text": "Have had a heart attack, stroke, or hospitalization for congestive heart failure in the past 2 months"
   },
   {
    "text": "Have a personal or family history of medullary thyroid carcinoma or personal history of multiple endocrine neoplasia syndrome type 2"
   },
   {
    "text": "Have been taking weight loss drugs, including over-the-counter medications during the last 3 months"
   },
   {
    "text": "Have an estimated glomerular filtration rate <30 mL/minute/1.73 m² [for participants on metformin, estimated glomerular filtration rate <45 mL/min/1.73 m2 (or lower than the country-specific threshold for using the protocol-required dose of metformin per local label)]"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
