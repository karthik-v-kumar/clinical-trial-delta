 ],
 "sponsors_of_note": [
  "Eli Lilly"
 ],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Have body mass index (BMI) ≥30.0 kilograms per square meter (kg/m²), or ≥27.0 kg/m² with at least one of the following:",
    "sub_items": [
     "hypertension",
     "dyslipidemia",
     "obstructive sleep apnea, or",
     "cardiovascular disease"
    ]
   },
   {
    "text": "History of at least one unsuccessful dietary effort to reduce body weight"
   },
   {
    "text": "Have index knee pain for >12 weeks prior to screening, and presence of index knee pain for >15 days over the previous month",
    "group": "GOA1 Inclusion Criteria"
   },
   {
    "text": "Have knee X-ray with moderate radiographic changes (Kellgren-Lawrence Grade 2 or 3) per central reading at screening",
    "group": "GOA1 Inclusion Criteria"
   },
   {
    "text": "Currently meets American College of Rheumatology (ACR) Criteria (clinical and radiological) for OA.",
    "group": "GOA1 Inclusion Criteria"
   },
   {
    "text": "Previously diagnosed with OSA",
    "group": "GSA1 Inclusion Criteria"
   },
   {
    "text": "Have AHI ≥15 on polysomnography at screening (definition of moderate-to-severe OSA)",
    "group": "GSA1 Inclusion Criteria"
   },
   {
    "text": "For participants not on positive airway pressure (PAP) therapy: unable or unwilling to use PAP therapy and have not used PAP for at least 4 weeks prior to screening.",
    "group": "GSA1 Inclusion Criteria"
   },
   {
    "text": "If on PAP therapy, have been on PAP therapy for at least 3 consecutive months prior to screening, and willing to temporarily stop using PAP therapy for approximately 7 days prior to each of the sleep study (PSG) visits.",
    "group": "GSA1 Inclusion Criteria"
   },
   {
    "text": "Have completed the final treatment visit of GZBJ Week 80.",
    "group": "GZBJ Addenda (2) inclusion criteria"
   }
  ],
  "exclusion": [
   {
    "text": "Have a self-reported or documented change in body weight >5 kg (11 pounds) within 90 days."
   },
   {
    "text": "Have taken weight loss drugs, including over-the-counter medications, within 90 days prior to screening."
   },
   {
    "text": "Have a prior or planned surgical treatment for obesity."
   },
   {
    "text": "Have diabetes mellitus."
   },
   {
    "text": "Have family or personal history of medullary thyroid carcinoma (MTC) or multiple endocrine neoplasia syndrome type 2 (MEN-2)"
   },
   {
    "text": "Have had pancreatitis."
   },
   {
    "text": "GOA1 exclusion criteria"
   },
   {
    "text": "Have had steroid joint injections within 90 days of screening."
   },
   {
    "text": "Have had other joint injections and procedures within 6 months of screening."
   },
   {
    "text": "Have joint disease other than osteoarthritis."
   },
   {
    "text": "GSA1 exclusion criteria"
   },
   {
    "text": "Use stimulants (for example, modafinil, armodafinil, solriamfetol, pitolisant, amphetamine) less than 3 months prior to screening."
   },
   {
    "text": "Use hypnotics, mirtazapine, opioids, trazodone, and zonisamide less than 3 months prior to screening."
   },
   {
    "text": "Use a dental appliance or other device to treat OSA other than PAP therapy."
   },
   {
    "text": "GZBJ Addenda (2) exclusion criteria"
   },
   {
    "text": "Have had study intervention discontinuation."
   },
   {
    "text": "Have had permanent dose reduction."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
