 "registry_url": "https://clinicaltrials.gov/study/NCT05929066",
 "content_hash": "536f648a382ab08e",
 "collections": [
  "glp1-obesity",
  "type-2-diabetes"
 ],
 "matched_queries": [
  "glp1-obesity-drugs",
  "glp1-obesity-sponsors",
