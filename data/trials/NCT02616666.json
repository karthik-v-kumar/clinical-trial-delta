 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Provision of informed consent prior to any study specific procedures",
    "group": "For inclusion in the study patients should fulfil the following criteria at the time of screening"
   },
   {
    "text": "Females and males aged ≥18 years up to ≤ 75 years",
    "group": "For inclusion in the study patients should fulfil the following criteria at the time of screening"
   },
   {
    "text": "Diagnosed with Type 2 Diabetes Mellitus.",
    "group": "For inclusion in the study patients should fulfil the following criteria at the time of screening"
   },
   {
    "text": "Uncontrolled on first-line metformin treatment, defined as ≥8 weeks on maximum tolerated dose of metformin and HbA1c > 6.5%.",
    "group": "For inclusion in the study patients should fulfil the following criteria at the time of screening"
   },
   {
    "text": "Ability to read and write as judged by the investigator.",
    "group": "For inclusion in the study patients should fulfil the following criteria at the time of screening"
   }
  ],
  "exclusion": [
   {
    "text": "Involvement in the planning and/or conduct of the study (applies to both AstraZeneca staff and/or staff at the study site)",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   },
   {
    "text": "Previous enrolment or randomization in the present study",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   },
   {
    "text": "Age > 75 years",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   },
   {
    "text": "Pregnancy/active breast feeding at the time of inclusion",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   },
   {
    "text": "Known moderate to severe renal impairment (eGFR<60ml/min).",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   },
   {
    "text": "Participation in an interventional clinical trial ≤ 3 months before enrolment.",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   },
   {
    "text": "Unsuitable to participate on mental health grounds, as judged by the investigator.",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   },
   {
    "text": "Physician decision to use, as second line treatment, insulin, a GLP1 agonist compound or a SGLT2 inhibitor different from dapagliflozin.",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   },
   {
    "text": "Presence of any of the characteristics in which the products in study are contraindicated, as per current labels.",
    "group": "Patients should not enter the study if any of the following exclusion criteria are fulfilled"
   }
  ],
  "notes": []
 },
