 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Diagnosed with type 2 diabetes (T2D) mellitus greater than equal to (≥) 180 days before screening."
   },
   {
    "text": "Stable daily dose(s) ≥ 90 days prior to the day of screening of metformin ≥ 1500 milligrams (mg) or maximum tolerated or effective dose."
   },
   {
    "text": "HbA1c of 7.0-10.5 percentage (%) [53-91.3 millimoles per mole (mmol/mol)] (both inclusive)."
   }
  ],
  "exclusion": [
   {
    "text": "Known or suspected hypersensitivity to study intervention(s) or related products."
   },
   {
    "text": "Treatment with any medication for the indication of diabetes or obesity other than stated in the inclusion criteria within 90 days before screening. However, short term insulin treatment for a maximum of 14 days and prior insulin treatment for gestational diabetes are allowed."
   },
   {
    "text": "Uncontrolled and potentially unstable diabetic retinopathy or maculopathy. Verified by a fundus examination performed within 90 days before screening or in the period between screening and randomisation. Pharmacological pupil-dilation is a requirement unless using a digital fundus photography camera specified for nondilated examination."
   }
  ],
  "notes": []
 },
