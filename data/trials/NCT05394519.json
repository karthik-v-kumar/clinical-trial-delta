 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Male or female"
   },
   {
    "text": "Age above or equal to 18 years at the time of signing informed consent"
   },
   {
    "text": "BMI greather than or equal to 27.0 kg/m^2"
   },
   {
    "text": "Diagnosed with type 2 diabetes mellitus greater than or equal to 180 days before screening"
   },
   {
    "text": "Treatment with either lifestyle intervention, or treatment with 1-3 marketed oral antidiabetic drugs (OAD)s (metformin, α-glucosidase inhibitors (AGI), glinides, sodium-glucose co-transporter 2 inhibitor (SGLT2i), thiazolidinediones, or sulphonylureas (SU)s as a single agent or in combination) according to local label"
   },
   {
    "text": "Treatment with oral antidiabetic drugs should be stable (same drug(s), dose and dosing frequency) for at least 90 days before screening"
   },
   {
    "text": "HbA1c 7%-10% (53-86 mmol/mol) (both inclusive) as measured by the central laboratory at screening"
   }
  ],
  "exclusion": [
   {
    "text": "Clinically significant or severe hypoglycaemia within 6 months before screening or history of hypoglycaemia unawareness"
   },
   {
    "text": "Renal impairment with estimated glomerular filtration rate (eGFR) below 30 mL/min/1.73 m^2, as measured by the central laboratory at screening"
   },
   {
    "text": "Uncontrolled and potentially unstable diabetic retinopathy or maculopathy. Verified by a fundus examination performed within 90 days before screening or in the period between screening and randomisation. Pharmacological pupil-dilation is a requirement unless using a digital fundus photography camera specified for non-dilated examination."
   }
  ],
