  {
   "measure": "Change in Glycosylated A1c (HbA1c) at Week 26",
   "time_frame": "week 0, week 26"
  }
 ],
 "brief_summary": "This trial is conducted in Europe and the United States of America (USA). The aim of this trial is to compare the effect on glycaemic control of liraglutide or exenatide when added to subject's ongoing OAD (oral anti-diabetic drug) treatment of either metformin, sulphonylurea or a combination of both in subjects with type 2 diabetes. Two trial periods: A 26 week randomised, followed by a 52 week extension (14 + 38 weeks) where all subjects received liraglutide + OAD after previous randomisation to either liraglutide or exenatide, both combined with OAD treatment.",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Type 2 diabetes\n* Stable treatment with Oral Anti-Diabetic Drugs (metformin, sulphonylurea or a combination of both) for at least 3 months at the discretion of the Investigator\n* HbA1C equal to or greater than 7.0% and equal to or lower than 11.0%\n* Body Mass Index (BMI) equal to or lower than 45.0 kg/m2\n\nExclusion Criteria:\n\n* Previous treatment with insulin\n* Treatment with any anti-diabetic drug other than metformin and sulphonylurea\n* Any previous exposure to exenatide or liraglutide\n* Impaired liver or/and renal function\n* History of any significant cardiac events\n* Known retinopathy or maculopathy requiring acute treatment\n* Recurrent major hypoglycaemia or hypoglycaemic unawareness",
  "healthy_volunteers": false,
  "maximum_age": "80 Years",
  "minimum_age": "18 Years",
  "sex": "ALL",
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
