 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Type 2 diabetes"
   },
   {
    "text": "Stable treatment with Oral Anti-Diabetic Drugs (metformin, sulphonylurea or a combination of both) for at least 3 months at the discretion of the Investigator"
   },
   {
    "text": "HbA1C equal to or greater than 7.0% and equal to or lower than 11.0%"
   },
   {
    "text": "Body Mass Index (BMI) equal to or lower than 45.0 kg/m2"
   }
  ],
  "exclusion": [
   {
    "text": "Previous treatment with insulin"
   },
   {
    "text": "Treatment with any anti-diabetic drug other than metformin and sulphonylurea"
   },
   {
    "text": "Any previous exposure to exenatide or liraglutide"
   },
   {
    "text": "Impaired liver or/and renal function"
   },
   {
    "text": "History of any significant cardiac events"
   },
   {
    "text": "Known retinopathy or maculopathy requiring acute treatment"
   },
   {
    "text": "Recurrent major hypoglycaemia or hypoglycaemic unawareness"
   }
  ],
