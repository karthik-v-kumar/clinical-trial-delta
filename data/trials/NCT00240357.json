  "parsed": true,
  "inclusion": [
   {
    "text": "Available personal mailbox and access to the Internet"
   },
   {
    "text": "Primary hypercholesterolemia with CV risk > 20% over 10 years judged by the investigator or a history of ischemic heart disease or other established atherosclerotic disease (claudicatio intermittens, apoplexia cerebri (ischaemic stroke)) or stable diabetes mellitus"
   },
   {
    "text": "Fasting LDL-C level > 3.2 mmol/L"
   }
  ],
  "exclusion": [
   {
    "text": "Known heterozygous or homozygous familial hypercholesterolemia or known type III hyperlipoproteinaemia (familial dysbetalipoproteinaemia)"
   },
   {
    "text": "Documented secondary hypercholesterolemia of any cause except stable diabetes mellitus (type 1 or type 2)"
   },
   {
    "text": "History of serious adverse effect or hypersensitivity reactions to statins, in particular any history of myopathy"
   }
  ],
