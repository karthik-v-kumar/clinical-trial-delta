 "primary_outcomes": [
  {
   "measure": "The co-primary efficacy endpoints are the percentage changes in both HDL-C and LDL-C levels at Week 12 compared to baseline.",
   "time_frame": "12 weeks"
  }
 ],
 "brief_summary": "The primary objective of this study is to evaluate the efficacy of different doses of TA-8995, a cholesteryl ester transfer protein (CETP) inhibitor, on the elevation of high-density lipoprotein cholesterol (HDL-C) and reduction of low-density lipoprotein cholesterol (LDL-C), alone and in combination with statin therapy.\n\nThe secondary objectives of this study are to determine the safety and tolerability of TA-8995 in patients with mild dyslipidaemia.",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Fasting LDL-C levels \\>2.5 mmol/L and \\<4.5 mmol/L, HDL-C levels \\<1.8 mmol/L and \\>0.8 mmol/L, and TG levels \\<4.5 mmol/L after run in or washout of existing therapies\n* Not on lipid-altering therapy at screening or on lipid-altering treatment regimens at screening\n\nExclusion Criteria:\n\n* Body mass index \\>32 kg/m2;\n* Participation in another clinical study involving an investigational or marketed drug within 30 days prior to enrolment (Visit 2);\n* Any clinical manifestation of atherosclerotic vascular disease;\n* Diagnosis of type 1 diabetes;\n* Uncontrolled type 2 diabetes: haemoglobin A1c \\>8%;\n* Uncontrolled hypertension: sitting systolic blood pressure \\>160 mmHg and/or sitting diastolic blood pressure \\>90 mmHg;\n* History of hyperaldosteronism;\n* Active muscle disease or persistent creatine kinase concentration \\>3 × the upper limit of normal (ULN). One retest will be allowed after 1 week to verify the result;",
  "sex": "ALL",
  "minimum_age": "18 Years",
  "maximum_age": "75 Years",
  "healthy_volunteers": false,
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
