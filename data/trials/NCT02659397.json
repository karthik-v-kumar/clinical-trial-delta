  {
   "measure": "Peak plasma concentration (Cmax) pharmacokinetics of atorvastatin and its active metabolites",
   "time_frame": "2 weeks"
  },
  {
   "measure": "24-hour area under the curve (AUC) pharmacokinetics of atorvastatin and its active metabolites",
