   "measure": "Adjusted Change From Baseline in Glycated Hemoglobin A1c (HbA1c) at Week 28",
   "time_frame": "Baseline (Day 1) and Week 28"
  },
  {
   "measure": "Number of Participants With Post-Treatment Adverse Events of Special Interest (AESI) During Safety Follow-up Period",
