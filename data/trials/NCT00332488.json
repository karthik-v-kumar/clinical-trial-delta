 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Non-smokers with clinical diagnosis of Type 2 diabetes mellitus for >or= to 6 months"
   },
   {
    "text": "Stable regimen of metformin for > or = to 1000mg/day or maximum tolerated dose) and a secretagogue < or = 1/2 the maximum manufacturer-recommended daily dose without any dose adjustments within the preceding 6 wks."
   },
   {
    "text": "Fixed dose combination products of metformin and sulfonylurea are acceptable as long as each individual dose meets inclusion criteria"
   },
   {
    "text": "HbA1c >or= to 7.5% and < or= to 11.0%"
   },
   {
    "text": "BMI < or = to 40kg/m2."
   },
   {
    "text": "FEV1> or = to 70%, Total Lung capacity and > or =80% DLco > or= to 70%"
   }
  ],
  "exclusion": [
   {
    "text": "Treatment with any type of anti-diabetic therapy, other than metformin & secretagogues within the preceding 12 weeks"
   },
   {
    "text": "Serum creatinine > 1.4mg/dL in female subjects and >1.5mg/dL in male subjects"
   },
   {
    "text": "History of chronic obstructive pulmonary disease, clinically proven asthma and/or any other clinically important pulmonary function testing and/or radiologic findings"
   },
   {
    "text": "Evidence of serious complications of diabetes (e.g. autonomic neuropathy)"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
