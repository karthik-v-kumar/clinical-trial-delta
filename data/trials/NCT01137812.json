 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "All patients must have a diagnosis of T2DM and be currently treated with metformin and sulphonylurea"
   },
   {
    "text": "Patients in the study must have a HbA1c between >=7 and <=10.5% and a fasting plasma glucose (FPG) <300 mg/dL (16.7 mmol/L)"
   }
  ],
  "exclusion": [
   {
    "text": "History of diabetic ketoacidosis, type 1 diabetes mellitus (T1DM), pancreas or beta cell transplantation, or diabetes secondary to pancreatitis or pancreatectomy"
   },
   {
    "text": "or a severe hypoglycemic episode within 6 months before screening"
   }
  ],
  "notes": []
 },
