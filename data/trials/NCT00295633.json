 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Type 2 diabetics currently receiving a stable dose of TZD monotherapy (pioglitazone 30mg or 45mg, or rosiglitazone 4mg or 8mg) for at least 12 weeks prior to screening."
   },
   {
    "text": "Hemoglobin A1c (HbA1c) > = 7.0% and < = 10.5%"
   },
   {
    "text": "Body mass index < = 45kg/m2"
   },
   {
    "text": "Fasting C-peptide > = 1 ng/mL"
   }
  ],
  "exclusion": [
   {
    "text": "Symptomatic poorly controlled diabetes"
   },
   {
    "text": "Recent cardiac or cerebrovascular event"
   },
   {
    "text": "Serum creatinine > = 2.0 mg/dL"
   }
  ],
  "notes": []
 },
