 "primary_outcomes": [
  {
   "measure": "To evaluate the efficacy of vildagliptin as add-on therapy to metformin in patients with T2DM by assessing changes in HbA1c with vildagliptin added to metformin to that of placebo added to metformin after 24 weeks of treatment",
   "time_frame": "24 weeks"
  }
 ],
 "brief_summary": "This is a 2-3 period parallel group study with an adaptive element in Type 2 diabetes patients receiving vildagliptin as add-on therapy to metformin",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Patients 18-78 years old inclusive at Visit 1\n* T2DM patients treated with metformin for at least 3 months and a stable dose of at least 1500 mg daily for a minimum of 4 weeks prior to Visit 1\n* Patient agreement to maintain same dose of metformin throughout study\n* HbA1c of ≥ 7.0 and ≤ 9.5 % at Visit 1\n* Body Mass Index (BMI) in the range of 22-45 kg/m2 at visit 1\n\nExclusion Criteria:\n\n* Pregnant or nursing (lactating) women\n* FPG ≥ 270 mg/dL ( ≥ 15.0 mmol/L)",
  "healthy_volunteers": false,
  "maximum_age": "78 Years",
  "minimum_age": "18 Years",
  "sex": "ALL",
