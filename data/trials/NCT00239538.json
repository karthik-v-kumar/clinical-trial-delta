 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Ability to provide written informed consent."
   },
   {
    "text": "Hypertension defined as a mean seated DBP of 95-109 (inclusive) mmHg, and/or SBP of 140-179 (inclusive) mmHg, measured by BpTRU electronic or manual cuff at Visit 2."
   },
   {
    "text": "24-hour mean DBP of >= 85 mmHg, and/or SBP = 130 mmHg, measured by ABPM at Visit 3."
   },
   {
    "text": "30 years of age or greater."
   },
   {
    "text": "Ability to stop current antihypertensive therapy and other disallowed medications without risk to the patient."
   },
   {
    "text": "Diagnosis of type-2 diabetes mellitus with HbA1C less than or equal to 10%."
   },
   {
    "text": "Overweight or obese as defined by a BMI >= 27 kg/m2 in non-Asians and >= 24 kg/m2 in Asians."
   },
   {
    "text": "Negative UPT for females."
   }
  ],
  "exclusion": [
   {
    "text": "Pre-menopausal women, not surgically sterile or, not nursing/pregnant or are of child-bearing potential and will not practice acceptable methods of birth control during study."
   },
   {
    "text": "Night shift workers"
   },
   {
    "text": "Mean sitting SBP >= 180 mmHg or mean sitting DBP >= 110 mmHg during any visit of the placebo run-in period."
   },
   {
    "text": "Known or suspected secondary hypertension. Hepatic and/or renal dysfunction"
   },
   {
    "text": "Fasting serum glucose > 17 mmol/l (or 300 mg/dl) at visit 2"
   },
   {
    "text": "Bilateral renal artery stenosis, renal artery stenosis in a solitary kidney, patients on dialysis or post-renal transplant patients."
   },
   {
    "text": "Clinically relevant sodium depletion, hypokalaemia or hyperkalaemia."
   },
   {
    "text": "Uncorrected volume depletion."
   },
   {
    "text": "Primary aldosteronism."
   },
   {
    "text": "Hereditary fructose intolerance."
   },
   {
    "text": "Biliary obstructive disorders (e.g., cholestasis)."
   },
   {
    "text": "Congestive heart failure"
   },
   {
    "text": "Stroke within the past six months."
   },
   {
    "text": "Documented severe obstructive coronary artery disease."
   },
   {
    "text": "Myocardial infarction, cardiac surgery or unstable angina within the past three months."
   },
   {
    "text": "PCI (percutaneous coronary intervention) within the past three months or planned during trial period."
   },
   {
    "text": "Sustained ventricular tachycardia, atrial fibrillation, atrial flutter or other clinically relevant cardiac arrhythmias."
   },
   {
    "text": "Hypertrophic obstructive cardiomyopathy, aortic stenosis, hemodynamically relevant stenosis of the aortic or mitral valve."
   },
   {
    "text": "Patients with type-1 diabetes mellitus."
   },
   {
    "text": "Patients who have previously experienced symptoms of angioedema during ACE or ARB treatment."
   },
   {
    "text": "History of drug or alcohol dependency in past six months."
   },
   {
    "text": "Chronic administration of any medications known to affect blood pressure, except medication allowed by the protocol."
   },
   {
    "text": "Any investigational drug therapy within the past month."
   },
   {
    "text": "Known hypersensitivity to any component of the study drug."
   },
   {
    "text": "Concurrent use of corticosteroids, colestipol or cholestyramine resins."
   },
   {
    "text": "Any clinical condition which would not allow safe completion of the protocol."
   },
   {
    "text": "Inability to comply with the protocol."
   },
   {
    "text": "Any surgery that is, at the time of screening, planned to take place during the study period."
   },
   {
    "text": "History of non-compliance with prescribed medications."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
