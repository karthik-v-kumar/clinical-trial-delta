 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Have a body mass index (BMI) of 27 kilograms per square meter (kg/m2) or higher at screening"
   },
   {
    "text": "Have tried at least once to lose weight through diet but were unsuccessful"
   },
   {
    "text": "Have osteoarthritis of the knee and at least one of the following conditions:",
    "sub_items": [
     "Be over 50 years old",
     "Have morning knee stiffness that lasts about 30 minutes",
     "Have a crackling or grinding sound or feeling in the knee"
    ]
   }
  ],
  "exclusion": [
   {
    "text": "Have gained or lost more than 11 pounds within 90 days prior to screening"
   },
   {
    "text": "Have had a surgery for obesity or plan to have one in the next 18 months"
   },
   {
    "text": "Have an active knee infection"
   },
   {
    "text": "Have type 1 diabetes, type 2 diabetes, or any other type of diabetes"
   },
   {
    "text": "Have had a recent heart condition or New York Heart Association Functional Classification Class IV congestive heart failure"
   },
   {
    "text": "Have used any glucagon-like peptide-1 (GLP-1) receptor agonist medication within 180 days of screening"
   }
  ],
