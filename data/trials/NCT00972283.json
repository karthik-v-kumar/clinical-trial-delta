  "parsed": true,
  "inclusion": [
   {
    "text": "For MAIN period (NN1250-3582):"
   },
   {
    "text": "Type 2 diabetes mellitus for at least 6 months"
   },
   {
    "text": "Ongoing daily treatment with insulin (premix, self-mix, basal only, basal bolus) for at least 3 months with/without oral anti-diabetics drug (OAD) prior to trial start"
   },
   {
    "text": "HbA1c 7.0-10.0 % (both inclusive)"
   },
   {
    "text": "Body Mass Index (BMI) below or equal to 40.0 kg/m^2"
   },
   {
    "text": "For EXTENSION period (NN1250-3667):"
   },
   {
    "text": "Completion of the 52 week treatment period in NN1250-3582"
   }
  ],
  "exclusion": [
   {
    "text": "For MAIN period (NN1250-3582):"
   },
   {
    "text": "Treatment with other insulin regimens than premix, self-mix, basal only, basal bolus within 3 months"
   },
   {
    "text": "Cardiovascular disease within the last 6 months"
   },
   {
    "text": "Uncontrolled treated/untreated severe hypertension"
   },
   {
    "text": "Pregnancy, breast-feeding, the intention of becoming pregnant or not using adequate contraceptive measures"
   },
   {
