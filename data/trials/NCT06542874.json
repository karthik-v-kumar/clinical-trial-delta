 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Male or female, aged 18-75 years (both inclusive) at the time of signing the informed consent."
   },
   {
    "text": "Diagnosed with type 2 diabetes mellitus greater or equal to 180 days before screening."
   },
   {
    "text": "Stable daily dose(s) greater or equal to 90 days before screening of the following antidiabetic drug(s) or combination regimen(s) at effective or maximum tolerated dose as judged by the investigator: metformin with or without SGLT2 inhibitor."
   },
   {
    "text": "HbA1c of 7.0-10.0 procent (53-86 mmol/mol) (both inclusive) as assessed by central laboratory at screening."
   },
   {
    "text": "Body mass index between greater or equal to 23.0 and below 50.0 kg/m^2."
   },
   {
    "text": "Able and willing to adhere to the protocol including wearing a continuous glucose monitoring (CGM) device provided for the study, as judged by the investigator."
   }
  ],
  "exclusion": [
   {
    "text": "Treatment with any medication for the indication of diabetes or obesity other than stated in the inclusion criteria within 90 days before screening. However, short term insulin treatment for a maximum of 14 consecutive days and prior insulin treatment for gestational diabetes are allowed."
   },
   {
    "text": "Uncontrolled and potentially unstable diabetic retinopathy or maculopathy. Verified by a fundus examination performed within 90 days before screening or in the period between screening and randomisation. Pharmacological pupil-dilation is a requirement unless using a digital fundus photography camera specified for non-dilated examination."
   },
   {
    "text": "Known hypoglycaemic unawareness as indicated by the investigator according to Clarke's questionnaire question."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
