 "primary_outcomes": [
  {
   "measure": "Assess the effects of rosuvastatin treatment on the change in the mean maximum intima media thickness (IMT) of the 12 vessel segments: the near & far walls of the CCA, the carotid bulb & the ICA",
   "time_frame": null
  }
 ],
 "brief_summary": "The purpose of this trial is to see if rosuvastatin will be effective in decreasing the thickness of the walls of the arteries in the neck for people who already have some evidence of thickening of these walls.",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Maximum IMT \\>1.2 mm and 3.5 mm at any location in the carotid ultrasound studies conducted at both Visit 2 (Week -4) and Visit 3 (Week -2)\n* Subjects with age and no other risk factor: Fasting LDL-C at Visit 1 (Week -6) is \\>120 mg/dL (3.1mmol/L) and \\<190 mg/dL (4.9 mmol/L)\n* Subjects with 2 or more risk factors and a 10-year coronary heart disease (CHD) risk \\< 10%: Fasting LDL-C at Visit 1 (Week -6) is \\>120 mg/dL (3.1 mmol/L) and \\<160 mg/dL (4.1 mmol/L)\n\nExclusion Criteria:\n\n* Use of pharmacologic lipid-lowering medications (eg, HMG-CoA reductase inhibitors, fibrate derivatives, bile acid binding resins, niacin or its analogues at doses \\>400 mg) within 12 months prior to Visit 1 (Week -6).\n* Clinical evidence of coronary artery disease or any other atherosclerotic disease such as angina, MI, TIA, symptomatic carotid artery disease, CVA, CABG, PTCA, peripheral arterial disease, AAA.",
  "sex": "ALL",
  "minimum_age": "45 Years",
  "maximum_age": "70 Years",
  "healthy_volunteers": false,
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
