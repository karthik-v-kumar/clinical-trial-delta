  "inclusion": [
   {
    "text": "Men and women ≥ age 40 years and ≤ age 85 years"
   },
   {
    "text": "Patients with heterozygous familial hypercholesterolemia (heFH) or with non-familial hypercholesterolemia (non-FH) patients at high or very high cardiovascular risk"
   },
   {
    "text": "Patients with history of coronary heart disease (CHD) not having adequate control of their hypercholesterolemia with LDL-C ≥70 mg/dL, or all other patients with LDL-C ≥100 mg/dL and be on maximally-tolerated dose of statin (unless they are statin-intolerant)"
   },
   {
    "text": "Patients must have successfully completed the Motor Screening Task"
   },
   {
    "text": "Patients must be willing and able to comply with clinic visits and study related procedures"
   },
   {
    "text": "Patients must provide signed informed consent"
   }
  ],
  "exclusion": [
   {
    "text": "Patients with known Alzheimer's disease or other dementia, schizophrenia, bipolar disorder, severe depression, cognitive impairment, or patients with a sleep disorder requiring daily pharmacological treatment"
   },
   {
    "text": "Recent (within 3 months prior to the screening visit) myocardial infarction, unstable angina leading to hospitalization, coronary artery bypass graft surgery, percutaneous coronary intervention, uncontrolled cardiac arrhythmia, carotid surgery or stenting, stroke, transient ischemic attack, carotid revascularization, endovascular procedure or surgical intervention for peripheral vascular disease"
   },
   {
    "text": "Certain laboratory findings obtained during the screening visit as defined in the protocol"
   },
   {
    "text": "Any condition or situation, including other significant mental or neurological disorders that, in the investigator's opinion, may confound the study results, or may interfere significantly with the patient's participation in the study"
   },
   {
    "text": "Pregnant or breastfeeding women"
   },
   {
    "text": "A positive human immunodeficiency virus (HIV) test"
   },
   {
