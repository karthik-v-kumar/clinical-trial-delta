 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Diagnosed with type 2 diabetes mellitus."
   },
   {
    "text": "Treated with diet and exercise and a stable, maximally tolerated dose of metformin for at least 3 months prior to screening."
   },
   {
    "text": "HbA1c >=6.5% and <=9.0%."
   },
   {
    "text": "Body Mass Index (BMI) >=25 kg/m^2 and <40 kg/m^2."
   }
  ],
  "exclusion": [
   {
    "text": "Participated in an interventional medical, surgical, or pharmaceutical study within 30 days prior to screening."
   },
   {
    "text": "Characteristics contraindicating metformin or glimepiride use."
   },
   {
    "text": "Receiving drugs that directly affect gastrointestinal motility."
   },
   {
    "text": "Receiving chronic (lasting longer than 2 weeks) systemic glucocorticoid therapy."
   },
   {
    "text": "Have used any prescription drug to promote weight loss within 3 months prior to screening."
   },
   {
    "text": "Treated for longer than 2 weeks with any of the following medications within 3 months prior to screening: *insulin; *thiazolidinediones; *alpha-glucosidase inhibitors; *sulfonylurea; *meglitinides"
   }
  ],
  "notes": []
 },
