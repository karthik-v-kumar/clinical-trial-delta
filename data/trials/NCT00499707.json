 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "18 to 70 years of age"
   },
   {
    "text": "Clinical diagnosis of type 2 diabetes"
   },
   {
    "text": "HbA1c >7.5% to 11%"
   },
   {
    "text": "FPG <270mg/dL (15mmol)"
   },
   {
    "text": "Current treatment with diet and/or exercise alone, or no more than 15 days of an anti-diabetic medication or insulin within 12 weeks of screening"
   }
  ],
  "exclusion": [
   {
    "text": "Clinically significant renal or hepatic disease"
   },
   {
    "text": "Presence of anemia"
   },
   {
    "text": "Presence of unstable or severe angina, coronary insufficiency, or any congestive heart failure requiring therapy"
   },
   {
    "text": "Systolic blood pressure >170mmHg or diastolic blood pressure >100mmHg, while on anti-hypertensive treatment"
   },
   {
    "text": "Chronic disease requiring intermittent or chronic treatment with corticosteroids"
   },
   {
    "text": "Any female lactating, pregnant, or planning to become pregnant"
   },
   {
    "text": "History of hepatocellular reaction, severe edema or a medically serious fluid related event associated with any thiazolidinedione"
   },
   {
    "text": "Presence of acute or chronic metabolic acidosis"
   },
   {
    "text": "History of diabetic ketoacidosis"
   }
  ],
  "notes": []
 },
