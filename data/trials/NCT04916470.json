    "text": "Male or female, age above or equal to 18 years at the time of signing informed consent."
   },
   {
    "text": "Body mass index (BMI) greater than or equal to 30.0 kg/m^2"
   },
   {
    "text": "New York Heart Association (NYHA) Class II-IV"
   },
   {
    "text": "Left ventricular ejection fraction (LVEF) greater than or equal to 45% at screening"
   },
   {
    "text": "Diagnosed with T2D greater than or equal to 90 days prior to the day of screening"
   },
   {
    "text": "HbA1c of below or equal to 10.0% as measured at the screening visit"
   }
  ],
  "exclusion": [
   {
    "text": "A self-reported change in body weight greater than 5 kg (11 lbs) within 90 days before screening irrespective of medical records"
   },
   {
    "text": "Uncontrolled and potentially unstable diabetic retinopathy or maculopathy. Verified by a fundus examination performed within 90 days prior to screening or in the period between screening and randomisation. Pharmacological pupil-dilation is a requirement unless using a digital fundus photography camera specified for non-dilated examination."
   }
