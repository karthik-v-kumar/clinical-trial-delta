 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Signed informed consent form (ICF) which includes compliance with the requirements and restrictions listed in the ICF and in this protocol."
   },
   {
    "text": "Completed the parent trial (2010181)"
   },
   {
    "text": "Completed week 72 visit in parent trial"
   },
   {
    "text": "Did not permanently discontinue trial intervention in parent trial"
   },
   {
    "text": "Randomized within 7 Days of week 72 visit in the parent trial"
   },
   {
    "text": "Participants must use protocol-specified contraception during treatment, and for an additional 16 weeks after the last dose of trial intervention"
   }
  ],
  "exclusion": [
   {
    "text": "Planned (during the trial) surgical, endoscopic, or device-based treatment for obesity"
   },
   {
    "text": "Body mass index ≤ 18.5 kilograms per meter square (kg/m^2)"
   },
   {
    "text": "Participant has known sensitivity to any of the products or components to be administered during dosing"
   },
   {
    "text": "History of ischemic optic neuropathy"
   },
   {
    "text": "Any malignancy diagnosed during parent trial (20210181) except for the following treated with curative intent: nonmelanoma skin cancers, breast ductal carcinoma in situ, cervical carcinoma in situ, or prostate cancer in situ."
   },
   {
    "text": "Newly identified (i.e., identified during 20210181) multiple endocrine neoplasia syndrome type 2 or family (first-degree relative[s]) history of medullary thyroid cancer."
   },
   {
    "text": "Patient Health Questionnaire-9 (PHQ-9) score of ≥ 15 at week 72 visit from parent trial before randomization"
   },
   {
    "text": "Any suicidal ideation of category 4 or 5 OR any suicidal behavior on the Columbia-Suicide Severity Rating Scale (C-SSRS) Since Last Visit version at week 72 visit from parent trial before randomization."
   },
   {
    "text": "Participant unlikely to be able to complete all protocol-required procedures, restrictions and requirements, in the judgment of the individual and investigator."
   },
   {
    "text": "History or evidence of any other clinically significant disorder, condition, or disease (including, but not limited to known drug or alcohol abuse, eating disorders, and conditions identified during the parent trial) that, in the opinion of the investigator, would pose a risk to participant safety."
   },
   {
    "text": "Currently pregnant (confirmed with positive pregnancy test) or breastfeeding or"
   },
   {
    "text": "Planning to become pregnant or breastfeed while on trial until an additional 16 weeks after the last dose of trial intervention."
   },
   {
    "text": "Major surgical procedures planned during the trial."
   },
   {
    "text": "Participants with minor surgical procedures (not requiring general anesthesia or deep sedation) planned during the trial may be eligible at the discretion of the investigator."
   },
   {
    "text": "Investigative site personnel directly affiliated with the trial and/or their immediate family (ie, spouse, parent, child, or sibling, whether biological or legally adopted)."
   }
  ],
  "notes": []
 },
