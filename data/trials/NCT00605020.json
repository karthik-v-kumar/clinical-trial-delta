 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Type 2 diabetes"
   },
   {
    "text": "Duration of type 2 diabetes for at least 6 months since diagnosis"
   },
   {
    "text": "Current treatment with one or two oral antidiabetic drugs for at least 3 months or with one or two oral antidiabetic drugs, given for at least 3 months in combination with intermediate or long-acting insulin/insulin analogue once daily"
   },
   {
    "text": "BMI below 40 kg/m2"
   },
   {
    "text": "HbA1c between 7-12%"
   },
   {
    "text": "Able and willing to perform self-monitoring of capillary blood glucose"
   }
  ],
  "exclusion": [
   {
    "text": "Current antidiabetic treatment with combination of three or more oral antidiabetic drugs"
   },
   {
    "text": "Previous treatment with short-acting human insulin, short-acting insulin analogue or biphasic insulin/insulin analogue within the last 6 months (7 days or less within the last 6 months is allowed)"
   },
   {
    "text": "Known hypoglycaemia unawareness or recurrent major hypoglycaemia, as judged by the Investigator"
   },
   {
    "text": "Known or suspected allergy to trial product or related products"
   },
   {
    "text": "Pregnancy, breast-feeding, the intention of becoming pregnant or judged to be using inadequate contraceptive measures"
   },
   {
    "text": "Receipt of any investigational drug within 4 weeks prior to this trial"
   },
   {
    "text": "Previous participation in this trial"
   }
  ],
  "notes": []
 },
