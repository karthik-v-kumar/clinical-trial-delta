 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "For MAIN period (NN5401-3590):"
   },
   {
    "text": "Diagnosis of type 2 diabetes mellitus for at least 6 months"
   },
   {
    "text": "Insulin naïve subjects"
   },
   {
    "text": "Treatment with metformin and at least one other oral antidiabetic drug for at least 3 months before trial start"
   },
   {
    "text": "Glycosylated haemoglobin (HbA1c) between 7.5 - 11.0% (both inclusive)"
   },
   {
    "text": "Body Mass Index (BMI) no higher than 40.0 kg/m^2"
   },
   {
    "text": "For EXTENSION period (NN5401-3726):"
   },
   {
    "text": "Informed consent obtained before any trial-related activities"
   },
   {
    "text": "Must have completed the 26-week treatment period (visit 28) in trial NN5401-3590"
   }
  ],
  "exclusion": [
   {
    "text": "For MAIN period (NN5401-3590):"
   },
   {
    "text": "Treatment with glucagon like peptide-1 (GLP-1) receptor agonists and/or thiazolidinedione(s) within the last 3 months prior to trial start"
   },
   {
    "text": "Cardiovascular disease diagnosed within 6 months before trial start"
   },
   {
    "text": "For EXTENSION period (NN5401-3726):"
   },
   {
    "text": "Anticipated change in concomitant medication known to interfere significantly with glucose metabolism, such as systemic corticosteroids, beta-blockers, Monoamine oxidase (MAO) inhibitors"
   },
   {
    "text": "Anticipated significant lifestyle changes during the trial, e.g. shift work (including permanent night/evening shift workers), as well as highly variable eating habits as judged by the physician)"
   },
   {
    "text": "Pregnancy, breast-feeding, the intention of becoming pregnant or not using adequate contraceptive measures according to local requirements"
   }
  ],
