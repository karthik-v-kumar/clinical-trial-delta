 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Has systolic blood pressure (SBP) ≥ 140 mmHg and/or diastolic blood pressure (DBP) ≥ 90 mmHg (if DBP criteria alone is met, SBP must be ≥130 mmHg) at screening (Visit 1)."
   },
   {
    "text": "Has SBP ≥ 140 mmHg and/or DBP ≥ 90 mmHg (if DBP criteria alone is met, SBP must be ≥130 mmHg) at week 0 (Visit 3)."
   },
   {
    "text": "Untreated for hypertension, or on stable antihypertensive medications ≥ 30 days prior to Visit 1."
   },
   {
    "text": "Have a body mass index (BMI) ≥ 25 kg/m²."
   }
  ],
  "exclusion": [
   {
    "text": "Has SBP ≥170 mmHg and/or DBP ≥110 mmHg at Visit 1 or at Visit 3."
   },
   {
    "text": "Has known secondary causes of hypertension"
   },
   {
    "text": "Have heart failure with reduced ejection fraction (HFrEF) diagnosis"
   },
   {
    "text": "Have had any of the following conditions within 90 days prior to screening.",
    "sub_items": [
     "hospitalization for hypertension or for congestive heart failure",
     "acute coronary syndrome or acute myocardial infarction, or",
     "cerebrovascular accident (stroke)."
    ]
   },
   {
    "text": "Have type 1 diabetes (T1D)"
   },
   {
    "text": "Have acute or chronic hepatitis, including a history of autoimmune hepatitis"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
