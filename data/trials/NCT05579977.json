   "measure": "Placebo-adjusted, Change From Baseline in Percentage of Glycated Hemoglobin (HbA1c) at Week 32: Cohort 1 (Type 2 Diabetes Mellitus)",
   "time_frame": "Baseline (result closest prior to dosing on Day 1), Week 32"
  },
