 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Type 2 Diabetes Mellitus (T2DM) diagnosed ≤ 24 months ago"
   },
   {
    "text": "glycosylated hemoglobin (HbA1c) ≥6.5% and ≤7.5% at Visit 1"
   },
   {
    "text": "Treatment-naïve."
   },
   {
    "text": "Body mass index (BMI) ≥22 and ≤40 kg/m2 at Visit 1"
   }
  ],
  "exclusion": [
   {
    "text": "Pregnant or nursing (lactating) women"
   },
   {
    "text": "Fasting plasma glucose (FPG) ≥ 270 mg/dL (≥ 15.0 mmol/L)"
   },
   {
    "text": "Previous or current participation in any vildagliptin clinical study."
   },
   {
    "text": "History of hypersensitivity to dipeptidyl peptidase-4 (DPP-4) inhibitors."
   },
   {
    "text": "Concurrent medical condition that may interfere with the interpretation of efficacy and safety data during the study."
   },
   {
    "text": "Donation of blood or significant blood loss equaling to at least one unit of blood within the past 2 weeks of start of study or a blood transfusion within the past 12 weeks or planned regular transfusions during the study period."
   }
  ],
  "notes": []
 },
