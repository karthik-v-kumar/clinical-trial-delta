 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Patients between 18 and 75 years of age with Type 2 Diabetes Mellitus and are currently on metformin monotherapy for glycemic control (100mg daily for at least 3 months prior to screening)."
   },
   {
    "text": "Patients must have stopped previous treatment with thiazolidinediones or other anti-diabetic agents at least 3 months prior to screening."
   },
   {
    "text": "Women must be post-menopausal, surgically sterile or using acceptable contraceptive measures."
   }
  ],
  "exclusion": [
   {
    "text": "Prior history of hepatocellular reaction to or severe edema associated with the use of thiazolidinediones."
   },
   {
    "text": "Have a known hypersensitivity to thiazolidinediones or biguanides."
   },
   {
    "text": "Currently using insulin or any oral anti-diabetic agent other than metformin."
   },
   {
    "text": "History of metabolic acidosis."
   },
   {
    "text": "History of substance abuse."
   },
   {
    "text": "Have active cancer other than localized squamous or basal cell carcinoma."
   },
   {
    "text": "Chronic disease requiring treatment with corticosteroids."
   },
   {
    "text": "Other criteria will be evaluated at the screening visit."
   }
  ],
