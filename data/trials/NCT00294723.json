 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Type 2 diabetes"
   },
   {
    "text": "TTreatment with diet/exercise or with not more than half maximal dose of oral anti-diabetic drugs alone for at least 2 months"
   },
   {
    "text": "Diet/exercise treated subjects with HbA1c between 7.0% and 11%, inclusive"
   },
   {
    "text": "OAD (oral anti-diabetic drug) treated subjects with HbA1c between 7.0% and 10%, inclusive"
   },
   {
    "text": "Body Mass Index (BMI) less than or equal to 45 kg/m^2"
   }
  ],
  "exclusion": [
   {
    "text": "Treatment with insulin for the last 3 months, except short-term treatment for intercurrent illness"
   },
   {
    "text": "Treatment with any drug that could interfere with the glucose level (besides use of a single anti-diabetic compound)"
   },
   {
    "text": "Any serious medical condition"
   }
  ],
  "notes": []
 },
