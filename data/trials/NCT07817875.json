 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "J4M-MC-PW02"
   },
   {
    "text": "Are 6 to less than 12 years of age (Tanner stage 1 to 5 inclusive)"
   },
   {
    "text": "Have:",
    "sub_items": [
     "a body weight of ≥ 40 kilograms (kg) (88 pounds), and",
     "been diagnosed with obesity, as defined by BMI equal to or above the 95th percentile for age and sex, on age- and sex-specific growth chart"
    ]
   },
   {
    "text": "J4M-MC-PWMP"
   },
   {
    "text": "Have a history of at least 1 unsuccessful effort to lose sufficient body weight after participation in a structured lifestyle modification program (diet and exercise counseling for at least 3 months) prior to screening."
   },
   {
    "text": "Obesity as defined by BMI equal to or above the 95th percentile for age and sex (on age- and gender-specific growth chart [CDC-NCHS, 2022])"
   }
  ],
  "exclusion": [
   {
    "text": "J4M-MC-PW02"
   },
   {
    "text": "Have a history of",
    "sub_items": [
     "proliferative diabetic retinopathy",
     "diabetic macular edema, or",
     "nonproliferative diabetic retinopathy that requires acute treatment"
    ]
   },
   {
    "text": "J4M-MC-PWMP"
   },
   {
    "text": "Have undergone or plan to undergo weight reduction procedure during the study, such as, but not limited to:",
    "sub_items": [
     "gastric bypass",
     "sleeve gastrectomy",
     "restrictive bariatric surgery, such as Lap-Band® gastric banding, or",
     "any other procedure intended to result in weight reduction."
    ]
   },
   {
    "text": "Have a diagnosis that is a secondary cause of obesity or have a history of abrupt onset of obesity suggesting a secondary cause, such as hypothalamic, monogenetic, syndromic, or endocrine causes."
   },
   {
    "text": "Have type 1 diabetes or history of ketoacidosis, or hyperosmolar state."
   },
   {
    "text": "Have HbA1c >9.0% (75 mmol/mol) as measured by central laboratory at screening."
   },
   {
    "text": "Have a family or personal history of medullary thyroid carcinoma or Multiple Endocrine Neoplasia Syndrome Type 2."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
