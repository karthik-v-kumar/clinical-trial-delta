 "primary_outcomes": [
  {
   "measure": "Compare change from basline in HbA1c after 24 weeks and 50 weeks of treatment with muraglitazar + metformin vs. pioglitazone + metformin",
   "time_frame": null
  }
 ],
 "brief_summary": "The purpose of this study is to evaluate if type 2 diabetics who have inadequate glycemic control on metformin alone, have a similar, or not inferior, glycemic response when treated with the combination of muraglitazar and metformin compared to pioglitazone and metformin.",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Type 2 diabetics\n* HbA1c ≥7.0% and ≤10.0%,currently receiving a stable dose of metformin 1500 to 2550 mg/day for at least 6 weeks prior to screening were enrolled in this study.\n* Fasting C-peptide ≥1.0 ng/mL\n* BMI≤41 kg/m2 mean fasting serum trig. ≤600 g/dL\n\nExclusion Criteria:\n\n* symptomatic type 2 diabetics with \\> 10% weight loss 3 months prior to study\n* history of diabetic ketoacidosis, hyperosmolar nonketotic coma, insulin therapy, inability to take muraglitazar, pioglitazone, or metformin according to investigator brochure or labeling\n* History of MI (myocardial infarction), coronary angioplasty or bypass graft(s), valvular disease or repair, unstable angina pectoris, transient ischemic attack (TIA), cerebrovascular attack, or cerebrovascular accident (CVA) within 6 months, congestive heart failure (NYHA Class III and IV, uncontrolled hypertension, history of, or renal disease, peripheral vascular disease (PVD), pulmonary disease, gastrointestinal disease, active liver disease or endocrine disease.",
  "sex": "ALL",
  "minimum_age": "18 Years",
  "maximum_age": "70 Years",
  "healthy_volunteers": false,
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
