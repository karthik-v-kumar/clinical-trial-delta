 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "adult patients, 18-75 years of age;"
   },
   {
    "text": "type 2 diabetes mellitus;"
   },
   {
    "text": "treated with stable sulfonylurea monotherapy or metformin + sulfonylurea for >=12 weeks prior to screening;"
   },
   {
    "text": "HbA1c >=7.0% and <=10% at screening;"
   },
   {
    "text": "stable weight +/-5% for >=12 weeks prior to screening."
   }
  ],
  "exclusion": [
   {
    "text": "type 1 diabetes, diabetes resulting from pancreatic injury, or secondary forms of diabetes;"
   },
   {
    "text": "clinically significant diabetic complications;"
   },
   {
    "text": "clinically symptomatic gastrointestinal disease;"
   },
   {
    "text": ">3 episodes of severe hypoglycemia within 6 months before screening."
   }
  ],
  "notes": []
 },
