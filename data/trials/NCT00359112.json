 ],
 "sponsors_of_note": [],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Body mass index > or = to 25 kg/m2."
   },
   {
    "text": "HbA1c > or =7% and < or =10% at screening."
   },
   {
    "text": "FPG > or = 7.0mmol/L (126mg/dL) at visit 2."
   },
   {
    "text": "Receiving at least 0.85g of metformin at constant dose(s) for at least 8 weeks prior to visit 1a."
   },
   {
    "text": "Female subjects must be postmenopausal or using effective contraceptive measures."
   }
  ],
  "exclusion": [
   {
    "text": "Use of any other oral antidiabetic drug other than metformin within 12 weeks prior to screening."
   },
   {
    "text": "Subjects with clinically significant ongoing oedema requiring pharmacological treatment or with a history of oedema requiring pharmacological treatment."
   },
   {
    "text": "Subjects with a history of severe hypoglycaemia."
   },
   {
    "text": "Renal disease or renal dysfunction."
   },
   {
    "text": "Presence of clinically significant hepatic disease."
   },
   {
    "text": "Presence of unstable or severe angina or known NYHA grade I-IV congestive heart failure."
   },
   {
    "text": "Subjects who have had a previous myocardial infarction, percutaneous transluminal coronary angioplasty, coronary artery bypass graft or cerebrovascular accident within 3 months prior to screening."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
