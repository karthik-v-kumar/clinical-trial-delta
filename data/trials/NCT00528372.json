 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Males and females, aged 18 to 77 years"
   },
   {
    "text": "Type 2 diabetes with inadequate glycemic control, defined as: Group 1, hemoglobin A1c (HbA1c) ≥7% and ≤10%; Group 2, HbA1c ≥10.1% and ≤12.0%"
   },
   {
    "text": "Drug naive, defined as never having received prescription medications for diabetes, having received prescription medications for diabetes for <24 weeks since the original diagnosis"
   },
   {
    "text": "C-peptide ≥1.0 ng/mL at enrollment"
   },
   {
    "text": "Body Mass Index ≤ 45.0 kg/m^2 at enrollment"
   }
  ],
  "exclusion": [
   {
    "text": "Urine albumin:creatinine ratio >1,800 mg/g"
   },
   {
    "text": "Aspartate aminotransferase >3*upper limit of normal (ULN)"
   },
   {
    "text": "Alanine aminotransferase >3*ULN"
   },
   {
    "text": "Serum total bilirubin >2*ULN"
   },
   {
    "text": "Serum creatinine ≥1.5 mg/dL for men; ≥1.4 mg/dLfor women"
   },
   {
    "text": "Calcium value outside of the central laboratory normal reference range"
   },
   {
    "text": "Positive hepatitis B surface antigen"
   },
   {
    "text": "Positive anti-hepatitis C virus antibody"
   },
   {
    "text": "Hemoglobin ≤11 g/dL for men; hemoglobin ≤10 g/dL for women"
   },
   {
    "text": "Creatine kinase >3*ULN"
   },
   {
    "text": "Abnormal free T4 values"
   },
   {
    "text": "History of diabetes insipidus"
   },
   {
    "text": "Symptoms of poorly controlled diabetes, including marked polyuria and polydipsia with greater than 10% weight loss in the 3 months prior to enrollment"
   },
   {
    "text": "History of diabetic ketoacidosis or hyperosmolar nonketotic coma"
   },
   {
    "text": "Severe uncontrolled hypertension defined as systolic blood pressure ≥180 mm Hg and/or diastolic blood pressure ≥110 mm Hg"
   },
   {
    "text": "Any of the following within 6 months of enrollment: Myocardial infarction, cardiac surgery or revascularization, unstable angina, unstable congestive heart failure (CHF), CHF New York Heart Association Class III or IV status, transient ischemic attack or significant cerebrovascular disease, unstable or previously undiagnosed arrhythmia"
   },
   {
    "text": "History of unstable or rapidly progressing renal disease"
   },
   {
    "text": "Conditions of congenital renal glucosuria"
   },
   {
    "text": "Significant hepatic disease, including chronic active hepatitis and/or severe hepatic insufficiency"
   },
   {
    "text": "Documented history of hepatotoxicity with any medication"
   },
   {
    "text": "Documented history of severe hepatobiliary disease"
   },
   {
    "text": "History of hemoglobinopathy, with the exception of sickle cell trait, thalassemia minor, or chronic or recurrent hemolysis"
   },
   {
    "text": "Donation of blood or blood products to a blood bank, blood transfusion, or participation in a clinical study requiring withdrawal of >400 mL of blood during the 6 weeks prior to enrollment"
   },
   {
    "text": "Malignancy (with the exception of treated basal cell or treated squamous cell carcinoma) within 5 years of enrollment visit"
   },
   {
    "text": "Known immunocompromised status, including individuals who had undergone organ transplantation or who had positive HIV results"
   },
   {
    "text": "Administration of any antidiabetic therapy for more than 14 days (consecutive or not) during the 12 weeks prior to enrollment"
   },
   {
    "text": "Administration of any antidiabetic therapy, other than any previously specified, at any dose, at any time during the 4 weeks prior to enrollment"
   },
   {
    "text": "Replacement or chronic systemic corticosteroid therapy, defined as any dose of systemic corticosteroid taken for >4 weeks within 3 months prior to enrollment"
   },
   {
    "text": "History of bariatric surgery or lap-band procedure"
   },
   {
    "text": "Administration of sibutramine, phentermine, orlistat, rimonabant, benzphetamine, diethylpropion, methamphetamine, and/or phendimetrazine, within 30 days of enrollment"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
