 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "18 to 65 years old."
   },
   {
    "text": "Type 2 diabetes patients insufficient controlled by 1-3 oral anti-hyperglycemic drugs (OADs) with stable dose at least 3 months:"
   },
   {
    "text": "If on 1 OAD, provided with the following doses (including but not limited to):",
    "sub_items": [
     "α-glucosidase inhibitor: 100mg, three times a day (tid);",
     "metformin: 1.5-2.0 g/day;",
     "sulphonylureas: sub-maximum (half dose above) to maximum tolerated dose;",
     "thiazolidinediones: eg. pioglitazone, 30-40 mg/day.",
     "Besides the medications listed above, if on 1 OAD, others should be maximum tolerated dose allowed in package insert."
    ]
   },
   {
    "text": "If on 2-3 OADs, any range of dose is acceptable."
   },
   {
    "text": "HbA1c >7%, and ≤10.5%."
   },
   {
    "text": "FPG >7 mmol/L."
   },
   {
    "text": "Body mass index (BMI) ≥20 kg/m^2, and ≤40 kg/m^2."
   },
   {
    "text": "Diabetes duration ≥1 year."
   },
   {
    "text": "Physician decides to and the patient is willing to start basal insulin (BI) treatment."
   },
   {
    "text": "Willing to join the study and sign the informed consent."
   }
  ],
  "exclusion": [
   {
    "text": "Type 1 diabetes patients."
   },
   {
    "text": "Patients with acute diabetic complications (including unexplained severe hypoglycemia in the last 6 months)."
   },
   {
    "text": "Previous treatment with insulin for more than 1 month cumulatively in last 1 year, or treatment with insulin in the last 3 months before the screening."
   },
   {
    "text": "Known hypoglycemia unawareness or recurrent hypoglycemia."
   },
   {
    "text": "Hypersensitivity to study drug or its excipients."
   },
   {
    "text": "Any clinically significant acute major organ or systemic disease, or any other situation judged by the Investigator, that is difficult for the 24 weeks follow-up."
   },
   {
    "text": "Pregnancy or breastfeeding women."
   },
   {
    "text": "Have any mental disorders, lack self-control or not able to express accurately."
   },
   {
    "text": "Involved in another clinical trial simultaneously or within a 1 month before start of trial."
   },
   {
    "text": "The above information is not intended to contain all considerations relevant to a patient's potential participation in a clinical trial."
   }
  ],
