 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Hypertension (defined as systolic blood pressure 140 mmHg or a diastolic blood pressure 90 mmHg (defined as the disapperance of all sound [Korotkoff Phase V] or receiving anti-hypertensive treatment. Blood pressure should be measured after sitting the patient quietly for 3 minutes).",
    "group": "Patients must have a documented history of at least one of the following"
   },
   {
    "text": "Retinopathy (defined as any of the following; non-proliferative retinopathy, pre-pre-proliferative retinopathy, proliferative retinopathy, maculopathy, advanced diabetic eye disease or history of photocoagulation).",
    "group": "Patients must have a documented history of at least one of the following"
   },
   {
    "text": "Microalbuminuria (defined as either, Albumin creatinine ratio > than = to 2.5 mg/mmol, or Albumin excretion rate on a timed collection > than = to 20 mcg/min (> than = to 30 mg/24hrs) on two successive occasions, or a positive micral or other strip test).",
    "group": "Patients must have a documented history of at least one of the following"
   },
   {
    "text": "Macroalbuminuria (defined as either; Albustix or other dipstick evidence of gross proteinuria, Albumin creatinine ratio > than = to 25 mg/mmol; or Albumin excretion rate on a timed collection > than = 200 mcg/min (> than = 300 mg/24hrs) on two sucessive occasions).",
    "group": "Patients must have a documented history of at least one of the following"
   },
   {
    "text": "Current smoker",
    "group": "Patients must have a documented history of at least one of the following"
   }
  ],
  "exclusion": [
   {
    "text": "Type I Diabetes Mellitus"
   },
   {
    "text": "Any major Coronary event prior to entry into the study"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
