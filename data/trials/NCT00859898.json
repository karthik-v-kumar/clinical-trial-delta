 "registry_url": "https://clinicaltrials.gov/study/NCT00859898",
 "content_hash": "184f722fd6040838",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-drugs",
  "t2d-sponsors"
 ],
 "sponsors_of_note": [
  "AstraZeneca"
 ],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Treatment naive males and females, >= 18 years old and"
   },
   {
    "text": "<= 77 years old, with type 2 diabetes mellitus"
   },
   {
    "text": "Subjects must have central laboratory pre-randomization hemoglobin A1C >= 7.5 and <= 12.0%"
   },
   {
    "text": "C-peptide >= 1.0 ng/mL (0.34 nmol/L)"
   },
   {
    "text": "Body Mass Index <= 45 kg/m2"
   },
   {
    "text": "Must be able to perform self monitoring of blood glucose"
   }
  ],
  "exclusion": [
   {
    "text": "aspartate aminotransferase (AST) and/or alanine aminotransferase (ALT) >3X*upper limit of normal (ULN)"
   },
   {
    "text": "Serum Total bilirubin >2 mg/dL (34.2 µmol/L)"
   },
   {
    "text": "Creatinine kinase >3*ULN"
   },
   {
    "text": "Serum creatinine >= 1.50 mg/dL (133 µmol/L) for male subjects, >= 1.40 mg/dL (124 µmol/L) for female subjects"
   },
   {
    "text": "Calcium value outside of the central laboratory normal reference range"
   },
   {
    "text": "Currently unstable or serious cardiovascular, renal, hepatic, hematological, oncological, endocrine, psychiatric, or rheumatic diseases"
   },
   {
    "text": "Urine albumin:creatinine ratio (UACR) >1800 mg/g (203.4 mg/mmol Cr)"
   },
   {
    "text": "Severe uncontrolled hypertension defined as systolic blood pressure (SBP) >=180 mmHg and/or diastolic blood pressure (DBP) >=110 mmHg"
   },
   {
    "text": "Hemoglobin >=11.0 g/dL (110 g/L) for men; hemoglobin >=10.0 g/dL (100 g/L) for women"
   },
   {
    "text": "Positive for hepatitis B surface antigen"
   },
   {
    "text": "Positive for anti-hepatitis C virus antibody"
   },
   {
    "text": "History of diabetes insipidus"
   },
   {
    "text": "History of diabetic ketoacidosis or hyperosmolar nonketotic coma"
   },
   {
    "text": "Symptoms of poorly controlled diabetes that would preclude participation in this trial"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
