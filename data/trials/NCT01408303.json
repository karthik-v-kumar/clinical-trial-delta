 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Men or women, ≥18 years of age."
   },
   {
    "text": "Fasting triglyceride (TG) level ≥200 mg/dL and <500 mg/dL."
   },
   {
    "text": "The subject is a high risk for a future cardiovascular event."
   },
   {
    "text": "The subject is treated with a statin and at or near LDL-C goal."
   }
  ],
  "exclusion": [
   {
    "text": "Allergy or intolerance to omega-3 fatty acids and omega-3-acid ethyl esters."
   },
   {
    "text": "Use of fibrates, bile acid sequestrants, or niacin or its analogues (greater than 200 mg/d) during screening."
   },
   {
    "text": "Use of simvastatin 80 mg or Vytorin10/80 mg during screening."
   },
   {
    "text": "Use of any eicosapentaenoic acid (EPA) or docosahexaenoic acid (DHA) products."
   },
   {
    "text": "Use of any supplement for the purpose of lowering plasma cholesterol during screening."
   },
   {
    "text": "Use of weight loss drugs or programs during screening."
   },
   {
    "text": "Use of erythromycin, telithromycin, clarithromycin, cyclosporine, itraconazole, ketoconazole, protease inhibitors, or nefazodone during screening."
   },
   {
    "text": "Use of anticoagulants during screening."
   },
   {
    "text": "Use of oral or injected corticosteroids during screening."
   },
   {
    "text": "Use of tamoxifen, estrogens, progestins, or testosterone, that has not been stable for >4 weeks at Visit 1, or is unstable during screening."
   },
   {
    "text": "Use of >750 mL/d grapefruit juice during screening."
   },
   {
    "text": "Known lipoprotein lipase impairment or deficiency, or apolipoprotein C-II deficiency or familial dysbetalipoproteinemia."
   },
   {
    "text": "History of pancreatitis."
   },
   {
    "text": "Type I diabetes mellitus, use of insulin, or HbA1c >10% at Visit 1."
   },
   {
    "text": "Poorly controlled hypertension"
   },
   {
    "text": "Uncontrolled hypothyroidism, or thyroid stimulating hormone (TSH) >1.5xULN at Visit 2."
   },
   {
    "text": "Recent history or current significant nephrotic syndrome, pulmonary, hepatic, biliary, gastrointestinal or immunologic disease."
   },
   {
    "text": "History of cancer (except non-melanoma skin cancer, or carcinoma in situ of cervix) within the previous two years."
   },
   {
    "text": "Females who are pregnant, planning to be pregnant during the study period, lactating, or women of childbearing potential who are not using an acceptable method of contraception."
   },
   {
    "text": "Creatine kinase >5.0 times upper limit of normal (ULN); aspartate aminotransferase (AST) or alanine aminotransferase (ALT) >2.5 times ULN at Visit 2."
   },
   {
    "text": "Current or recent history (past 12 months) of drug or alcohol abuse."
   },
   {
    "text": "Exposure to any investigational agent within 4 weeks prior to Visit 1."
   },
   {
    "text": "Any other condition the investigator believes would interfere with the subject's ability to provide informed consent, comply with study instructions, or which might confound the interpretation of the study results or put the subject at undue risk."
   }
  ],
