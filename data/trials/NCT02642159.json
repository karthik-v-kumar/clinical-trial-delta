 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Participants with type 2 diabetes and mixed dyslipidemia whose non-HDL-C was not adequately controlled with a stable, maximum dose/regimen of statin that was tolerated by the participant."
   },
   {
    "text": "18 years of age or more."
   },
   {
    "text": "Documented history of atherosclerotic cardiovascular disease (ASCVD) or at least one additional cardiovascular risk factor."
   },
   {
    "text": "Non-HDL-C of 100 mg/dL or greater."
   },
   {
    "text": "Triglycerides greater than or equal to 150 mg/dL and less than 500 mg/dL."
   },
   {
    "text": "Stable anti-hyperglycemic agents for at least 3 months prior to the screening visit and between screening and randomization (including stable insulin dose defined as no variation more than 30% in daily insulin dose within the preceding 3 months, as judged by the Investigator)."
   },
   {
    "text": "No change in weight of more than 5 kg within the prior 3 months."
   },
   {
    "text": "On stable dose of medications that are known to influence weight and/or lipids within the last 3 months."
   }
  ],
  "exclusion": [
   {
    "text": "Use of any lipid modifying therapies other than statins within the last 4 weeks (eg, ezetimibe, fenofibrate, nicotinic acid, omega-3 fatty acids, etc.) or use of over the counter products/nutraceuticals known to impact lipids (eg, red yeast rice) within the last 4 weeks."
   },
   {
    "text": "Currently drinking more than 2 standard alcoholic drinks per day."
   },
   {
    "text": "Body Mass Index (BMI) >45 kg/m² or currently enrolled in a weight loss program and still in active phase of weight loss."
   },
   {
    "text": "Glycosylated hemoglobin (HbA1c) 9% or greater."
   },
   {
    "text": "The above information was not intended to contain all considerations relevant to a participant's potential participation in a clinical trial."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
