 "primary_outcomes": [
  {
   "measure": "Measure: To evaluate the efficacy of vildagliptin as monotherapy in patients with T2DM by assessing changes in HbA1c from baseline to 24 weeks.",
   "time_frame": "24 weeks"
  }
 ],
 "brief_summary": "This is a 2-3 period parallel group study with an adaptive element in Type 2 diabetes patients receiving vildagliptin as monotherapy.",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Patients at least 18 years of age at Visit 1\n* Drug naïve patients with T2DM diagnosed at least 2 months prior to Visit 1\n* HbA1c ≥ 7.0 % and ≤ 10.0% at Visit 1\n* Body Mass Index (BMI) in the range of 22-45 kg/m2 at Visit 1\n\nExclusion Criteria:\n\n* Pregnant or lactating female\n* FPG ≥ 270 mg/dL (≥15 mmol/L)\n\nOther protocol-defined inclusion/exclusion criteria may apply",
