 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Diagnosed with Type 2 Diabetes Mellitus for at least 90 days prior to screening"
   },
   {
    "text": "On SGTL2i or SGLT2i-naïve and other glucose lowering medication(s)"
   },
   {
    "text": "HbA1c value:",
    "sub_items": [
     "On stable dose of SGLT2i ≥ 7.0 % to ≤ 10.5% (53 to 91.3 mmol/mol)",
     "SGLT2i-naive ≥ 7.5% to ≤ 10.5% (58 to 91.3 mmol/mol)"
    ]
   },
   {
    "text": "Impaired renal function"
   },
   {
    "text": "Body mass index (BMI) of ≥ 23 kg/m2 at screening"
   },
   {
    "text": "Stable body weight (self-reported or documented) for 90 days prior to screening"
   }
  ],
  "exclusion": [
   {
    "text": "Type 1 Diabetes, secondary forms of diabetes (including congenital forms), or history of ketoacidosis or hyperosmolar coma"
   },
   {
    "text": "Currently receiving or anticipated to receive, therapeutic intervention for diabetic retinopathy and/or macular edema"
   },
   {
    "text": "Have had more than one episode of severe hypoglycemia within 180 days prior to screening or has a history of hypoglycemia unawareness or poor recognition of hypoglycemic symptoms"
   },
   {
    "text": "Clinically significant condition affecting the upper GI tract or chronic use of any medication that affects gastric motility or gastric emptying"
   },
   {
    "text": "History of acute or chronic pancreatitis"
   },
   {
    "text": "Severe congestive heart failure (New York Heart Association IV)"
   },
   {
    "text": "History/family history of medullary thyroid cancer or multiple endocrine neoplasia type 2"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
