 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Males and females with type 2 diabetes (receiving pharmacologic treatment for at least 6 months or longer) with stable diabetes therapy"
   },
   {
    "text": "Lipid-lowering therapy must be unchanged for at least 4 weeks or more"
   },
   {
    "text": "Subjects receiving statin therapy at screening must have a fasting LDL-C of greater than or equal to 100 mg/dL"
   },
   {
    "text": "Subjects not receiving statin therapy at screening must have a fasting LDL-C of greater than or equal to 130 mg/dL"
   }
  ],
  "exclusion": [
   {
    "text": "New York Heart Association (NYHA) class III or IV heart failure"
   },
   {
    "text": "Uncontrolled cardiac arrhythmia"
   },
   {
    "text": "Uncontrolled hypertension"
   },
   {
    "text": "Type 1 diabetes or poorly controlled type 2 diabetes"
   },
   {
    "text": "Uncontrolled hypothyroidism or hyperthyroidism."
   }
  ],
  "notes": []
 },
