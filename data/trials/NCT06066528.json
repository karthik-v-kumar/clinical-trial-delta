 "registry_url": "https://clinicaltrials.gov/study/NCT06066528",
 "content_hash": "3af1bc9e355cf0f4",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-sponsors"
 ],
