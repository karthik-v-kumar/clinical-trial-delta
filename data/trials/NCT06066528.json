 "registry_url": "https://clinicaltrials.gov/study/NCT06066528",
 "content_hash": "3af1bc9e355cf0f4",
 "collections": [
  "type-2-diabetes"
 ],
 "matched_queries": [
  "t2d-sponsors"
 ],
 "sponsors_of_note": [
  "Boehringer Ingelheim"
 ],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Male or female, age ≥18 years at the time of signing informed consent, and at least the legal age of consent in countries where it is >18 years."
   },
   {
    "text": "Body mass index (BMI) ≥27 kg/m^2 at screening."
   },
   {
    "text": "Diagnosed with Type 2 diabetes mellitus (T2DM) (defined as Glycosylated haemoglobin A1c (HbA1c) ≥6.5% [≥48 mmol/mol]) at least 180 days prior to screening."
   },
   {
    "text": "HbA1c ≥6.5% (≥48 mmol/mol) and <10% (<86 mmol/mol) as measured by the central laboratory at screening."
   },
   {
    "text": "Currently treated for T2DM with either diet and exercise alone or stable treatment (for at least 3 months prior to screening) per treatment guidelines."
   },
   {
    "text": "History of at least one self-reported unsuccessful dietary effort to lose body weight Further inclusion criteria apply."
   }
  ],
  "exclusion": [
   {
    "text": "Body weight change (self-reported) of >5% within 3 months before screening."
   },
   {
    "text": "Treatment with any medication for the indication obesity within 3 months before screening."
   },
   {
    "text": "Treatment with any medication for indication of T2DM other than stated in the inclusion criteria and glucagon-like peptide-1 receptor (GLP-1R)-based agonists) and dipeptidyl peptidase 4 inhibitor [DPP-4il)."
   },
   {
    "text": "Known clinically significant gastric emptying abnormality (e.g., severe diabetic gastroparesis or gastric outlet obstruction)."
   },
   {
    "text": "History of either chronic or acute pancreatitis or elevation of serum lipase or amylase >2x upper limit of normal (ULN)) as measured by the central laboratory at screening."
   },
   {
    "text": "Personal or family history of medullary thyroid carcinoma (MTC) or multiple endocrine neoplasia syndrome type 2 (MEN 2)."
   },
   {
    "text": "Further exclusion criteria apply."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
