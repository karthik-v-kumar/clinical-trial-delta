  "t2d-drugs"
 ],
 "sponsors_of_note": [],
 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Patients must have a diagnosis of type 2 diabetes"
   },
   {
    "text": "Body mass index (BMI) >=22 to <=45 kg/m2, at screening"
   },
   {
    "text": "Patients must be taking a stable dosage of metformin as monotherapy at screening"
   },
   {
    "text": "Patients must have a HbA1c between >=7% and <=9.5% at Week 2"
   },
   {
    "text": "Patients must have a fasting plasma glucose (FPG) <=270 mg/dL (15 mmol/L) at Week -2"
   }
  ],
  "exclusion": [
   {
    "text": "Patients having prior exposure or known contraindication or suspected hypersensitivity to JNJ-28431754, glimepiride, or metformin"
   },
   {
    "text": "History of diabetic ketoacidosis or type 1 diabetes mellitus"
   },
   {
    "text": "History of pancreas or beta-cell transplantation"
   },
   {
    "text": "History of active proliferative diabetic retinopathy"
   },
   {
    "text": "History of hereditary glucose-galactose malabsorption or primary renal glucosuria"
   },
   {
    "text": "Renal disease requiring treatment with immunosuppressive therapy within the past 12 months before screening or a history of dialysis or renal transplant"
   },
   {
    "text": "Taken thiazolidinedione therapy in the past 16 weeks before screening"
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
 "history": []
}
