 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Male or female (sex at birth)."
   },
   {
    "text": "Age 18 years or above at the time of signing the informed consent."
   },
   {
    "text": "Diagnosed with type 2 diabetes mellitus greater than or equal to (>=) 180 days before screening."
   },
   {
    "text": "Stable daily dose(s) >= 90 days before screening of any of the following antidiabetic drug(s) or combination regimen(s) at effective or maximum tolerated dose as judged by the investigator:"
   },
   {
    "text": "Metformin"
   },
   {
    "text": "sodium-glucose co-transporter 2 inhibitor (SGLT2i)"
   },
   {
    "text": "Glycated haemoglobin (HbA1c) 7.0-10.5 percent (53-91 millimoles per mol [mmol/mol]) (both inclusive) as determined by central laboratory at screening."
   },
   {
    "text": "Body mass index (BMI) >= 30 kilogram per square meter (kg/m^2) at screening. BMI will be calculated in the electronic case report form (eCRF) based on height and body weight at screening."
   }
  ],
  "exclusion": [
   {
    "text": "Female who is pregnant, breast-feeding or intends to become pregnant or is of childbearing potential and not using a highly effective contraceptive method."
   },
   {
    "text": "Renal impairment with estimated Glomerular Filtration Rate less than < 30 milliliter per minute per 1.73 square meter (mL/min/1.73 m^2) as determined by central laboratory at screening."
