 "eligibility_checklist": {
  "parsed": true,
  "inclusion": [
   {
    "text": "Male or female."
   },
   {
    "text": "Age above or equal to 18 years at the time of signing informed consent."
   },
   {
    "text": "Body mass index (BMI) greater than or equal to 30.0 kilogram per square meter (kg/m^2)."
   },
   {
    "text": "History of at least one self-reported unsuccessful dietary effort to lose body weight."
   }
  ],
  "exclusion": [
   {
    "text": "HbA1c greater than or equal to 48 millimoles per mole (mmol/mol) (6.5 percent) as measured by the central laboratory at screening."
   },
   {
    "text": "History of type 1 or type 2 diabetes."
   },
   {
    "text": "Treatment with glucose-lowering agent(s) within 90 days before screening."
   },
   {
    "text": "A self-reported change in body weight greater than 5 kilograms (kg) (11 pounds) within 90 days before screening irrespective of medical records."
   },
   {
    "text": "Personal or first-degree relative(s) history of multiple endocrine neoplasia type 2 or medullary thyroid carcinoma."
   }
  ],
  "notes": []
 },
 "in_watchlist": true,
