 "primary_outcomes": [
  {
   "measure": "Percent Change From Baseline in LDL-C at Week 12",
   "time_frame": "Baseline and Week 12"
  },
  {
   "measure": "Percent Change From Baseline in LDL-C at the Mean of Weeks 10 and 12",
   "time_frame": "Baseline and Weeks 10 and 12"
  }
 ],
 "brief_summary": "The primary objective was to evaluate the effect of 12 weeks of subcutaneous (SC) evolocumab every 2 weeks (Q2W) and monthly (QM), compared with ezetimibe, on percent change from baseline in low-density lipoprotein cholesterol (LDL-C) in hypercholesterolemic adults unable to tolerate an effective dose of a statin (HMG-CoA (5-hydroxy-3-methylglutaryl-coenzyme A) reductase inhibitors).",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Male or female ≥ 18 to ≤ 80 years of age\n* Not on a statin or on a low dose statin with stable dose for at least 4 weeks\n* History of intolerance to at least 2 statins\n* Subject not at LDL-C goal\n* Lipid lowering therapy has been stable prior to enrolment for at least 4 weeks.\n* Fasting triglycerides ≤ 400 mg/dL\n\nExclusion Criteria:\n\n* New York Heart Association (NYHA) III or IV heart failure\n* Uncontrolled cardiac arrhythmia\n* Uncontrolled hypertension\n* Type 1 diabetes, poorly controlled type 2 diabetes\n* Uncontrolled hypothyroidism or hyperthyroidism",
  "sex": "ALL",
  "minimum_age": "18 Years",
  "maximum_age": "80 Years",
  "healthy_volunteers": false,
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
