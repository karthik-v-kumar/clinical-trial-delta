  "inclusion": [
   {
    "text": "Males and females, ≥ 18 years old, with type 2 diabetes and with inadequate glycemic control"
   },
   {
    "text": "All subjects must have central laboratory pre-randomization A1C ≥ 7.0 and ≤ 10.5%"
   },
   {
    "text": "C-peptide ≥ 1.0 ng/mL (0.34 nmol/L)"
   },
   {
    "text": "Body Mass Index ≤ 45.0 kg/m²"
   }
  ],
  "exclusion": [
   {
    "text": "AST and /or ALT > 2.5 times the upper limit of normal"
   },
   {
    "text": "Serum total bilirubin > 2 mg/dL (34.2 µmol/L)"
   },
   {
    "text": "Creatinine kinase > 3.0 times the upper limit of normal"
   },
   {
    "text": "Symptoms of severely uncontrolled diabetes"
   },
   {
    "text": "Serum creatinine ≥ 2.0 mg/dL"
   },
   {
    "text": "Calculated Cr-Clearance < 50 ml/min (calculated by Cockroft-Gault formula)"
   },
   {
    "text": "Currently unstable or serious cardiovascular, renal, hepatic, hematological, oncological, endocrine, psychiatric, or rheumatic diseases"
   }
  ],
