 "brief_summary": "to determine safety, efficacy and tolerability of BI 1356 versus placebo",
 "eligibility": {
  "criteria": "Inclusion criteria:\n\n* Male and female patients with type 2 diabetes and with glomerular filtration rate (GFR) \\<30 ml/min, who are not on chronic dialysis.\n* Insufficient glycemic control (hemoglobin A1c (HbA1c) between 7.0% and 10.0%)\n* Age 18 or over and not older than 80 years\n\nExclusion criteria:\n\n* Treatment with any other anti diabetic drug other than insulin and/or sulphonylurea within 3 months prior to informed consent\n* Myocardial infarction, stroke or transient ischemic attack (TIA) within 6 months prior to informed consent\n* Unstable or acute congestive heart failure",
  "sex": "ALL",
  "minimum_age": "18 Years",
  "maximum_age": "80 Years",
  "healthy_volunteers": false,
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
