 "brief_summary": "The purpose of this clinical research study is to learn whether Saxagliptin added to Metformin therapy is more effective than Metformin alone as a treatment for type 2 diabetic subjects who are not sufficiently controlled with Metformin alone",
 "eligibility": {
  "criteria": "Inclusion Criteria:\n\n* Type 2 diabetes mellitus requiring treatment with at least 1500 mg but not greater than 2550 mg of a maximum tolerated dose of Metformin therapy for at least 8 weeks prior to screening.\n* HbA1c \\>= 7.0% and \\<= 10.0 %\n* Body mass index \\<= 40 kg/m2\n* Fasting C-peptide \\>= 1 ng/dL\n\nExclusion Criteria:\n\n* Symptomatic poorly controlled diabetes\n* Recent cardiac or cerebrovascular event\n* Serum creatinine \\>= 1.5 mg/dL for males and \\>= 1.4 mg/dL for females",
  "sex": "ALL",
  "minimum_age": "18 Years",
  "maximum_age": "77 Years",
  "healthy_volunteers": false,
  "std_ages": [
   "ADULT",
   "OLDER_ADULT"
  ]
 },
