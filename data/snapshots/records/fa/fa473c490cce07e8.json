{"acronym":"ENLIGHTEN-6","arm_groups":[{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide Dose 1","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide Dose 2","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide Dose 3","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide Dose 4","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"The main purpose of this study is to evaluate the efficacy and safety of eloralintide compared with placebo in participants with persistent obesity or overweight, with or without type 2 diabetes, and on stable incretin background therapy.\n\nParticipation in the study will last about 80 weeks.","brief_title":"A Study of Eloralintide (LY3841136) in Participants With Persistent Obesity Who Are Treated With a Weekly Incretin","collaborators":[],"completion_date":{"date":"2028-07","type":"ESTIMATED"},"conditions":["Overweight","Obesity"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Are on stable incretin therapy at screening\n* With persistent obesity or overweight defined as:\n\n  * ≥30 kg/m2 OR\n  * ≥27 kg/m2 with at least one existing obesity related complication at screening:\n\n    * hypertension\n    * dyslipidemia\n    * obstructive sleep apnea\n    * cardiovascular disease (for example, ischemic cardiovascular disease, New York Heart Association Functional Class I-III heart failure), or\n    * type 2 diabetes\n* Have a stable body weight (\\<5% body weight change) at screening\n\nExclusion Criteria:\n\n* Have a prior or planned surgical treatment for obesity (liposuction, cryolipolysis, or abdominoplasty allowed if performed \\>1 year before screening)\n* Have a prior or planned endoscopic procedure and/or device-based therapy for obesity (prior device-based therapy acceptable if device removal was more than 6 months prior to screening)\n* Have type 1 diabetes\n* Have taken any of the following antihyperglycemic medications within 90 days before screening:\n\n  * dipeptidyl peptidase-4 (DPP-4) inhibitors\n  * amylin analogs\n  * insulin\n* Have had within 90 days prior to screening:\n\n  * heart attack\n  * stroke\n  * coronary artery revascularization\n  * unstable angina, or\n  * hospitalization due to congestive heart failure\n* Have a history or diagnosis of New York Heart Association Functional Classification Class IV congestive heart failure","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":900,"type":"ESTIMATED"},"first_posted":"2026-02-06","has_results":false,"interventions":[{"name":"Eloralintide","other_names":["LY3841136"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-11-04","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT07392190","official_title":"A Phase 3 Randomized, Double-Blind, Placebo-Controlled Study to Investigate the Efficacy and Safety of Once Weekly Eloralintide in Adult Participants With Persistent Obesity or Overweight Treated With a Weekly Incretin, With and Without Type 2 Diabetes","overall_status":"RECRUITING","phases":["PHASE3"],"primary_completion_date":{"date":"2028-06","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Percent Change from Baseline in Body Weight","time_frame":"Baseline, Week 64"}],"results_first_posted":null,"sites":[{"city":"Botany","country":"Australia","facility":"Emeritus Research","lat":-33.94599,"lon":151.19591,"state":null,"status":"RECRUITING"},{"city":"Box Hill","country":"Australia","facility":"Box Hill Hospital","lat":-37.81887,"lon":145.12545,"state":null,"status":"RECRUITING"}