{"acronym":"BENEFIT","arm_groups":[{"intervention_names":["Drug: LAF237"],"label":"Vildagliptin","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Protaphane"],"label":"Protaphane","type":"ACTIVE_COMPARATOR"}],"brief_summary":"This study is designed to evaluate safety and efficacy of vildagliptin versus NPH insulin add-on to glimepiride in patients with type 2 diabetes mellitus that do not reach adequate glycemic control on their current sulfonylurea monotherapy to give treating physicians a guidance which additional anti-diabetic treatment can be used if sulfonylurea monotherapy is not sufficient to reach glycemic control.","brief_title":"Safety and Efficacy of Vildagliptin Versus NPH Insulin add-on to Glimepiride in Type 2 Diabetes Mellitus Patients.","collaborators":[],"completion_date":{"date":"2013-10","type":"ACTUAL"},"conditions":["Type 2 Diabetes Mellitus"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Confirmed diagnosis of type 2 diabetes mellitus.\n* Contraindicated or intolerant to take metformin.\n* HbA1c of ≥ 7.0% and ≤ 8.5%\n* Current sulfonylurea (glimepiride) monotherapy and judged by the investigator to be inadequately controlled\n* Other protocol-defined inclusion/exclusion criteria may apply\n\nExclusion Criteria:\n\n* Patients who are taking any other anti-diabetes drug (oral or injection) other than an SU component in the preceding 12 weeks.\n* Acute metabolic conditions such a ketoacidosis, lactic acidosis or hyperosmolar state within the past 6 month\n* Patients taking sulfonylurea for longer than 5 years\n* History of hypersensitivity to any of the study drugs or to drugs with similar chemical structures\n* pregnancy\n* Other protocol-defined inclusion/exclusion criteria may apply","healthy_volunteers":false,"maximum_age":"85 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":162,"type":"ACTUAL"},"first_posted":"2012-07-25","has_results":false,"interventions":[{"name":"LAF237","other_names":[],"type":"DRUG"},{"name":"Protaphane","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2016-11-17","lead_sponsor":{"class":"INDUSTRY","name":"Novartis Pharmaceuticals"},"nct_id":"NCT01649466","official_title":"A Randomized Open-label Study to Compare Safety and Efficacy of Vildagliptin Versus NPH Insulin add-on to Glimepiride in Patients With Type 2 Diabetes Mellitus That do Not Reach Adequate Glycemic Control on Their Current Sulfonylurea Monotherapy.","overall_status":"COMPLETED","phases":["PHASE4"],"primary_completion_date":{"date":"2013-10","type":"ACTUAL"},"primary_outcomes":[{"measure":"Percentage of patients reaching HbA1c below 7.0% without confirmed hypoglycemia and weight gain","time_frame":"24 weeks"},{"measure":"Rate of confirmed hypoglycemic events","time_frame":"24 weeks"}],"results_first_posted":null,"sites":[{"city":"Anderbeck","country":"Germany","facility":"Novartis Investigative Site","lat":51.98183,"lon":10.93356,"state":null,"status":null},{"city":"Augsburg","country":"Germany","facility":"Novartis Investigative Site","lat":48.37154,"lon":10.89851,"state":null,"status":null},{"city":"Bad Kreuznach","country":"Germany","facility":"Novartis Investigative Site","lat":49.8414,"lon":7.86713,"state":null,"status":null},{"city":"Bad Oeynhausen","country":"Germany","facility":"Novartis Investigative Site","lat":52.20699,"lon":8.80365,"state":null,"status":null},{"city":"Balingen","country":"Germany","facility":"Novartis Investigative Site","lat":48.27525,"lon":8.85464,"state":null,"status":null},{"city":"Berlin","country":"Germany","facility":"Novartis Investigative Site","lat":52.52437,"lon":13.41053,"state":null,"status":null},{"city":"Berlin","country":"Germany","facility":"Novartis Investigative Site","lat":52.52437,"lon":13.41053,"state":null,"status":null},{"city":"Berlin","cou