ised participants\n* Active liver disease or clinically significant abnormal hepatic, renal , endocrine, metabolic, or hematological screening tests","healthy_volunteers":false,"maximum_age":"78 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":166,"type":"ACTUAL"},"first_posted":"2009-04-22","has_results":true,"interventions":[{"name":"Saxagliptin plus metformin IR","other_names":["BMS-477118","Onglyza"],"type":"DRUG"},{"name":"Placebo plus metformin IR","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2015-06-01","lead_sponsor":{"class":"INDUSTRY","name":"AstraZeneca"},"nct_id":"NCT00885378","official_title":"A Multicenter, Randomized, Double-Blind, Placebo-Controlled, Parallel-Group, Phase 3 Trial to Evaluate the Efficacy and Safety of 2.5 mg Saxagliptin, Twice Daily, in Combination With Metformin IR in Subjects With Type 2 Diabetes Mellitus Who Have Inadequate Glycemic Control on Metformin IR Alone","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2010-02","type":"ACTUAL"},"primary_outcomes":[{"measure":"Mean Hemoglobin A1C (A1c) and Change From Baseline to Week 12","time_frame":"Baseline, Week 12"}],"results_first_posted":"2011-12-16","sites":[{"city":"Ludwigshafen","country":"Germany","facility":"Local Institution","lat":47.81663,"lon":9.06138,"state":null,"status":null},{"city":"Magdeberg","country":"Germany","facility":"Local Institution","lat":null,"lon":null,"state":null,"status":null},{"city":"Pirna","country":"Germany","facility":"Local Institution","lat":50.95843,"lon":13.93702,"state":null,"status":null},{"city":"Saarbrücken","country":"Germany","facility":"Local Institution","lat":49.23262,"lon":7.00982,"state":null,"status":null},{"city":"Saarlouis","country":"Germany","facility":"Local Institution","lat":49.31366,"lon":6.75154,"state":null,"status":null},{"city":"Tann","country":"Germany","facility":"Local Institution","lat":50.64284