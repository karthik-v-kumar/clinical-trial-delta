{"acronym":"INITIATE","arm_groups":[],"brief_summary":"This trial is conducted in the United States of America (USA). The aim of this trial is to compare biphasic insulin aspart 30 plus metformin in a standard injection regimen to a standard dosing of insulin glargine plus metformin on blood glucose control in subjects with type 2 diabetes who are insulin naive and failing OAD therapy.","brief_title":"Biphasic Insulin Aspart 30 in Type 2 Diabetes Failing OAD Therapy","collaborators":[],"completion_date":{"date":"2004-03","type":"ACTUAL"},"conditions":["Diabetes","Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Insulin naive Type 2 diabetes\n* Currently treated with OADs alone or combined with other treatment for at least 3 months\n* BMI below 40 kg/m2 and body weight below 125 kg\n* HbA1c greater than or equal to 8%\n\nExclusion Criteria:\n\n* Inability to tolerate metformin or contradictions to its use\n* Pregnant, breastfeeding or intention of becoming pregnant\n* Allergy to any of the trial products\n* Inability or unwillingness to perform SMBG","healthy_volunteers":false,"maximum_age":"75 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":242,"type":"ACTUAL"},"first_posted":"2008-01-23","has_results":false,"interventions":[{"name":"biphasic insulin aspart","other_names":[],"type":"DRUG"},{"name":"insulin glargine","other_names":[],"type":"DRUG"},{"name":"metformin","other_names":[],"type":"DRUG"},{"name":"pioglitazone","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2017-01-09","lead_sponsor":{"class":"INDUSTRY","name":"Novo Nordisk A/S"},"nct_id":"NCT00598793","official_title":"Biphasic Insulin Aspart 70/30 + Metformin Compared to Insulin Glargine + Metformin in Type 2 Diabetes Failing OAD Therapy","overall_status":"CO