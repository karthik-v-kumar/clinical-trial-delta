{"acronym":null,"arm_groups":[{"intervention_names":["Drug: Alogliptin"],"label":"Alogliptin 12.5 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Alogliptin"],"label":"Alogliptin 25 mg","type":"EXPERIMENTAL"}],"brief_summary":"The purpose of this study is to evaluate the long-term safety of alogliptin, once daily (QD), following participation in 1 of 7 controlled studies in patients with type 2 diabetes mellitus.","brief_title":"Long-term Safety of Alogliptin in Patients With Type 2 Diabetes Mellitus","collaborators":[],"completion_date":{"date":"2011-11","type":"ACTUAL"},"conditions":["Diabetes Mellitus"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Females of childbearing potential who are sexually active must agree to use adequate contraception, and can neither be pregnant nor lactating from Screening throughout the duration of the study.\n* Type 2 diabetes mellitus and was enrolled in one of the following 7 controlled Phase III studies. The study will be open to all patients who completed one of these studies through the end-of-treatment visit:\n\n  * SYR-322-PLC-010 - NCT00286455\n  * SYR-322-SULF-007 - NCT00286468\n  * SYR-322-MET-008 - NCT00286442\n  * SYR-322-TZD-009 - NCT00286494\n  * SYR-322-INS-011 - NCT00286429\n  * 01-05-TL-322OPI-001 - NCT00328627\n  * 01-06-TL-322OPI-002 - NCT00395512\n* Alanine aminotransferase less than or equal to 3 times the upper limit of normal and serum creatinine less than or equal to 2.0 mg per dL.\n* Able and willing to monitor own blood glucose concentrations with a home glucose monitor.\n* No major illness or debility that in the investigator's opinion prohibits the patient from completing the study.\n\nExclusion Criteria\n\n* The occurrence of any adverse event or condition during the controlled Phase III studies, which, in the opinion of the investigator, should exclude the patient from participating in the open-label extension.\n* Is required to take or intends to continue taking any disallowed medication, any prescription medication, herbal treatment or over-the counter medication that may interfere with evaluation of the study medication, including:\n\n  * Weight-loss drugs\n  * Investigational antidiabetics, additional dipeptidyl peptidase-4 (DPP-4) and glucagon-like peptide-1 (GLP 1) inhibitors\n  * Incretin Mimetics,\n  * Oral or systemically injected glucocorticoids.","healthy_volunteers":false,"maximum_age":"80 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":3323,"type":"ACTUAL"},"first_posted":"2006-03-23","has_results":true,"interventions":[{"name":"Alogliptin","other_names":["SYR110322","SYR-322"],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2013-03-22","lead_sponsor":{"class":"INDUSTRY","name":"Takeda"},"nct_id":"NCT00306384","official_title":"A Long-Term, Open-Label Extension Study to Investigate the Long-Term Safety of SYR110322 (SYR-322) in Subjects With Type 2 Diabetes","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2011-11","type":"ACTUAL"},"primary_outcomes":[{"measure":"Percentage of Participants With Treatment-emergent Adverse Events (TEAEs)","time_frame":"4 years"}],"results_first_posted":"2013-03-22","sites":[{"city":"Buenos Aires","country":"Argentina","facility":null,"lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"Ciudadd Autonoma de Buenos Aires","country":"Argentina","facility":null,"lat":null,"lon":null,"state":null,"status":null},{"city":"Córdoba","country":"Argentina","facility":null,"lat":-31.40648,"lon":-64.18853,"state":null,"status":null},{"city":"Mar del Plata","country":"Argentina","facility":null,"lat":-38.00042,"lon":-57.5562,"state":null,"status":null},{"city":"Buenos Aires","country":"Argentina","facility":null,"lat":-34.61315,"lon":-58.37723,"state":"La Plata","status":