{"acronym":null,"arm_groups":[{"intervention_names":["Drug: Semaglutide J"],"label":"Semaglutide J","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Semaglutide B"],"label":"Semaglutide B","type":"ACTIVE_COMPARATOR"}],"brief_summary":"The study compares two semaglutide medicines and looks at how well they control blood sugar levels, in participants with type 2 diabetes (T2D). Participants will either get the currently available semaglutide or the semaglutide which is produced through a new manufacturing process. Participants need to take one injection of semaglutide once a week, on the same day of every week. Participants will have a total of 11 clinic visits and the study will last for about 35 weeks (approximately 8 months).","brief_title":"A Research Study to Compare Two Semaglutide Medicines in People With Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2023-09-18","type":"ACTUAL"},"conditions":["Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"TRIPLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Diagnosed with type 2 diabetes (T2D) mellitus greater than equal to (≥) 180 days before screening.\n* Stable daily dose(s) ≥ 90 days prior to the day of screening of metformin ≥ 1500 milligrams (mg) or maximum tolerated or effective dose.\n* HbA1c of 7.0-10.5 percentage (%) \\[53-91.3 millimoles per mole (mmol/mol)\\] (both inclusive).\n\nExclusion Criteria:\n\n* Known or suspected hypersensitivity to study intervention(s) or related products.\n* Treatment with any medication for the indication of diabetes or obesity other than stated in the inclusion criteria within 90 days before screening. However, short term insulin treatment for a maximum of 14 days and prior insulin treatment for gestational diabetes are allowed.\n* Uncontrolled and potentially unstable diabetic retinopathy or maculopathy. Verified by a fundus examination performed within 90 days before screening or in the period between screening and randomisation. Pharmacological pupil-dilation is a requirement unless using a digital fundus photography camera specified for nondilated examination.","healthy_volunteers":false,"maximum_age":"64 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT"]},"enrollment":{"count":388,"type":"ACTUAL"},"first_posted":"2022-07-28","has_results":true,"interventions":[{"name":"Semaglutide J","other_names":[],"type":"DRUG"},{"name":"Semaglutide B","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2025-12-12","lead_sponsor":{"class":"INDUSTRY","name":"Novo Nordisk A/S"},"nct_id":"NCT05478252","official_title":"Investigation of Clinical Comparability of Semaglutide Drug Products Based on the Proposed and the Approved Drug Substance Manufacturing Processes in Participants With Type 2 Diabetes","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2023-08-09","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change in Glycosylated Haemoglobin (HbA1c)","time_frame":"From baseline (week 0) to end of treatment (week 28)"}],"results_first_posted":"2024-10-09","sites":[{"city":"Red Deer","country":"Canada","facility":"Care Clinic","lat":52.26682,"lon":-113.802,"state":"Alberta","status":null},{"city":"Surrey","country":"Canada","facility":"Ocean West Research Clinic","lat":49.10635,"lon":-122.82509,"state":"British Columbia","status":null},{"city":"Moncton","country":"Canada","facility":"G.A. Research Associates Ltd.","lat":46.09454,"lon":-64.7965,"state":"New Brunswick","status":null},{"city":"Halifax","country":"Canada","facility":"Nova Scotia Hlth Halifax","lat":44.64269,"lon":-63.57688,"state":"Nova Scotia","status":null},{"city":"New Minas","country":"Canada","facility":"Centricity Research New Minas","lat":45.0691,"lon":-64.46958,"state":"Nova Scotia","status":null},{"city":"Brampton","country":"Canada",