{"acronym":"SUSTAIN 10","arm_groups":[{"intervention_names":["Drug: Semaglutide"],"label":"Semaglutide","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Liraglutide"],"label":"Liraglutide","type":"ACTIVE_COMPARATOR"}],"brief_summary":"This study is conducted in Europe. The aim of the study is to compare the effect of semaglutide subcutaneous (s.c., under the skin) 1.0 mg once-weekly to liraglutide s.c.1.2 mg once-daily on blood sugar levels after 30 weeks of treatment in people with type 2 diabetes. The study will last approximately 9 months (37 weeks). Each participant will have 7 visits at the clinic and 3 phone calls with the study doctor. At the visits, participants will have a number of tests, for example: general health checks, blood samples, heart and eye checks etc. Participants will also fill in some forms about their health and satisfaction with their diabetes treatment.","brief_title":"Research Study Comparing a New Medicine Semaglutide to Liraglutide in People With Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2018-08-13","type":"ACTUAL"},"conditions":["Diabetes","Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria: - Male or female, age 18 years or older at the time of signing informed consent - Diagnosed with type 2 diabetes mellitus - HbA1c of 7.0-11.0 % (53 - 97 mmol/mol) (both inclusive) - Stable daily dose(s) including any of the following anti-diabetic drug(s) or combination regimens 90 days prior to the day of screening: a) Biguanides (metformin above or equal to 1500 mg or maximum tolerated dose documented in the subject's medical record). b) Sulphonylureas (above or equal to half of the maximum approved dose according to local label or maximum tolerated dose as documented in subject medical record). c) SGLT-2 inhibitors (above or equal to half of the maximum approved dose according to local label or maximum tolerated dose as documented in subject medical record) Exclusion Criteria: - Family or personal history of multiple endocrine neoplasia type 2 or medullary thyroid carcinoma. Family is defined as a first degree relative - History or presence of pancreatitis (acute or chronic) - History of diabetic ketoacidosis - Any of the following: myocardial infarction, stroke, hospitalization for unstable angina or transient ischaemic attack within the past 180 days prior to the day of screening - Subjects presently classified as being in New York Heart Association (NYHA) Class IV - Planned coronary, carotid or peripheral artery revascularisation known on the day of screening - Renal impairment measured as estimated Glomerular Filtration Rate (eGFR) value of below 30 ml/min/1.73 sqm as defined by KDIGO 2012 classification - Impaired liver function, defined as ALT above or equal to 2.5 times upper normal limit at screening - Proliferative retinopathy or maculopathy requiring acute treatment. Verified by fundus photography or dilated fundoscopy performed within the past 90 days prior to randomisation","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":577,"type":"ACTUAL"},"first_posted":"2017-06-19","has_results":true,"interventions":[{"name":"Semaglutide","other_names":[],"type":"DRUG"},{"name":"Liraglutide","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2019-10-15","lead_sponsor":{"class":"INDUSTRY","name":"Novo Nordisk A/S"},"nct_id":"NCT03191396","official_title":"Efficacy and Safety of Semaglutide 1.0 mg Once-weekly Versus Liraglutide 1.2 mg Once-daily as add-on to 1-3 Oral Anti-diabetic Drugs (OADs) in Subjects With Type 2 Diabetes","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2018-07-09","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change in HbA1c","time_frame":"Week 0, week 30"}],"results_first_posted":"2019-08-28","sites":[{"city":"Burgas","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":42.50651,"lon":27.46886,"state":null,"status":null},{"city":"Dupnitsa","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":42.26478,"lon":23.11723,"state":null,"status":null},{"city":"Lukovit","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":43.2,"lon":24.16667,"state":null,"status":null},{"city":"Madan","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":41.49869,"lon":24.93973,"state":null,"status":null},{"city":"Petrich","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":41.39365,"lon":23.20012,"state":null,"status":null},{"city":"Rousse","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":43.84872,"lon":25.9534,"state":null,"status":null},{"city":"Sliven","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":42.68607,"lon":26.32558,"state":null,"status":null},{"city":"Sofia","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":42.69751,"lon":23.32415,"state":null,"status":null},{"city":"Vratsa","country":"Bulgaria","facility":"Novo Nordisk Investigational Site","lat":43.21052,"lon":23.56312,"state":null,"status":null},{"city":"Brno","country":"Czechia","facility":"Novo Nordisk Investigational Site","lat":49.19522,"lon":16.60796,"state":null,"status":null},{"city":"Brno","country":"Czechia","facility":"Novo Nordisk Investigational Site","lat":49.19522,"lon":16.60796,"state":null,"status":null},{"city":"Náchod","country":"Czechia","facility":"Novo Nordisk Investigational Site","lat":50.4167,"lon":16.16289,"state":null,"status":null},{"city":"Prague","country":"Czechia","facility":"Novo Nordisk Investigational Site","lat":50.08804,"lon":14.42076,"state":null,"status":null},{"city":"Prague","country":"Czechia","facility":"Novo Nordisk Investigational Site","lat":50.08804,"l