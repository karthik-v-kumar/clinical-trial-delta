{"acronym":"SURMOUNT-4","arm_groups":[{"intervention_names":["Drug: Tirzepatide"],"label":"Tirzepatide (lead-in)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Tirzepatide"],"label":"Tirzepatide MTD","type":"EXPERIMENTAL"},{"intervention_names":["Other: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"This was a study of tirzepatide in participants with obesity or overweight. The main purpose was to learn more about how tirzepatide maintained body weight loss. The study had two phases: a lead-in phase in which all participants took tirzepatide and a treatment phase in which participants either continued tirzepatide or switched to placebo. The study lasted about 2 years (25 visits).","brief_title":"A Study of Tirzepatide (LY3298176) in Participants With Obesity or Overweight for the Maintenance of Weight Loss","collaborators":[],"completion_date":{"date":"2023-05-18","type":"ACTUAL"},"conditions":["Obesity","Overweight"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Body Mass Index (BMI) ≥30 kilograms per square meter (kg/m²), or ≥27 kg/m² and previous diagnosis with at least one of the following comorbidities: hypertension, dyslipidemia, obstructive sleep apnea, cardiovascular disease\n* History of at least one unsuccessful dietary effort to lose body weight\n\nExclusion Criteria:\n\n* Diabetes mellitus\n* Change in body weight greater than 5 kg within 3 months prior to starting study\n* Obesity induced by other endocrinologic disorders or monogenetic or syndromic forms of obesity\n* History of pancreatitis\n* Family or personal history of medullary thyroid carcinoma (MTC) or multiple endocrine neoplasia syndrome type 2 (MEN-2)\n* History of significant active or unstable major depressive disorder (MDD) or other severe psychiatric disorder within the last 2 years\n* Any lifetime history of a suicide attempt","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":783,"type":"ACTUAL"},"first_posted":"2020-12-09","has_results":true,"interventions":[{"name":"Tirzepatide","other_names":["LY3298176"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"OTHER"}],"last_known_status":null,"last_update_posted":"2024-05-22","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT04660643","official_title":"Efficacy and Safety of Tirzepatide Once Weekly Versus Placebo for Maintenance of Weight Loss in Participants Without Type 2 Diabetes Who Have Obesity or Are Overweight With Weight-Related Comorbidities: A Randomized, Double-Blind, Placebo-Controlled Trial (SURMOUNT-4)","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2023-04-25","type":"ACTUAL"},"primary_outcomes":[{"measure":"Percent Change From Randomization in Body Weight at Week 88","time_frame":"Randomization (Week 36), Week 88"}],"results_first_posted":"2024-05-22","sites":[{"city":"Buenos Aires","country":"Argentina","facility":"Asociación de Beneficencia Hospital Sirio Libanés","lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"CABA","country":"Argentina","facility":"CEDIC","lat":null,"lon":null,"state":"Buenos Aires","status":null},{"city":"CABA","country":"Argentina","facility":"Centro Médico Viamonte","lat":null,"lon":null,"state":"Buenos Aires","status":null},{"city":"Ciudad Autónoma de Buenos Aire","country":"Argentina","facility":"Stat Research S.A.","lat":null,"lon":null,"state":"Buenos Aires","status":null},{"city":"Buenos Aires","country":"Argentina","facility":"Mautalen Salud e Investigación","lat":-34.61315,"lon":-58.37723,"state":"Ciudad Autónoma de Buenos Aire","status":null},{"city":"Ciudad Autonoma de Buenos Aire","country":"Argentina","facility":"Centro Medico Dr Laura Maffei Investigacion Clinica Ap