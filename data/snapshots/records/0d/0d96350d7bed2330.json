{"acronym":null,"arm_groups":[{"intervention_names":["Drug: insulin degludec"],"label":"IDeg OD Flexible Dose","type":"EXPERIMENTAL"},{"intervention_names":["Drug: insulin degludec"],"label":"IDeg OD Fixed Dose","type":"EXPERIMENTAL"},{"intervention_names":["Drug: insulin degludec"],"label":"IDeg OD Simple","type":"EXPERIMENTAL"},{"intervention_names":["Drug: insulin degludec"],"label":"IDeg OD Stepwise","type":"EXPERIMENTAL"}],"brief_summary":"This trial is conducted in Asia. The aim of the trial is to investigate the efficacy and safety of flexible versus fixed dosing and simple versus stepwise titration with OD insulin degludec in inadequately treated subjects with type 2 diabetes.","brief_title":"A Trial Investigating the Efficacy and Safety of Flexible vs. Fixed Dosing and Simple vs. Stepwise Titration With Once Daily (OD) Insulin Degludec in Inadequately Treated Subjects With Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2014-04","type":"ACTUAL"},"conditions":["Diabetes","Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Current treatment with IGlar (insulin glargine) with or without OADs (oral antidiabetic drug). All antidiabetic treatments should have been on-going for at least 12 weeks prior to randomisation, and doses of OADs should have been stable in this period of time. - Please note that a maximum of 3 OADs are allowed during this trial: metformin, sulphonylurea (SU)/glinides, dipeptidyl peptidase 4 (DPP-IV) inhibitors, alfa-glucosidaseinhibitors or pioglitazone.\n* Diagnosis of T2DM (type 2 diabetes mellitus) at the discretion of the investigator for at least 26 weeks prior to visit 1 (Screening visit)\n* HbA1c 7.0-9.5% (both inclusive) by central laboratory analysis\n* Body mass index (BMI) equal to or below 35 kg/m\\^2\n\nExclusion Criteria:\n\n* Any chronic disorder or severe disease which, in the opinion of the Investigator might jeopardise subject's safety or compliance with the protocol\n* Stroke; decompensated heart failure New York Heart Association (NYHA) class III or IV; myocardial infarction; unstable angina pectoris; or coronary arterial bypass graft or angioplasty; all within the last 26 weeks prior to Visit 1 (Screening visit)\n* Impaired renal function, defined as serum-creatinine higher than or equal to 1.4 mg/dL for males and higher than or equal to 1.3 mg/dL for females\n* Current or past (within the last 5 years) malignant neoplasms (except basal cell and squamous cell skin carcinoma)\n* Treatment with glucose-lowering agent(s) other than stated in the inclusion criteria in a period of 12 weeks prior to randomisation","healthy_volunteers":false,"maximum_age":null,"minimum_age":"20 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":458,"type":"ACTUAL"},"first_posted":"2013-06-19","has_results":true,"interventions":[{"name":"insulin degludec","other_names":[],"type":"DRUG"},{"name":"insulin degludec","other_names":[],"type":"DRUG"},{"name":"insulin degludec","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2017-02-10","lead_sponsor":{"class":"INDUSTRY","name":"Novo Nordisk A/S"},"nct_id":"NCT01880736","official_title":"A Trial Investigating the Efficacy and Safety of Flexible vs. Fixed Dosing and Simple vs. Stepwise Titration With Once Daily Insulin Degludec in Inadequately Treated Subjects With Type 2 Diabetes","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2014-04","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change From Baseline in HbA1c (%) Glycosylated Haemoglobin)","time_frame":"Week 0, week 26"}],"results_first_posted":"2016-03-17","sites":[{"city":"Chuo-ku, Tokyo","country":"Japan","facility":"Novo Nordisk Investigational Site","lat":null,"lon":null,"state":null,"status":null},{"city":"Chuo-ku, Tokyo","country":"Jap