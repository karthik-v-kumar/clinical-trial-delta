{"acronym":"iINHALE 9","arm_groups":[{"intervention_names":["Drug: inhaled human insulin"],"label":"A","type":"EXPERIMENTAL"},{"intervention_names":["Drug: insulin aspart"],"label":"B","type":"ACTIVE_COMPARATOR"}],"brief_summary":"This trial is conducted in Europe, Asia, Oceania and the United States of America (USA).\n\nThis is a one-year clinical trial to compare the safety of inhaled preprandial human insulin to subcutaneous insulin aspart in subjects with type 1 or 2 diabetes and asthma.","brief_title":"Safety of Inhaled Preprandial Human Insulin in Subjects With Diabetes and Asthma","collaborators":[],"completion_date":{"date":"2008-02-28","type":"ACTUAL"},"conditions":["Diabetes","Diabetes Mellitus, Type 1","Diabetes Mellitus, Type 2","Asthma"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Type 1 or type 2 diabetes\n* Treatment with insulin and/or oral anti-diabetic drugs\n* Asthma for at least 6 months\n* Positive airway reversibility/bronchoprovocation test or documented positive test in the last 3 years\n* HbA1C less than or equal to 11.0 %\n* Body Mass Index (BMI) less than or equal to 40.0 kg/m2\n\nExclusion Criteria:\n\n* Current smoking or smoking within the last 6 months\n* Other current acute or chronic pulmonary disease excluding asthma\n* Recurrent severe hypoglycaemia\n* Proliferative retinopathy or maculopathy","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":10,"type":"ACTUAL"},"first_posted":"2007-08-30","has_results":false,"interventions":[{"name":"insulin aspart","other_names":["NovoRapid®","NovoLog®"],"type":"DRUG"},{"name":"inhaled human insulin","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2018-09-05","lead_sponsor":{"class":"INDUSTRY","name":"Novo Nordisk A/S"},"nct_id":"NCT00523042","official_title":"Inhaled Preprandial Human Insulin With the AERx® iMS Versus Subcutaneous Injected Insulin Aspart in Subjects With Diabetes and Asthma: A 52-week, Open-label, Multinational, Randomised, Parallel Trial to Investigate Long-term Safety","overall_status":"TERMINATED","phases":["PHASE3"],"primary_completion_date":{"date":"2008-02-28","type":"ACTUAL"},"primary_outcomes":[{"measure":"Changes in lung function, chest X-rays, or asthma exacerbation frequency","time_frame":"after 52 weeks of treatment"}],"results_first_posted":null,"sites":[{"city":"Auchenflower","country":"Australia","facility":"Novo Nordisk Investigational Site","lat":-27.47443,"lon":152.99213,"state":null,"status":null},{"city":"Kippa-Ring","country":"Australia","facility":"Novo Nordisk Investigational Site","lat":-27.22586,"lon":153.0835,"state":null,"status":null},{"city":"Broadmeadow","country":"Australia","facility":"Novo Nordisk Investigational Site","lat":-32.92371,"lon":151.72849,"state":"New South Wales","status":null},{"city":"Camperdown","country":"Australia","facility":"Novo Nordisk Investigational Site","lat":-33.88965,"lon":151.17642,"state":"New South Wales","status":null},{"city":"Keswick","country":"Australia","facility":"Novo Nordisk Investigational Site","lat":-34.94178,"lon":138.57459,"state":"South Australia","status":null},{"city":"Box Hill","country":"Australia","facility":"Novo Nordisk Investigational Site","lat":-37.81887,"lon":145.12545,"state":"Victoria","status":null},{"city":"East Ringwood","country":"Australia","facility":"Novo Nordisk Investigational Site","lat":null,"lon":null,"state":"Victoria","status":null},{"city":"Parkville","country":"Australia","facility":"Novo Nordisk Investigational Site","lat":-37.78333,"lon":144.95,"state":"Victoria","status":null},{"city":"Hyderabad","country":"India","facility":"Novo Nordisk Investigational Site","lat":17.38405,"lon":78.45636,"state":null,"status":null},{"city":"Mumbai","country":"India","facility":"Novo Nord