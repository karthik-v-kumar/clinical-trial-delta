{"acronym":null,"arm_groups":[{"intervention_names":["Drug: Cagrisema"],"label":"CagriSema B in device 2 + Placebo in device 1","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Cagrisema"],"label":"CagriSema in device 1 + Placebo in device 2","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo CagriSema"],"label":"Placebo in device 1 + Placebo in device 2","type":"PLACEBO_COMPARATOR"}],"brief_summary":"This study is being done to find out how well a medicine called CagriSema helps people with overweight or obesity lose weight. CagriSema is still being tested in studies and is not yet available for doctors to prescribe. In this study the sponsor will compare two version of CagriSema injected by two different types of injection devices. Which treatment participants get is decided by chance using a computer program, so neither participants nor study staff will know which treatment is given. The study will last for about one year.","brief_title":"A Research Study to Compare Different Versions of Injectable CagriSema and Placebo in People With Excess Body Weight","collaborators":[],"completion_date":{"date":"2028-01-17","type":"ESTIMATED"},"conditions":["Overweight","Obesity"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"QUADRUPLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Male or female (sex at birth)\n* Age 18 years or above at the time of signing the informing consent.\n* Body Mass Index (BMI) is greater than or equal to (\\>= ) 30.0 kilograms per square metre (kg/m\\^2) or BMI \\>= 27.0 kg/m\\^2 with the presence of at least one obesity-related complication including, but not limited to, hypertension, dyslipidaemia, obstructive sleep apnoea or cardiovascular disease.\n\nExclusion Criteria:\n\n* Glycosylated haemoglobin (HbA1c) \\>= 6.5 % (48 millimoles per mole \\[mmol/mol\\]) as measured by the central laboratory at screening.\n* History of type 1 or type 2 diabetes.\n* Previous exposure to CagriSema in a clinical study.","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":0,"type":"ACTUAL"},"first_posted":"2026-01-22","has_results":false,"interventions":[{"name":"Cagrisema","other_names":[],"type":"DRUG"},{"name":"Placebo CagriSema","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-07-09","lead_sponsor":{"class":"INDUSTRY","name":"Novo Nordisk A/S"},"nct_id":"NCT07357766","official_title":"A Placebo-controlled Comparability Study to Compare Two Presentations of CagriSema in Participants With Overweight or Obesity","overall_status":"WITHDRAWN","phases":["PHASE3"],"primary_completion_date":{"date":"2027-11-29","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Relative change in body weight","time_frame":"From baseline (week 0) to end of treatment (week 44)"}],"results_first_posted":null,"sites":[{"city":"Burgas","country":"Bulgaria","facility":"IPSMC - Dr. Nikolay Kostadinov EOOD","lat":42.50651,"lon":27.46886,"state":null,"status":null},{"city":"Dobrich","country":"Bulgaria","facility":"Medical Center Viva Feniks OOD","lat":43.56491,"lon":27.83138,"state":null,"status":null},{"city":"Kyustendil","country":"Bulgaria","facility":"IPSOMC Dr. Miglena Rizova Ltd.","lat":42.28314,"lon":22.69224,"state":null,"status":null},{"city":"Plovdiv","country":"Bulgaria","facility":"DCC Iztok EOOD","lat":42.15387,"lon":24.75001,"state":null,"status":null},{"city":"Plovdiv","country":"Bulgaria","facility":"MHAT Sveta Karidad EAD","lat":42.15387,"lon":24.75001,"state":null,"status":null},{"city":"Plovdiv","country":"Bulgaria","facility":"UMHAT Pulmed OOD - Plovdiv, Department of Endocrinology","lat":42.15387,"lon":24.75001,"state":null,"status":null},{"city":"Plovdiv","country":"Bulgaria","facility":"UMHAT Sveti Georgi EAD, Plovdiv, Clinic of Endocrinology"