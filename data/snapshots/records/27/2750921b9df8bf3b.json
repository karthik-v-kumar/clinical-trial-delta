{"acronym":null,"arm_groups":[],"brief_summary":"This study will examine how to dose Exubera (inhaled insulin) in patients who are not well controlled on two or more diabetes pills. This study should show that a large number of patients enrolled in the study can reach the target Hemoglobin A1C levels (7% or less) that have been set by the American Diabetes Association (ADA). Target goals should be achieved by adjusting the Exubera dose either weekly or twice weekly. Patients will also receive nutritional counseling and diabetes education as part of the study.","brief_title":"US Inhaled Insulin Dose Titration Study","collaborators":["Sanofi"],"completion_date":{"date":"2007-03","type":"ACTUAL"},"conditions":["Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Male and female, age \\>= 18 years and \\<= 80 years, with a diagnosis of type 2 diabetes made at least 6 months prior to study entry, with hemoglobin A1C 7.5-10%\n* Currently treated with 2 or more oral antidiabetic agents (sulfonylureas, metformin, and/or thiazolidinediones)\n\nExclusion Criteria:\n\n* Type 1 diabetes\n* Smoking within the past 6 months or significant pulmonary diseases","healthy_volunteers":false,"maximum_age":"80 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":120,"type":null},"first_posted":"2005-10-31","has_results":false,"interventions":[{"name":"Exubera (inhaled insulin)","other_names":[],"type":"DRUG"},{"name":"8-point glucose diary (to assess pre- and post prandial glucoses)","other_names":[],"type":"PROCEDURE"},{"name":"Meal Tolerance Test","other_names":[],"type":"PROCEDURE"},{"name":"24-hour continuous glucose monitoring (at select sites)","other_names":[],"type":"PROCEDURE"},{"name":"Pulmonary Function Testing","other_names":[],"type":"PROCEDURE"},{"name":"Hypoglycemic Event Monitoring","other_names":[],"type":"PROCEDURE"},{"name":"Laboratory Assessments","other_names":[],"type":"PROCEDURE"},{"name":"Nutritional Counseling and Diabetes Education","other_names":[],"type":"BEHAVIORAL"}],"last_known_status":null,"last_update_posted":"2008-02-08","lead_sponsor":{"class":"INDUSTRY","name":"Pfizer"},"nct_id":"NCT00246623","official_title":"A Randomized, Open-Label, Multicenter Study Assessing the Effects of Forced Exubera Dose Titration on Glycemic Control in Patients With Suboptimally Controlled Type 2 Diabetes on Two or More Oral Antidiabetic Agents","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":null,"primary_outcomes":[{"measure":"Proportion of patients with type 2 diabetes (A1C 7.5-10% on >= 2 oral agents) in each study arm (Exubera dosage adjusted 'once weekly' or 'twice weekly') that attain an A1C of <=7% with forced dose titration of Exubera at 6 months.","time_frame":null}],"results_first_posted":null,"sites":[{"city":"Birmingham","country":"United States","facility":"Pfizer Investigational Site","lat":33.52066,"lon":-86.80249,"state":"Alabama","status":null},{"city":"Los Angeles","country":"United States","facility":"Pfizer Investigational Site","lat":34.05223,"lon":-118.24368,"state":"California","status":null},{"city":"New Britain","country":"United States","facility":"Pfizer Investigational Site","lat":41.66121,"lon":-72.77954,"state":"Connecticut","status":null},{"city":"Norwalk","country":"United States","facility":"Pfizer Investigational Site","lat":41.1176,"lon":-73.4079,"state":"Connecticut","status":null},{"city":"Hollywood","country":"United States","facility":"Pfizer Investigational Site","lat":26.0112,"lon":-80.14949,"state":"Florida","status":null},{"city":"Atlanta","country":"United States","facility":"Pfizer Investigational Site","lat":33.749,"lon":-84.38798,"state":"Georgia","status":null},{"city":"Boise","country":"United States","facility":"Pfizer Investigational Site","lat":43.6135