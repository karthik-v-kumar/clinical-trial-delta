{"acronym":null,"arm_groups":[{"intervention_names":["Drug: NNC0519-0130"],"label":"Dosing scheme A (NNC0519-0130)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Dosing scheme A (Placebo)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: NNC0519-0130"],"label":"Dosing scheme B (NNC0519-0130)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Dosing scheme B (Placebo)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: NNC0519-0130"],"label":"Dosing scheme C (NNC0519-0130)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Dosing scheme C (Placebo)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: NNC0519-0130"],"label":"Dosing scheme D (NNC0519-0130)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Dosing scheme D (Placebo)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: NNC0519-0130"],"label":"Dosing scheme E (NNC0519-0130)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Dosing scheme E (Placebo)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Trizepatide"],"label":"Dosing scheme F (tirzepatide)","type":"ACTIVE_COMPARATOR"}],"brief_summary":"This study will look at how well a new medicine called NNC0519-0130 helps people with type 2 diabetes lower their blood sugar and body weight. The study will test up to 7 different doses of NNC0519-0130. Which treatment participant will get is decided by chance. Participants will take 1-3 injections once a week. The study medicine will be injected under skin with a thin needle in the stomach, thigh, or upper arm. The study will last for about 40 weeks.","brief_title":"A Research Study Comparing How Well Different Doses of the Medicine NN0519-0130 Lower Blood Sugar in People With Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2025-10-13","type":"ACTUAL"},"conditions":["Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"QUADRUPLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Female of non-childbearing potential, or male.\n* For United States (US) only: Female of childbearing potential using highly effective non-systemic methods of contraception with low user-dependency and willingness to continue using it through-out the study or male.\n* Age 18-75 years (both inclusive) at the time of signing the informed consent.\n* Diagnosed with type 2 diabetes mellitus greater than or equal 180 days before screening.\n* Stable daily dose(s) more than or equal 90 days before screening of the following antidiabetic drug(s) or combination regimen(s) at effective or maximum tolerated dose as judged by the investigator: metformin with or without sodium-glucose co-transporter 2 (SGLT2) inhibitor.\n* Glycated haemoglobin (HbA1c) of 7.5-10.0% (58-86 millimoles per moles (mmol/mol)) (both inclusive) as assessed by central laboratory at screening.\n* Body mass index (BMI) greater than or equal 23.0 kilograms per meter square (kg/m\\^2).\n\nExclusion Criteria:\n\n* Treatment with any medication for the indication of diabetes or obesity other than stated in the inclusion criteria within 90 days before screening. However, short term insulin treatment for a maximum of 14 consecutive days and prior insulin treatment for gestational diabetes are allowed.\n* Uncontrolled and potentially unstable diabetic retinopathy or maculopathy. Verified by a fundus examination performed within 90 days before screening or in the period between screening and randomisation. Pharmacological pupil-dilation is a requirement unless using a digital fundus photography camera specified for non-dilated examination.\n* Known hypoglycaemic unawareness as indicated by the investigator according to Clarke's questionnaire question.","healthy_volunteers":false,"maximum_age":"75 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":299,"type":"ACTUAL"},"first_posted":"2024-03-22","has_results":false,"interventions":[{"name":"NNC0519-0130","other_names":[],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"},{"name":"Trizepatide","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-09-21","lead_sponsor":{"class":"INDUSTRY","name":"Novo Nordisk A/S"},"nct_id":"NCT06326047","official_title":"Investigation of the Safety and Efficacy of Once Weekly NNC0519-0130 in Participants With Type 2 Diabetes - a Dose Finding Study","overall_status":"COMPLETED","phases":["PHASE2"],"primary_completion_date":{"date":"2025-09-19","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change in Glycated haemoglobin (HbA1c)","time_frame":"From baseline (week 0) to 12 weeks on a given maintenance dose"}],"results_first_posted":null,"sites":[{"city":"Campbelltown","country":"Australia","facility":"Campbelltown Hospital","lat":-34.06667,"lon":150.81667,"state":"New South Wales","status":null},{"city":"Macquarie Park","country":"Australia","facility":"Macquarie University - Clinical Trials Unit","lat":-33.78105,"lon":151.12757,"state":"New South Wales","status":null},{"city":"St Leonards","country":"Australia","facility":"Royal North Shore Hospital","lat":-33.82344,"lon":151.19836,"state":"New South Wales","status":null},{"city":"Sydney","country":"Australia","facility":"Roger Chih Yu Chen","lat":-33.86785,"lon":151.20732,"state":"New South Wales","status":null},{"city":"Sydney","country":"Australia","facility":"Western Endocrine Blacktown","lat":-33.86785,"lon":151.20732,"state":"New South Wales","status":null},{"city":"Wollongong","country":"Australia","facility":"Illawarra Diabetes Service Clinical Trials & Research Unit","lat":-34.424,"lon":150.89345,"state":"New South Wales","status":null},{"city":"Birtinya","country":"Australia","facility":"University of Sunshine Coast - Vitality Village","l