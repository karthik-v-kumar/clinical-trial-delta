{"acronym":"RESTRAIN-SUI","arm_groups":[{"intervention_names":["Drug: Orforglipron"],"label":"Orforglipron (GZS1)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Placebo (GZS1)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Orforglipron"],"label":"Orforglipron (GZS2)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Placebo (GZS2)","type":"PLACEBO_COMPARATOR"}],"brief_summary":"The GZPS master protocol will support two independent studies, J2A-MC-GZS1 and J2A-MC-GZS2. Each study will see how well and safely orforglipron works in adult female participants with stress urinary incontinence (SUI) who have obesity or overweight. SUI is leaking urine during movement or activity such as coughing or exercising. Participation in the study will last about 58 weeks from screening to safety follow-up.","brief_title":"A Study of Orforglipron in Female Participants With Stress Urinary Incontinence Who Have Obesity or Overweight","collaborators":[],"completion_date":{"date":"2028-03","type":"ESTIMATED"},"conditions":["Urinary Incontinence,Stress"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have a body mass index (BMI) of 27 kilograms per square meter (kg/m2) or higher at screening\n* Have a diagnosis of stress urinary incontinence\n\nExclusion Criteria:\n\n* Have had urinary incontinence surgery\n* Have recently received onabotulinumtoxin A (Botox) bladder injections or currently taking medications for urinary incontinence\n* Have given birth within one year of screening\n* Have had a change in body weight of more than 11 pounds within 90 days prior to screening\n* Have used any anti-obesity medication or alternative weight loss remedies within 180 days prior to screening\n* Have type 1 diabetes, type 2 diabetes, or any other type of diabetes\n* Have had a cardiovascular health condition within 90 days prior to screening\n* Are pregnant, intending to be pregnant, breastfeeding, or intending to breastfeed for the duration of the study","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"FEMALE","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":1000,"type":"ESTIMATED"},"first_posted":"2025-10-02","has_results":false,"interventions":[{"name":"Orforglipron","other_names":["LY3502970"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-11-04","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT07202884","official_title":"A Master Protocol to Investigate the Efficacy and Safety of Orforglipron Tablet Once Daily Compared With Placebo in Female Participants With Stress Urinary Incontinence Who Have Obesity or Overweight","overall_status":"RECRUITING","phases":["PHASE3"],"primary_completion_date":{"date":"2028-03","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Change from Baseline in Incontinence Episode Frequency (IEF)","time_frame":"Baseline, Week 52"}],"results_first_posted":null,"sites":[{"city":"Kelowna","country":"Canada","facility":"Kelowna Health and Memory Centre","lat":49.88307,"lon":-119.48568,"state":null,"status":"RECRUITING"},{"city":"Kelowna","country":"Canada","facility":"OCT Research ULC","lat":49.88307,"lon":-119.48568,"state":null,"status":"RECRUITING"},{"city":"Lévis","country":"Canada","facility":"Alpha Recherche Clinique - Lévis","lat":46.80326,"lon":-71.17793,"state":null,"status":"RECRUITING"},{"city":"Oakville","country":"Canada","facility":"The Fe/Male Health Centre","lat":43.45011,"lon":-79.68292,"state":null,"status":"RECRUITING"},{"city":"Québec","country":"Canada","facility":"Alpha Recherche Clinique","lat":46.81228,"lon":-71.21454,"state":null,"status":"RECRUITING"},{"city":"Québec","country":"Canada","facility":"ALPHA Recherche Clinique","lat":46.81228,"lon":-