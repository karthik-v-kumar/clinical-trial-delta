{"acronym":null,"arm_groups":[{"intervention_names":["Drug: NNC0174-0833"],"label":"NNC0174-0833, 4.5 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: NNC0174-0833"],"label":"NNC0174-0833, 2.4 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: NNC0174-0833"],"label":"NNC0174-0833, 1.2 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: NNC0174-0833"],"label":"NNC0174-0833, 0.6 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: NNC0174-0833"],"label":"NNC0174-0833 0.3 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo (NNC0174-0833)"],"label":"Placebo 2.4 mg (NNC0174-0833)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Placebo (NNC0174-0833)"],"label":"Placebo 4.5 mg (NNC0174-0833)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Placebo (NNC0174-0833)"],"label":"Placebo 1.2 mg (NNC0174-0833)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Placebo (NNC0174-0833)"],"label":"Placebo 0.6 mg (NNC0174-0833)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Placebo (NNC0174-0833)"],"label":"Placebo 0.3 mg (NNC0174-0833)","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Liraglutide 3.0 mg"],"label":"Liraglutide 3.0 mg","type":"ACTIVE_COMPARATOR"},{"intervention_names":["Drug: Placebo (Liraglutide 3.0 mg)"],"label":"Placebo 3.0 mg (Liraglutide)","type":"PLACEBO_COMPARATOR"}],"brief_summary":"This study will look at the change in body weight in people taking NNC0174-0833, liraglutide and \"dummy\" medicine, from the start to the end of the study. As well as taking the medicine, participants will have talks with study staff about healthy food choices, how to be more physically active and what participants can do to lose weight. Participants will either take NNC0174-0833, liraglutide or \"dummy\" medicine - which treatment participants get is decided by chance. Participants will need to take one injection once a week or once a day, depending on the treatment. The study medicine is injected with a thin needle in a skin fold in the stomach, thigh or upper arm. The study will last for about 8 months. Participants will have 12 clinic visits with the study doctor.","brief_title":"Research Study Investigating How Well NNC0174-0833 Works in People Suffering From Overweight or Obesity.","collaborators":[],"completion_date":{"date":"2021-03-25","type":"ACTUAL"},"conditions":["Overweight","Obesity"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"QUADRUPLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* 18 years or older at the time of signing the informed consent.\n* Female subject of non-childbearing potential or Male subject who is surgically sterilised (vasectomy) or who is willing to use adequate contraceptive methods (as required by local regulation or practice) throughout the trial (until 'end of trial').\n* BMI equal to 30.0 kg/m\\^2 or greater or BMI equal to 27.0 kg/m\\^2 or greater with the presence of at least one of the following weight-related comorbidities (treated or untreated): hypertension or dyslipidaemia (to be assessed at the investigator's discretion).\n\nExclusion Criteria:\n\n* HbA1c equal to 48 mmol/mol (6.5 percentage) or greater as measured by the central laboratory at screening.\n* A self-reported change in body weight greater than 5 kg (11 lbs) within 90 days prior to screening irrespective of medical records.","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":706,"type":"ACTUAL"},"first_posted":"2019-02-27","has_results":true,"interventions":[{"name":"NNC0174-0833","other_names":[],"type":"DRUG"},{"name":"Placebo (NNC0174-0833)","other_names":[],"type":"DRUG"},{"name":"Liraglutide 3.0 mg","other_names":[],"type":"DRUG"},{"name":"Placebo (Liraglutide 3.0 mg)","other_names":[],"type":"DRUG"}],"