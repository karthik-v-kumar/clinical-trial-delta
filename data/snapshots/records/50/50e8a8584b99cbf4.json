{"acronym":"ATTAIN-2","arm_groups":[{"intervention_names":["Drug: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Orforglipron"],"label":"6 mg Orforglipron QD","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Orforglipron"],"label":"12 mg Orforglipron QD","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Orforglipron"],"label":"36 mg Orforglipron QD","type":"EXPERIMENTAL"}],"brief_summary":"This study will investigate the safety and efficacy of once daily oral treatment with orforglipron compared with placebo on body weight in adult participants with obesity or overweight and type 2 diabetes. The study will last about 77 weeks and may include up to 22 visits.","brief_title":"A Study of Orforglipron in Adult Participants With Obesity or Overweight and Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2025-08-08","type":"ACTUAL"},"conditions":["Obesity","Overweight","Type 2 Diabetes"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have a body mass index (BMI) ≥27.0 kilogram/square meter (kg/m²).\n* Have a history of at least 1 self-reported unsuccessful dietary effort to lose body weight.\n* Have a diagnosis of Type 2 Diabetes (T2D), with HbA1c ≥7% (≥53 mmol/mol) to ≤10% (86 mmol/mol) and are on stable treatment for T2D for at least 90 days prior to screening, consisting of:\n\n  * either diet/exercise alone or\n  * up to 3 oral antihyperglycemic medications (excluding dipeptidyl peptidase IV inhibitors (DPP-4i) or glucagon-like peptide-1 (GLP-1) receptor agonists (RA).\n\nExclusion Criteria:\n\n* Have Type 1 Diabetes (T1D), history of ketoacidosis or hyperosmolar state/coma, or any other types of diabetes except T2D.\n* Have a self-reported change in body weight \\>5 kg (11 pounds) within 90 days prior to screening.\n* Are currently receiving or planning to receive treatment for diabetic retinopathy and/or macular edema (for example, laser photocoagulation or intravitreal injections of anti-vascular endothelial growth factor inhibitors).\n* Have family (first-degree relative) or personal history of medullary thyroid cancer (MTC) or multiple endocrine neoplasia 2 (MEN2) syndrome.\n* Have had a history of chronic or acute pancreatitis.","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":1613,"type":"ACTUAL"},"first_posted":"2023-05-24","has_results":true,"interventions":[{"name":"Orforglipron","other_names":["LY3502970"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-09-04","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT05872620","official_title":"A Phase 3, Randomized, Double-Blind Study to Investigate the Efficacy and Safety of Once-Daily Oral LY3502970 Compared With Placebo in Adult Participants With Obesity or Overweight and Type 2 Diabetes (ATTAIN-2)","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2025-08-08","type":"ACTUAL"},"primary_outcomes":[{"measure":"Percent Change From Baseline in Body Weight","time_frame":"Baseline, Week 72"}],"results_first_posted":"2026-09-04","sites":[{"city":"Buenos Aires","country":"Argentina","facility":"CONEXA Investigacion Clinica S.A.","lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"Córdoba","country":"Argentina","facility":"Centro Diabetológico Dr. Waitman","lat":-31.40648,"lon":-64.18853,"state":null,"status":null},{"city":"Córdoba","country":"Argentina","facility":"Clínica Universitaria Reina Fabiola","lat":-31.40648,"lon":-64.18853,"state":null,"status":null},{"city":"Santa Fe","country":"Argentina","facility":"Centro de Diagnóstico y Rehabilitación (CEDIR)","lat":-31.64881,"lon":-60.70868,"state":null,"status":null},