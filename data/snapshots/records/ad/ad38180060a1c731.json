{"acronym":"AMPLIFY-2","arm_groups":[{"intervention_names":["Drug: eloralintide and tirzepatide"],"label":"EloraTZP","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Tirzepatide"],"label":"Tirzepatide","type":"EXPERIMENTAL"}],"brief_summary":"The purpose of this study is to investigate the efficacy and safety of eloralintide and tirzepatide coformulation (EloraTZP) compared to tirzepatide for body weight reduction in participants with obesity or overweight and type 2 diabetes.\n\nParticipation in the study will last about 2 years.","brief_title":"A Study of EloraTZP in Adult Participants With Obesity or Overweight and Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2029-11","type":"ESTIMATED"},"conditions":["Obesity","Overweight","Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have type 2 diabetes\n* Have a stable self-reported body weight (\\<5% body weight change) for 90 days prior to screening\n* Have a BMI of ≥27 kg/m2 at screening\n* Have a history of at least 1 self-reported unsuccessful dietary effort to reduce body weight\n\nExclusion Criteria:\n\n* Have a prior or planned surgical treatment for obesity (liposuction, cryolipolysis, or abdominoplasty allowed if performed \\>1 year before screening)\n* Have a prior or planned endoscopic procedure and/or device-based therapy for obesity and/or type 2 diabetes (prior device-based therapy acceptable if device removal was more than 6 months prior to screening)\n* Have type 1 diabetes\n* Have taken any of the following within 90 days prior to screening\n\n  * medications with direct amylin, glucagon-like peptide-1 (GLP-1) or glucagon-dependent insulinotropic polypeptide (GIP) receptor activity, including compounded therapies\n  * dipeptidyl peptidase 4 (DPP-4) inhibitors, and\n  * insulin\n* Have had within 90 days prior to screening:\n\n  * heart attack\n  * stroke\n  * coronary artery revascularization\n  * unstable angina, or\n  * hospitalization due to congestive heart failure\n* Have a history or diagnosis of New York Heart Association Functional Classification Class IV congestive heart failure\n* Have taken medications or alternative remedies intended for weight loss within 90 days of screening","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":1000,"type":"ESTIMATED"},"first_posted":"2026-10-19","has_results":false,"interventions":[{"name":"eloralintide and tirzepatide","other_names":["LY900043"],"type":"DRUG"},{"name":"Tirzepatide","other_names":["LY3298176"],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-11-04","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT07881458","official_title":"A Phase 3 Study to Investigate the Efficacy and Safety of LY900043 in Adult Participants With Obesity or Overweight and Type 2 Diabetes","overall_status":"RECRUITING","phases":["PHASE3"],"primary_completion_date":{"date":"2029-10","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Percent Change from Baseline in Body Weight","time_frame":"Baseline, Week 100"}],"results_first_posted":null,"sites":[{"city":"Campinas","country":"Brazil","facility":"Centro de Pesquisa Sao Lucas","lat":-22.90556,"lon":-47.06083,"state":null,"status":"NOT_YET_RECRUITING"},{"city":"Curitiba","country":"Brazil","facility":"Cline Research Center","lat":-25.42778,"lon":-49.27306,"state":null,"status":"NOT_YET_RECRUITING"},{"city":"Porto Alegre","country":"Brazil","facility":"Núcleo de Pesquisa Clínica do Rio Grande do Sul","lat":-30.03283,"lon":-51.23019,"state":null,"status":"NOT_YET_RECRUITING"},{"city":"Rio de Janeiro","country":"Brazil","facility":"IBPClin - Instituto Brasil de Pesquisa Clínica","lat":-22.90642,"lon":-43.18223,"state":null,"status":"NOT_YE