{"acronym":"Insuman-C25-CN","arm_groups":[{"intervention_names":["Drug: Insulin human/Insuman Comb 25 (HR1799)"],"label":"Insuman Comb 25","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Insulin human/Novolin® 30R"],"label":"Novolin® 30R","type":"ACTIVE_COMPARATOR"}],"brief_summary":"Primary Objective:\n\nTo compare the efficacy of Insuman Comb 25 versus Novolin® 30R on HbA1c reduction during a 24-week treatment period in patients with type 2 diabetes mellitus.\n\nSecondary Objectives:\n\n* To assess the effects of Insuman Comb 25 versus Novolin® 30R in patients with type 2 diabetes mellitus on fasting plasma glucose (FPG)\n* To assess the safety and tolerability of Insuman Comb 25 versus Novolin® 30R in patients with type 2 diabetes mellitus","brief_title":"Assessment of Efficacy and Safety of Insuman Comb 25 Versus Novolin® 30R Twice Daily Over 24 Weeks in Type 2 Diabetes Patients With Insulin Therapy","collaborators":[],"completion_date":{"date":"2012-11","type":"ACTUAL"},"conditions":["Type 2 Diabetes Mellitus"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion criteria:\n\n* Type 2 diabetes mellitus patients, as defined by World Health Organization (WHO), diagnosed for at least 1 year at the time of screening visit who are under premix insulin therapy, with or without oral anti-diabetic drug (OAD)\n* Signed written informed consent\n\nExclusion criteria:\n\n* HbA1c \\<7% or HbA1c \\>10% at screening\n* No self-monitoring of blood glucose within 3 months prior to screening visit\n* Premix insulin treatment for less than 3 months. Insulins other than premix insulin treatment within 3 months prior to screening visit\n* In case of treatment with OAD, treatment with a stable OAD dose and regimen for less than 3 months prior to screening visit\n\nThe above information is not intended to contain all considerations relevant to a patient's potential participation in a clinical trial.","healthy_volunteers":false,"maximum_age":"75 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":485,"type":"ACTUAL"},"first_posted":"2011-05-13","has_results":false,"interventions":[{"name":"Insulin human/Insuman Comb 25 (HR1799)","other_names":[],"type":"DRUG"},{"name":"Insulin human/Novolin® 30R","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2013-02-27","lead_sponsor":{"class":"INDUSTRY","name":"Sanofi"},"nct_id":"NCT01353469","official_title":"A Multicenter, Randomized, Active-controlled, Parallel-group Study to Assess the Efficacy and Safety of Insuman Comb 25 (Insulin Human) Versus Novolin® 30R Twice Daily Over 24 Weeks in Patients With Type 2 Diabetes Mellitus Who Are Under Insulin Therapy","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2012-11","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change in HbA1c from baseline to the end of treatment","time_frame":"24 weeks"}],"results_first_posted":null,"sites":[{"city":"Beijing","country":"China","facility":"Investigational Site Number 156001","lat":39.9075,"lon":116.39723,"state":null,"status":null},{"city":"Beijing","country":"China","facility":"Investigational Site Number 156010","lat":39.9075,"lon":116.39723,"state":null,"status":null},{"city":"Beijing","country":"China","facility":"Investigational Site Number 156024","lat":39.9075,"lon":116.39723,"state":null,"status":null},{"city":"Changchun","country":"China","facility":"Investigational Site Number 156017","lat":43.88,"lon":125.32278,"state":null,"status":null},{"city":"Changchun","country":"China","facility":"Investigational Site Number 156033","lat":43.88,"lon":125.32278,"state":null,"status":null},{"city":"Changsha","country":"China","facility":"Investigational Site Number 156005","lat":28.19874,"lon":112.97087,"state":null,"status":null},{"city":"Chengdu","country":"China","facility":"Investiga