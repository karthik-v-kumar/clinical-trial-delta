{"acronym":"COORDINATE","arm_groups":[{"intervention_names":[],"label":"Control","type":"NO_INTERVENTION"},{"intervention_names":["Other: Intense Education Intervention"],"label":"Intervention","type":"ACTIVE_COMPARATOR"}],"brief_summary":"COORDINATE-Diabetes is a cluster-randomized clinical trial to test the effectiveness of an innovative, clinic-level educational intervention to improve the management of patients with type 2 diabetes mellitus and cardiovascular disease.","brief_title":"A 12 Month Site Randomized Trial in Adults With Type 2 Diabetes Mellitus and History of Cardiovascular Disease","collaborators":["Boehringer Ingelheim","Eli Lilly and Company"],"completion_date":{"date":"2022-12-30","type":"ACTUAL"},"conditions":["Diabetes Mellitus, Type 2","Cardiovascular Diseases"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"HEALTH_SERVICES_RESEARCH","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Age ≥ 18 years old\n* Diagnosis of Type 2 diabetes mellitus (T2DM)\n* History of at least one of the following conditions:\n\n  1. Coronary artery disease (defined as prior MI, coronary revascularization (CABG or PCI), and/or obstructive CAD (≥50%) as documented by angiography or CTA)\n  2. Stroke and/or carotid artery stenosis (≥50%)\n  3. Peripheral Arterial disease (defined as claudication with ABI\\<0.9, prior peripheral revascularization, and/or amputation due to circulatory insufficiency)\n* Ability to communicate with site staff and understand and provide written informed consent and proof of Health Insurance Portability and Accountability Act (HIPAA) authorization\n\nExclusion Criteria:\n\n* Determined to be highly unlikely to survive and/or to continue follow-up in that clinic for at least 1 year, as identified by site investigator\n* GFR\\<30 mL/min/1.73m2\n* Already on all guideline-recommended therapies for T2DM and CVD\n* Absolute contraindication to any of the guideline recommended therapies for T2DM and CVD","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":1049,"type":"ACTUAL"},"first_posted":"2019-05-03","has_results":true,"interventions":[{"name":"Intense Education Intervention","other_names":["Intervention"],"type":"OTHER"}],"last_known_status":null,"last_update_posted":"2024-11-21","lead_sponsor":{"class":"OTHER","name":"Duke University"},"nct_id":"NCT03936660","official_title":"COOrdinating CaRDIology CliNics RAndomized Trial of Interventions to Improve OutcomEs (COORDINATE) - Diabetes","overall_status":"COMPLETED","phases":["NA"],"primary_completion_date":{"date":"2022-12-30","type":"ACTUAL"},"primary_outcomes":[{"measure":"Number of Participants Prescribed All 3 Groups of Recommended Evidence-based Medications","time_frame":"Up to 12 Months"}],"results_first_posted":"2024-11-21","sites":[{"city":"Birmingham","country":"United States","facility":"Grandview Health/Alabama Cardiovascular Group","lat":33.52066,"lon":-86.80249,"state":"Alabama","status":null},{"city":"Mobile","country":"United States","facility":"USA Cardiology","lat":30.69436,"lon":-88.04305,"state":"Alabama","status":null},{"city":"Anchorage","country":"United States","facility":"Alaska Heart and Vascular Institute","lat":61.21806,"lon":-149.90028,"state":"Alaska","status":null},{"city":"Phoenix","country":"United States","facility":"Dignity Health/DHMG Specialty Medicine","lat":33.44838,"lon":-112.07404,"state":"Arizona","status":null},{"city":"Stanford","country":"United States","facility":"Stanford University","lat":37.42411,"lon":-122.16608,"state":"California","status":null},{"city":"Vista","country":"United States","facility":"Blue Coast Cardiology","lat":33.20004,"lon":-117.24254,"state":"California","status":null},{"city":"Denver","country":"United States","facility":"Aurora Denver Cardiology","lat":39.73915,"lon":-104.9847,"state":"Colorado","status":null},{"city":"Br