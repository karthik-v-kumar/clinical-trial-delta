{"acronym":"TRIUMPH-8","arm_groups":[{"intervention_names":["Drug: Retatrutide"],"label":"Retatrutide Dose 1","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Retatrutide"],"label":"Retatrutide Dose 2","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"The purpose of this study is to evaluate the efficacy and safety of retatrutide compared with placebo for body weight reduction.\n\nParticipation in the study will last about 65 weeks and may include about 18 visits.","brief_title":"A Study of Retatrutide (LY3437943) in Participants With Obesity or Overweight","collaborators":[],"completion_date":{"date":"2027-07","type":"ESTIMATED"},"conditions":["Obesity","Overweight"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have a body mass index (BMI) of:\n\n  * ≥30 kilogram per square meter (kg/m2) OR\n  * ≥27 kg/m2 with at least one of the following weight-related conditions: high blood pressure, abnormal levels of lipid, obstructive sleep apnea, heart disease\n* Have at least one unsuccessful attempt to lose weight by dieting\n\nExclusion Criteria:\n\n* Have a self-reported change in body weight \\>5 kg (11 pounds) within 90 days before screening\n* Have a prior or planned surgical treatment for obesity\n* Have type 1 diabetes or type 2 diabetes\n* Have a family or personal history of medullary thyroid carcinoma (MTC) or multiple endocrine neoplasia syndrome type 2 (MEN-2)\n* Have had within the past 90 days before screening\n\n  * acute myocardial infarction\n  * cerebrovascular accident (stroke)\n  * hospitalization for unstable angina, or\n  * hospitalization due to congestive heart failure\n* Have New York Heart Association Functional Classification Class IV congestive heart failure\n* Have a history of chronic or acute pancreatitis\n* Have taken weight loss drugs, including over-the counter medications within 90 days prior to screening","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":250,"type":"ESTIMATED"},"first_posted":"2025-11-18","has_results":false,"interventions":[{"name":"Retatrutide","other_names":["LY3437943"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-04-17","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT07232719","official_title":"A Phase 3b Study to Investigate the Efficacy and Safety of Retatrutide Once Weekly in Participants Without Type 2 Diabetes Who Have Obesity or Overweight: A Randomized, Double-Blind, Placebo-Controlled Trial","overall_status":"ACTIVE_NOT_RECRUITING","phases":["PHASE3"],"primary_completion_date":{"date":"2027-07","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Percent Change from Baseline in Body Weight","time_frame":"Baseline, Week 56"}],"results_first_posted":null,"sites":[{"city":"Birmingham","country":"United Kingdom","facility":"FutureMeds - Birmingham","lat":52.48142,"lon":-1.89983,"state":null,"status":null},{"city":"Blackpool","country":"United Kingdom","facility":"Layton Medical Centre","lat":53.81667,"lon":-3.05,"state":null,"status":null},{"city":"Bradford on Avon","country":"United Kingdom","facility":"Bradford on Avon Health Centre","lat":51.34772,"lon":-2.25065,"state":null,"status":null},{"city":"Bromborough","country":"United Kingdom","facility":"FutureMeds - Liverpool","lat":53.3485,"lon":-2.97935,"state":null,"status":null},{"city":"Cheadle","country":"United Kingdom","facility":"Cheadle Community Hospital","lat":52.98333,"lon":-1.98333,"state":null,"status":null},{"city":"Hounslow","country":"United Kingdom","facility":"HMC Health Group - Meadows Centre for Health","lat":51.46839,"lon":-0.36092,"state":null,"status":null},{"ci