{"acronym":"ENLIGHTEN-2","arm_groups":[{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide Dose 1","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide Dose 2","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide Dose 3","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide Dose 4","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"The main purpose of this study is to evaluate the efficacy and safety of eloralintide compared with placebo for body weight reduction in participants with overweight or obesity and type 2 diabetes. Participation in the study will last about 75 weeks.","brief_title":"A Study of Eloralintide (LY3841136) in Participants With Obesity or Overweight, and Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2028-02","type":"ESTIMATED"},"conditions":["Overweight","Obesity"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have type 2 diabetes\n* Are on stable treatment for type 2 diabetes for at least 90 days prior to screening\n* Have a BMI ≥ 27 kg/m2\n* Have a stable body weight (\\<5% body weight change) for 90 days prior to screening\n\nExclusion Criteria:\n\n* Have a prior or planned surgical treatment for obesity (liposuction, cryolipolysis, or abdominoplasty allowed if performed \\>1 year before screening)\n* Have a prior or planned endoscopic procedure and/or device-based therapy for obesity (prior device-based therapy acceptable if device removal was more than 6 months prior to screening)\n* Have type 1 diabetes\n* Have taken any of the following antihyperglycemic medications within 90 days before screening:\n\n  * amylin analogs\n  * glucagon-like peptide-1 (GLP-1) receptor agonists\n  * glucose-dependent insulinotropic polypeptide/glucagon-like peptide-1 (GIP/GLP) receptor agonists, or\n  * insulin\n* Have had within 90 days prior to screening:\n\n  * heart attack\n  * stroke\n  * coronary artery revascularization\n  * unstable angina, or\n  * hospitalization due to congestive heart failure\n* Have a history or diagnosis of New York Heart Association Functional Classification Class IV congestive heart failure\n* Have taken medications or alternative remedies intended for weight loss within 90 days of screening","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":1035,"type":"ESTIMATED"},"first_posted":"2025-12-15","has_results":false,"interventions":[{"name":"Eloralintide","other_names":["LY3841136"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-11-04","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT07282600","official_title":"A Phase 3 Randomized, Double-Blind, Placebo-Controlled Study to Investigate the Efficacy and Safety of Once Weekly Eloralintide in Adult Participants With Obesity or Overweight, and Type 2 Diabetes","overall_status":"RECRUITING","phases":["PHASE3"],"primary_completion_date":{"date":"2028-01","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Percent Change from Baseline in Body Weight","time_frame":"Baseline, Week 64"}],"results_first_posted":null,"sites":[{"city":"Beijing","country":"China","facility":"Beijing Pinggu District Hospital","lat":39.9075,"lon":116.39723,"state":null,"status":"RECRUITING"},{"city":"Beijing","country":"China","facility":"Luhe Hospital","lat":39.9075,"lon":116.39723,"state":null,"status":"RECRUITING"},{"city":"Beijing","country":"China","facility":"Peking University People's Hospital","lat":39.9075,"lon":116.39723,"state":null,"status":"RECRUITING"},{"city":"Chengdu","country":"China","f