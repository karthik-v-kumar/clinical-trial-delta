{"acronym":null,"arm_groups":[{"intervention_names":["Drug: Canagliflozin"],"label":"Canagliflozin 100 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Canagliflozin"],"label":"Canagliflozin 300 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"The purpose of this study is to evaluate the effect of canagliflozin (JNJ-28431754) on blood pressure reduction, compared to placebo, in patients with hypertension and type 2 diabetes mellitus and who are on stable doses of anti-hyperglycemic and anti-hypertensive agents. Overall safety and tolerability of canagliflozin will be assessed.","brief_title":"Evaluation of Blood Pressure Reduction, Safety, and Tolerability of Canagliflozin in Patients With Hypertension and Type 2 Diabetes Mellitus on Stable Doses of Anti-hyperglycemic and Anti-hypertensive Agents","collaborators":[],"completion_date":{"date":"2015-04","type":"ACTUAL"},"conditions":["Diabetes Mellitus, Type 2","Hypertension"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"QUADRUPLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* patients with a diagnosis of type 2 diabetes mellitus\n* patients with hypertension (seated office SBP of \\>=130 mmHg and \\<160 mmHg and seated office DBP of \\>= 70 mmHg at screening and at Week -2\n* patients on stable doses of 1 to 3 anti-hypertensive agents for at least 5 weeks before screening\n* patients on stable doses of 1 to 3 oral anti-hyperglycemic agents which must include metformin, for at least 8 weeks before screening\n\nExclusion Criteria:\n\n* a history of diabetic ketoacidosis\n* type 1 diabetes mellitus (T1DM)\n* pancreas or beta-cell transplantation\n* fasting C-peptide \\<0.70 ng/mL (0.23 nmol/L)\n* body mass index \\<30 kg/m2\n* has ongoing, inadequately controlled thyroid disorder\n* has a history of cardio-renal disease that required treatment with immunosuppressive therapy.","healthy_volunteers":false,"maximum_age":"75 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":171,"type":"ACTUAL"},"first_posted":"2013-09-11","has_results":true,"interventions":[{"name":"Canagliflozin","other_names":[],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2017-03-03","lead_sponsor":{"class":"INDUSTRY","name":"Janssen Scientific Affairs, LLC"},"nct_id":"NCT01939496","official_title":"A Randomized, Double-Blind, Placebo-Controlled, Parallel-Group, Multicenter Study to Evaluate the Blood Pressure Reduction With Ambulatory Blood Pressure Monitoring (ABPM), Safety, and Tolerability of Canagliflozin in the Treatment of Subjects With Hypertension and Type 2 Diabetes Mellitus","overall_status":"COMPLETED","phases":["PHASE4"],"primary_completion_date":{"date":"2015-04","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change From Baseline in the Mean 24-Hour Systolic Blood Pressure (SBP) to Week 6","time_frame":"Baseline and Week 6"}],"results_first_posted":"2016-04-06","sites":[{"city":"Carolina","country":"Puerto Rico","facility":null,"lat":18.38078,"lon":-65.95739,"state":null,"status":null},{"city":"Ponce Pr","country":"Puerto Rico","facility":null,"lat":null,"lon":null,"state":null,"status":null},{"city":"Trujillo Alto","country":"Puerto Rico","facility":null,"lat":18.35467,"lon":-66.00739,"state":null,"status":null},{"city":"Birmingham","country":"United States","facility":null,"lat":33.52066,"lon":-86.80249,"state":"Alabama","status":null},{"city":"Gulf Shores","country":"United States","facility":null,"lat":30.24604,"lon":-87.70082,"state":"Alabama","status":null},{"city":"Avondale","country":"United States","facility":null,"lat":33.4356,"lon":-112.3496,"state":"Arizona","status":null},{"city":"Phoenix","country":"United States","facility":null,"