{"acronym":null,"arm_groups":[{"intervention_names":["Drug: Canakinumab 150 mg"],"label":"Canakinumab 150 mg + Metformin","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo to Canakinumab"],"label":"Placebo + Metformin","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Canakinumab 150 mg"],"label":"Canakinumab 150 mg + Metforimin + Sulfonylurea","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo to Canakinumab"],"label":"Placebo + Metforimin + Sulfonylurea","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Canakinumab 150 mg"],"label":"Canakinumab 150 mg + Met + Sulfonyl + Thiazolidinedione","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo to Canakinumab"],"label":"Placebo + Met + Sulfonyl + Thiazolidinedione","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Canakinumab 150 mg"],"label":"Canakinumab 150 mg + Insulin","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo to Canakinumab"],"label":"Placebo + Insulin","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Canakinumab 150 mg"],"label":"Canakinumab 150 mg in patients with IGT","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo to Canakinumab"],"label":"Placebo in patients with IGT","type":"PLACEBO_COMPARATOR"}],"brief_summary":"This was a 10-week, placebo-controlled, randomized study to investigate the effect of injectable IL-1B antagonist, Canakinumab , in participants with impaired glucose tolerance or Type 2 Diabetes Mellitus (T2DM) already treated on different background diabetes therapies.","brief_title":"To Compare the Effect of a Subcutaneous Canakinumab Administration to Placebo in Patients With Impaired Glucose Tolerance or Patients With Type 2 Diabetes With Differing Baseline Diabetes Therapies","collaborators":[],"completion_date":{"date":"2010-08","type":"ACTUAL"},"conditions":["Type 2 Diabetes Mellitus","Impaired Glucose Tolerance"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"QUADRUPLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n1. Patient must fulfill all criteria in one of the following groups:\n\n   * Impaired Glucose Tolerance (IGT) as diagnosed per protocol and not on an anti-diabetic medicine during the study\n   * Diagnosis of Type 2 diabetes in stable treatment with metformin\n   * Diagnosis of Type 2 diabetes in stable treatment with metformin (at least 1000 mg/day) in combination with a sulfonylurea\n   * Diagnosis of Type 2 diabetes in stable treatment with metformin (at least 1000 mg/day), sulfonylurea and thiazolidinedione combination therapy\n   * Diagnosis of Type 2 diabetes in stable treatment with at least two insulin injections a day with or without metformin\n2. HbA1c between 6.5% and 8%, inclusive, at Screening; this criterion does not apply to the IGT group\n3. Age from 18-74 years, inclusive, and of either sex\n\nExclusion Criteria:\n\n1. Type 1 diabetes or diabetes that is a result of pancreatic injury or other secondary forms of diabetes\n2. History or current findings of active pulmonary disease (e.g. tuberculosis, fungal diseases) as defined in the protocol:\n3. Known presence or suspicion of active or recurrent bacterial, fungal or viral infection at the time of enrollment proven.","healthy_volunteers":false,"maximum_age":"74 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":246,"type":"ACTUAL"},"first_posted":"2010-02-15","has_results":true,"interventions":[{"name":"Canakinumab 150 mg","other_names":["ACZ885","Glucophage","Chlorpropramide","Diabinese","Acetohexamide","Dymelor","Tolazamise","Tolinase","Tolbutamise","Orinase","Glipizide","Glucotrol","Glimepiride","Amaryl","Glyburide","DiaBeta","Micronase","Glynase PresTab","Troglitazone","Rezulin","Insulin","Iletin","Novolin","Velosulin","Humalog","Humulin","Lente","Ultralente","NPH Iletin"],"type