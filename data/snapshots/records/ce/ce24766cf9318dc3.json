{"acronym":null,"arm_groups":[{"intervention_names":["Procedure: no blood-glucose self-control"],"label":"1","type":"EXPERIMENTAL"},{"intervention_names":["Procedure: weekly blood glucose profile"],"label":"2","type":"EXPERIMENTAL"},{"intervention_names":["Procedure: three-monthly haemoglobin A1c","Procedure: no blood-glucose self-control"],"label":"3","type":"EXPERIMENTAL"},{"intervention_names":["Procedure: weekly blood glucose profile","Procedure: three-monthly haemoglobin A1c"],"label":"4","type":"EXPERIMENTAL"}],"brief_summary":"The purpose of this randomized, prospective trial is to determine wether (a) a once weekly glucose profile (self monitoring) or (b) a three-monthly report of the actual glycated haemoglobin are effective interventions to improve HbA1c after one year in typ 2-diabetic patients on conventional insulin treatment.","brief_title":"Blood Glucose Self Monitoring and HbA1c Effects on Glucose Control","collaborators":["Bayer"],"completion_date":{"date":"2008-12","type":"ACTUAL"},"conditions":["Type 2 Diabetes"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"DIAGNOSTIC","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Type 2-diabetes (ADA/WHO-Criteria)\n* Conventional insulin therapy ( 1-3 daily injections of basal- and/or mixed insulin also in combination with oral agents.)\n* Age:\\> 40 years\n* BMI:\\> 20 kg/m²\n\nExclusion Criteria:\n\n* Impaired liver function, defined as \\> 2 times upper limit of normal\n* Impaired renal function defined liver enzymes as serum-creatinine \\> 1.3 mg/dl\n* Gastro-intestinal diseases (disturbances, diagnoses)\n* Inability to perform study-related activities according to the present protocol\n* Pregnancy not certainly excluded\n* Abuse of alcohol and/or other drugs\n* Participation in other clinical trials during the past 3 month\n* Threat to general state of health\n* Intensified insulin therapy (at least 3 times rapid-acting insulin)\n* Frequent blood glucose self monitoring during the past 3 months (more than one 4-point glucose profile per week or more than one blood glucose/ urinary glucose test per day )","healthy_volunteers":false,"maximum_age":"80 Years","minimum_age":"40 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":300,"type":"ACTUAL"},"first_posted":"2008-06-02","has_results":false,"interventions":[{"name":"weekly blood glucose profile","other_names":[],"type":"PROCEDURE"},{"name":"three-monthly haemoglobin A1c","other_names":[],"type":"PROCEDURE"},{"name":"no blood-glucose self-control","other_names":[],"type":"PROCEDURE"}],"last_known_status":null,"last_update_posted":"2011-08-01","lead_sponsor":{"class":"OTHER","name":"Deutsche Diabetes Gesellschaft"},"nct_id":"NCT00688363","official_title":"The Benefit of the Blood Glucose Self Monitoring and a Regular Three-monthly Hemoglobin A1c Profile in Patients With Type 2-diabetes and Conventional Insulin Therapy","overall_status":"COMPLETED","phases":["PHASE4"],"primary_completion_date":{"date":"2008-09","type":"ACTUAL"},"primary_outcomes":[{"measure":"Haemoglobin A1c after one year","time_frame":"1 year"}],"results_first_posted":null,"sites":[{"city":"Bad Harzburg","country":"Germany","facility":"Koch, Peter","lat":51.88268,"lon":10.56157,"state":null,"status":null},{"city":"Bad Kreuznach","country":"Germany","facility":"Maxeiner, Stefan","lat":49.8414,"lon":7.86713,"state":null,"status":null},{"city":"Bad Lauterberg im Harz","country":"Germany","facility":"Friedrichs, Michael","lat":51.63272,"lon":10.47031,"state":null,"status":null},{"city":"Bad Lauterberg im Harz","country":"Germany","facility":"Jödicke, Carmen","lat":51.63272,"lon":10.47031,"state":null,"status":null},{"city":"Bad Nauheim","country":"Germany","facility":"Mulch-Wiemer, Christa","lat":50.36463,"lon":8.73859,"state":null,"status":null},{"city":"Berlin","country":"Germany","facility":"Bellmann, Renate","lat":52.52437,"lon":13.41053,"state":n