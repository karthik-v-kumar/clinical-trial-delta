ely controlled thyroid disorder\n* Renal disease that required treatment with immunosuppressive therapy or a history of chronic dialysis or renal transplant\n* Myocardial infarction, unstable angina, revascularization procedure, or cerebrovascular accident within 3 months before screening.","healthy_volunteers":false,"maximum_age":null,"minimum_age":"30 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":5813,"type":"ACTUAL"},"first_posted":"2013-11-21","has_results":true,"interventions":[{"name":"Placebo","other_names":[],"type":"DRUG"},{"name":"Canagliflozin, 100 mg","other_names":[],"type":"DRUG"},{"name":"Canagliflozin, 300 mg","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2018-12-11","lead_sponsor":{"class":"INDUSTRY","name":"Janssen Research & Development, LLC"},"nct_id":"NCT01989754","official_title":"A Randomized, Multicenter, Double-Blind, Parallel, Placebo-Controlled Study of the Effects of Canagliflozin on Renal Endpoints in Adult Subjects With Type 2 Diabetes Mellitus","overall_status":"COMPLETED","phases":["PHASE4"],"primary_completion_date":{"date":"2017-02-23","type":"ACTUAL"},"primary_outcomes":[{"measure":"Progression of Albuminuria","time_frame":"Up to 3 years"}],"results_first_posted":"2018-12-11","sites":[{"city":"Buenos Aires","country":"Argentina","facility":null,"lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"Ciudad de Buenos Aires","country":"Argentina","facility":null,"lat":null,"lon":null,"state":null,"status":null},{"city":"Córdoba","country":"Argentina","facility":null,"lat":-31.40648,"lon":-64.18853,"state":null,"status":null},{"city":"Mar del Plata","country":"Argentina","facility":null,"lat":-38.00042,"lon":-57.5562,"state":null,"status":null},{"city":"Morón","country":"Argentina","facility":null,"lat":-34.65118,"lon":-58.62205,"state":null,"status":null},{"city":"Rosario","country":"Argentina","facility":null,"lat":-32.94682,"lon":-60.63932,"state":null,"s