{"acronym":"MOBILE","arm_groups":[{"intervention_names":["Device: Dexcom G6 CGM System"],"label":"Continous Glucose Monitor","type":"EXPERIMENTAL"},{"intervention_names":["Device: Blood glucose meter"],"label":"Self Monitoring Blood Glucose","type":"ACTIVE_COMPARATOR"}],"brief_summary":"A study to compare the glycemic and quality of life benefits of diabetes management using Dexcom G6 continuous glucose monitoring (CGM) or self-monitored blood glucose (SMBG) made by study participants and their primary care physicians. Decisions will be based on insights from real-time use and retrospective insights, determined during remote visits.\n\nParticipants will have type 2 diabetes and be using basal insulin (with or without oral medications and/or Glucagon-Like-Peptide-1 (GLP-1) analogue) and have an elevated Hemoglobin A1C (HbA1c).","brief_title":"Type 2 Diabetes (T2D) Basal Insulin Users: The Mobile Study (MOBILE)","collaborators":["Jaeb Center for Health Research"],"completion_date":{"date":"2021-01-04","type":"ACTUAL"},"conditions":["Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Major Inclusion Criteria:\n\n* Age 30 or older\n* Diagnosis of Type 2 diabetes\n* HbA1c between 7.8-11.5%\n* Use of basal insulin, with or without concomitant use of oral agents or GLP-1 agonist\n\nMajor Exclusion Criteria:\n\n* Pregnancy\n* Renal disease\n* Conditions that impact the stability of a HbA1c measurement\n* Use of prandial insulin","healthy_volunteers":false,"maximum_age":null,"minimum_age":"30 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":176,"type":"ACTUAL"},"first_posted":"2018-06-25","has_results":false,"interventions":[{"name":"Dexcom G6 CGM System","other_names":[],"type":"DEVICE"},{"name":"Blood glucose meter","other_names":[],"type":"DEVICE"}],"last_known_status":null,"last_update_posted":"2021-04-21","le