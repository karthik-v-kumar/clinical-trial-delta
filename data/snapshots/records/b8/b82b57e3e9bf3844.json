{"acronym":"ACHIEVE-J","arm_groups":[{"intervention_names":["Drug: Orforglipron"],"label":"3 mg Orforglipron","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Orforglipron"],"label":"12 mg Orforglipron","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Orforglipron"],"label":"36 mg Orforglipron","type":"EXPERIMENTAL"}],"brief_summary":"The purpose of this study is to determine the long-term safety of the study intervention orforglipron as a monotherapy or in combination with oral antihyperglycemic medication.\n\nThis study includes 3 periods as follows:\n\n* screening and lead-in period: up to 4 weeks\n* treatment period: 52 weeks, including 20 weeks of dose escalation, and\n* safety follow-up period: 2 weeks.","brief_title":"A Long-term Safety Study of Orforglipron (LY3502970) in Participants With Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2025-06-05","type":"ACTUAL"},"conditions":["Type 2 Diabetes"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have Type 2 Diabetes (T2D)\n* Have HbA1c ≥7.0% (≥53 mmol/mol) to ≤10.5% (≤91 mmol/mol) as determined by the central laboratory at screening.\n* Are of stable weight (±5%) for at least 90 days prior to screening and agree to not initiate an intensive diet or exercise program during the study with the intent of reducing body weight other than the lifestyle and/or dietary measures for diabetes treatment.\n* Have a BMI ≥23.0 kilogram/square meter (kg/m²) at screening.\n\nExclusion Criteria:\n\n* Have Type 1 Diabetes (T1D).\n* Have a history of severe hypoglycemia or hypoglycemia unawareness within the last 6 months prior to screening, or between screening and randomization.\n* Have New York Heart Association functional classification IV congestive heart failure.\n* Have had any of the following cardiovascular (CV) conditions within 60 days prior to screening, or between screening and randomization.\n\n  * acute myocardial infarction\n  * cerebrovascular accident (stroke), or\n  * hospitalization for congestive heart failure\n* Have acute or chronic hepatitis and pancreatitis","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":401,"type":"ACTUAL"},"first_posted":"2023-08-24","has_results":true,"interventions":[{"name":"Orforglipron","other_names":["LY3502970"],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-06-30","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT06010004","official_title":"A Phase 3, Long-term Safety Study of LY3502970 in Adult Participants With Type 2 Diabetes and Inadequate Glycemic Control With Diet and Exercise Alone or in Combination With Oral Antihyperglycemic Medications (ACHIEVE-J)","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2025-06-05","type":"ACTUAL"},"primary_outcomes":[{"measure":"Number of Participants With Treatment Emergent Adverse Events (TEAEs)","time_frame":"Baseline to Week 54"}],"results_first_posted":"2026-06-30","sites":[{"city":"Fukuoka","country":"Japan","facility":"Tashiro Endocrinology Clinic","lat":33.6,"lon":130.41667,"state":null,"status":null},{"city":"Kumamoto","country":"Japan","facility":"Jinnouchi Hospital","lat":32.80589,"lon":130.69181,"state":null,"status":null},{"city":"Kumamoto","country":"Japan","facility":"Morinaga Ueno Clinic","lat":32.80589,"lon":130.69181,"state":null,"status":null},{"city":"Miyazaki","country":"Japan","facility":"Heiwadai Hospital","lat":31.91667,"lon":131.41667,"state":null,"status":null},{"city":"Osaka","country":"Japan","facility":"Kansai Electric Power Hospital","lat":34.69379,"lon":135.50107,"state":null,"status":null},{"city":"Ōita","country":"Japan","facility":"Abe Clinic","lat":33.23333,"lon":131.6,"state":null,"status":null},{"city":"Nagoya","country":"Japan","fa