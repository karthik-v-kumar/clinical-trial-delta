{"acronym":null,"arm_groups":[],"brief_summary":"This is a questionnaire based study (no study drug is involved) that asks if more patients with uncontrolled type 2 diabetes on diabetes pills will choose insulin as the next treatment choice if inhaled insulin were available in addition to all currently available treatments, compared with if inhaled insulin was not available as part of currently available treatments.\n\nThis study will also ask if patients with uncontrolled type 2 diabetes currently managed on diabetes pills + once daily insulin will choose as the next treatment choice to take insulin multiple times a day if inhaled insulin were available in addition to all currently available treatments, compared with if inhaled insulin was not available as part of currently available treatments.","brief_title":"US Inhaled Insulin Therapeutic Choice Questionnaire Study","collaborators":["Sanofi"],"completion_date":{"date":"2006-03","type":null},"conditions":["Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"ECT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Male and female, age \\> = 18 years and \\<= 80 years with a diagnosis of type 2 diabetes made at least 6 months prior to study entry\n* Currently treated with either:\n* 2 or more oral antidiabetic agents, OR 1 or more oral antidiabetic agents and insulin glargine\n\nExclusion Criteria:\n\n* Type 1 diabetes\n* Smoking within the past 6 months","healthy_volunteers":false,"maximum_age":"80 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":740,"type":null},"first_posted":"2005-08-31","has_results":false,"interventions":[{"name":"Educational Materials","other_names":[],"type":"PROCEDURE"}],"last_known_status":null,"last_update_posted":"2007-03-19","lead_sponsor":{"class":"INDUSTRY","name":"Pfizer"},"nct_id":"NCT00139763","official_title":"A US Randomized Questi