{"acronym":null,"arm_groups":[{"intervention_names":["Drug: liraglutide"],"label":"Liraglutide","type":"EXPERIMENTAL"},{"intervention_names":["Drug: placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"This trial is conducted in Asia, Europe and North and South America. The aim of the trial is to investigate the effect of liraglutide versus placebo when added to basal insulin analogues with or without metformin in subjects with type 2 diabetes.","brief_title":"The Effect of Liraglutide Versus Placebo When Added to Basal Insulin Analogues With or Without Metformin in Subjects With Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2013-10","type":"ACTUAL"},"conditions":["Diabetes","Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Diagnosed with type 2 diabetes for at least 180 days prior to screening and treated with stable basal insulin analogue dose of minimum 20 U/day with or without stable metformin equal to or above 1500 mg/day for at least 8 weeks prior to screening (defined as insulin adjustments less than 10% during the past 8 weeks as assessed by the investigator)\n* HbA1c (glycosylated haemoglobin A1c) 7.0-10.0% (both inclusive)\n* Body mass index (BMI) 20-45 kg/m\\^2 (both inclusive)\n\nExclusion Criteria:\n\n* Female of child-bearing potential who is pregnant, breast-feeding or intending to become pregnant\n* Recurrent severe hypoglycaemic episodes or hypoglycaemic unawareness\n* Treatment with glucose-lowering agent(s) other than stated in the inclusion criteria in a period of 12 weeks prior to screening\n* Impaired liver or renal function\n* Uncontrolled treated or untreated hypertension (systolic blood pressure (SBP) equal to or above 180 mmHg and/or diastolic blood pressure (DBP) equal to or above 100 mmHg)\n* Any clinically significant disorder, except for conditions associated with type 2 diabetes history which in the investigator's opinion could interfere with results of the trial\n* Known or suspected abuse of alcohol or narcotics","healthy_volunteers":false,"maximum_age":"80 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":451,"type":"ACTUAL"},"first_posted":"2012-06-12","has_results":true,"interventions":[{"name":"liraglutide","other_names":[],"type":"DRUG"},{"name":"placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2017-03-08","lead_sponsor":{"class":"INDUSTRY","name":"Novo Nordisk A/S"},"nct_id":"NCT01617434","official_title":"The Effect of Liraglutide Versus Placebo When Added to Basal Insulin Analogues With or Without Metformin in Subjects With Type 2 Diabetes","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2013-10","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change in Glycosylated Haemoglobin (HbA1c) From Baseline to Week 26","time_frame":"Week 0 to Week 26"}],"results_first_posted":"2014-10-28","sites":[{"city":"Buenos Aires","country":"Argentina","facility":"Novo Nordisk Investigational Site","lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"Caba","country":"Argentina","facility":"Novo Nordisk Investigational Site","lat":null,"lon":null,"state":null,"status":null},{"city":"Caba","country":"Argentina","facility":"Novo Nordisk Investigational Site","lat":null,"lon":null,"state":null,"status":null},{"city":"Córdoba","country":"Argentina","facility":"Novo Nordisk Investigational Site","lat":-31.40648,"lon":-64.18853,"state":null,"status":null},{"city":"Coquitlam","country":"Canada","facility":"Novo Nordisk Investigational Site","lat":49.2846,"lon":-122.78217,"state":"British Columbia","status":null},{"city":"Vancouver","country":"Canada","facility":"Novo Nordisk Investigational Site","lat":49.24966,"lon":-123.11934,"state":"Britis