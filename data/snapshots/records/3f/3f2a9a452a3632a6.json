{"acronym":"LIVE JustICE","arm_groups":[{"intervention_names":["Other: Enhanced Education"],"label":"Control","type":"ACTIVE_COMPARATOR"},{"intervention_names":["Other: Diabetes LIVE JustICE"],"label":"Intervention","type":"EXPERIMENTAL"}],"brief_summary":"The proposed study will use a randomized clinical trial design with non-equivalent control group and longitudinal design to evaluate the feasibility, acceptability, and preliminary effects of the Diabetes LIVE JustICE application. The design will incorporate repeated measures at 0, 6, and 12 weeks. Outcome variables will include recruitment assessments, participation, engagement, user experience, and measures proximally related to behavior change - e.g., diabetes knowledge, diabetes-related distress, diabetes self-care, and social support and clinical outcomes -e.g., glycemic control. Focus group interviewing will be conducted to evaluate acceptability among intervention group participants.","brief_title":"Diabetes Learning in Virtual Environments Just in Time for Community Reentry","collaborators":["American Diabetes Association"],"completion_date":{"date":"2026-12-15","type":"ESTIMATED"},"conditions":["Diabetes Mellitus, Type 1","Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"SUPPORTIVE_CARE","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\nIndividuals will be eligible to participate if they:\n\n1. have Type 1 or 2 diabetes\n2. are age 18 and older\n3. can speak and understand English\n4. have been released directly from one of five Connecticut prisons to supervised community housing or parole","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":128,"type":"ESTIMATED"},"first_posted":"2022-03-18","has_results":false,"interventions":[{"name":"Diabetes LIVE JustICE","other_names":[],"type":"OTHER"},{"name":"Enhanced Education