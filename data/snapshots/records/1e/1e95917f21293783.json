{"acronym":null,"arm_groups":[{"intervention_names":["Drug: exenatide"],"label":"exenatide","type":"ACTIVE_COMPARATOR"},{"intervention_names":["Drug: taspoglutide"],"label":"taspoglutide 10mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: taspoglutide"],"label":"taspoglutide 10mg/20mg","type":"EXPERIMENTAL"}],"brief_summary":"This 3-arm study will assess the efficacy, safety and tolerability of taspoglutide compared with exenatide in patients with type 2 diabetes mellitus inadequately controlled with metformin, thiazolidinedione or a combination of both. Patients will be randomized to receive taspoglutide (10mg once weekly or 10mg once weekly for 4 weeks followed by 20mg once weekly) or exenatide (5 micrograms twice daily for 4 weeks followed by 10 micrograms twice daily) in a ratio of 1:1:1 in addition to continued prestudy metformin and thiazolidinedione either alone or in combination. The anticipated time on study treatment is 3+ years, and the target sample size is \\>500 individuals.","brief_title":"A Study of Taspoglutide Versus Exenatide for the Treatment of Patients With Type 2 Diabetes Mellitus Inadequately Controlled With Metformin, Thiazolidinedione or a Combination of Both.","collaborators":[],"completion_date":{"date":"2011-03","type":"ACTUAL"},"conditions":["Diabetes Mellitus Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* adult patients, 18-75 years of age;\n* type 2 diabetes receiving metformin and/or pioglitazone or rosiglitazone for at least 12 weeks;\n* HbA1c \\>=7.0% and \\<=10% at screening;\n* BMI \\>=25kg/m2 (\\>23kg/m2 for Asians) and \\<=45kg/m2 at screening;\n* stable weight +/- 5% for at least 12 weeks prior to screening.\n\nExclusion Criteria:\n\n* history of type 1 diabetes, diabetes resulting from pancreatic injury or secondary forms of diabetes;\n* history of acute metabolic diabetic complications within the previous 6 months;\n* evidence of clinically significant diabetic complications;\n* known proliferative diabetic retinopathy;\n* myocardial infarction (MI), coronary artery bypass surgery, post-transplantation cardiomyopathy (PTCM) or stroke within the past 6 months;\n* any abnormality in clinical laboratory test or ECG, which precludes safe involvement in the study as judged by the investigator;\n* known hemoglobinopathy or chronic anemia;\n* clinically significant gastrointestinal disease.","healthy_volunteers":false,"maximum_age":"75 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":1189,"type":"ACTUAL"},"first_posted":"2008-07-17","has_results":false,"interventions":[{"name":"exenatide","other_names":[],"type":"DRUG"},{"name":"taspoglutide","other_names":[],"type":"DRUG"},{"name":"taspoglutide","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2016-11-02","lead_sponsor":{"class":"INDUSTRY","name":"Hoffmann-La Roche"},"nct_id":"NCT00717457","official_title":"Randomized, Active Controlled, Open Label Study to Compare Taspoglutide vs Exenatide as add-on Treatment to Metformin and/or Thiazolidinediones in Patients With Type 2 Diabetes Mellitus","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2011-03","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change in HbA1c","time_frame":"24 weeks"}],"results_first_posted":null,"sites":[{"city":"Buenos Aires","country":"Argentina","facility":null,"lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"Buenos Aires","country":"Argentina","facility":null,"lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"Buenos Aires","country":"Argentina","facility":null,"lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"Camperdown","country":"Australia","facility":null,"lat":-33.88965,"lon":151.17642,"state":"New South Wales","status":null},{"city":"Freema