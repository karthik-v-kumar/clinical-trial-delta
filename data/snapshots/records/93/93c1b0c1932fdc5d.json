{"acronym":"APPLE TREE","arm_groups":[{"intervention_names":["Drug: Empagliflozin 10 MG"],"label":"Empagliflozin 10 MG","type":"OTHER"},{"intervention_names":["Drug: Dapagliflozin 10 MG"],"label":"Dapagliflozin 10 MG","type":"OTHER"}],"brief_summary":"The aim of this clinical trial is investigate the comparative effectiveness of empagliflozin and dapagliflozin for the treatment of diabetes, chronic kidney disease, and heart failure.\n\nPatients who are prescribed either empagliflozin or dapagliflozin, as part of daily clinical practice at the participating sites, will be included in the study. Treatment will be randomized automatically through the electronic health record software in clusters defined by time of day.\n\nhttps://www.appletreestudy.com","brief_title":"A Pragmatic Trial Comparing Empagliflozin and Dapagliflozin Through Cluster Randomization Embedded in the Electronic Health Record","collaborators":[],"completion_date":{"date":"2028-12-31","type":"ESTIMATED"},"conditions":["Diabetes Mellitus, Type 2","Heart Failure","Chronic Kidney Diseases"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Adults aged 18 years or more\n\nExclusion Criteria:\n\n* Incapabability of giving informed consent\n* Withdrawal of informed consent","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":17200,"type":"ESTIMATED"},"first_posted":"2024-10-15","has_results":false,"interventions":[{"name":"Empagliflozin 10 MG","other_names":[],"type":"DRUG"},{"name":"Dapagliflozin 10 MG","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-09-18","lead_sponsor":{"class":"OTHER","name":"Herlev and Gentofte Hospital"},"nct_id":"NCT06642272","official_title":"A Pragmatic Trial Comparing Empagliflozin and Dapagliflozin Through Cluster Randomi