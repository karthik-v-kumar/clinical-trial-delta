{"acronym":"reAZURE-AMI","arm_groups":[{"intervention_names":["Combination Product: Laroprovstat/Rosuvastatin"],"label":"laroprovstat/rosuvastatin","type":"EXPERIMENTAL"},{"intervention_names":["Other: Usual care LLT"],"label":"Usual care LLT","type":"ACTIVE_COMPARATOR"}],"brief_summary":"The purpose of this study is to assess the effect of FDC laroprovstat/rosuvastatin administered once daily orally versus usual care lipid-lowering therapy (LLT) on reducing the risk of major adverse cardiovascular events (MACE-PLUS) in patients with acute myocardial infarction (AMI).","brief_title":"Study to Assess the Effect of Fixed Dose Combination (FDC) Laroprovstat/Rosuvastatin on Major Adverse Cardiovascular Events in Patients Hospitalised With Acute Myocardial Infarction (reAZURE-AMI)","collaborators":[],"completion_date":{"date":"2030-11-26","type":"ESTIMATED"},"conditions":["Acute Myocardial Infarction","Hypercholesterolaemia"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"SINGLE","primary_purpose":"TREATMENT","who_masked":["OUTCOMES_ASSESSOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Participant must be ≥18 years of age\n* Participants hospitalised with a primary diagnosis of acute spontaneous MI\n* A blood sample collected during hospitalization for the heart attack, before or shortly after starting or changing cholesterol-lowering treatment, must show a LDL cholesterol level that meets the study requirements based on treatment status, along with at least one additional risk factor.\n\nExclusion Criteria:\n\n* Participants requiring invasive hemodynamic and/or vasopressor/inotropic support at the time of screening.\n* Uncontrolled severe hypertension\n* Uncontrolled T2DM\n* Inadequately treated hypothyroidism","healthy_volunteers":false,"maximum_age":"130 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":10000,"type":"ESTIMATED"},"first_posted":"2026-11-24","has_results":fals