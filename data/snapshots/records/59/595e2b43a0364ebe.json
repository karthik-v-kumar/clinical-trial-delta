{"acronym":"4T","arm_groups":[{"intervention_names":["Drug: insulin detemir"],"label":"Insulin detemir (basal insulin)","type":"EXPERIMENTAL"},{"intervention_names":["Drug: biphasic insulin aspart"],"label":"Insulin aspart (prandial insulin)","type":"ACTIVE_COMPARATOR"},{"intervention_names":["Drug: insulin aspart"],"label":"Biphasic insulin aspart 30 (biphasic insulin)","type":"ACTIVE_COMPARATOR"}],"brief_summary":"This trial is conducted in Europe.\n\nThe aim of this research study is to compare the efficacy (reduction in HbA1c and in blood glucose levels) of insulin detemir, insulin aspart and biphasic insulin aspart 30, when added to current OAD (oral anti-diabetic drug) treatment in subjects with type 2 diabetes and to verify the safety of use (number and severity of episodes of hypoglycaemia, body weight and side effects).","brief_title":"Comparison of Insulin Detemir, Insulin Aspart and Biphasic Insulin Aspart 30 With OAD Treatment in Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2009-08","type":"ACTUAL"},"conditions":["Diabetes","Diabetes Mellitus, Type 2"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Type 2 diabetes\n* Insulin naive\n* On OAD treatment for at least 4 months with metformin, a sulphonylurea or a combination\n* Body Mass Index (BMI) below or equal to 40.0 kg/m2\n* HbA1c (glycosylated haemoglobin): 7.0%-10% (both inclusive)\n\nExclusion Criteria:\n\n* Proliferative retinopathy\n* Recurrent major hypoglycaemia\n* Cardial problems\n* Uncontrolled hypertension\n* Impaired hepatic or renal function","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":708,"type":"ACTUAL"},"first_posted":"2005-09-16","has_results":true,"interventions":[{"name":"biphasic insulin aspart","other_names":[],"type":"DRUG"},{"name":"