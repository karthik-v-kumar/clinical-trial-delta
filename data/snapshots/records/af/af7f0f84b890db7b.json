, unstable angina, coronary artery bypass graft surgery or other major cardiovascular surgery, percutaneous coronary intervention, transient ischemic attack, cerebrovascular accident, or decompensated congestive heart failure within 90 days prior to screening, or currently have New York Heart Association Class III or IV heart failure.\n* Use of medications that affect glucose control or body weight or history of bariatric surgery or procedures.","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":409,"type":"ACTUAL"},"first_posted":"2024-10-28","has_results":false,"interventions":[{"name":"Maridebart Cafraglutide","other_names":["AMG 133"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-09-11","lead_sponsor":{"class":"INDUSTRY","name":"Amgen"},"nct_id":"NCT06660173","official_title":"A Study to Evaluate the Efficacy, Safety & Tolerability of Maridebart Cafraglutide in Adults With T2DM","overall_status":"ACTIVE_NOT_RECRUITING","phases":["PHASE2"],"primary_completion_date":{"date":"2025-10-06","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change From Baseline to Week 24 in Hemoglobin A1c (HbA1c)","time_frame":"Baseline to Week 24"}],"results_first_posted":null,"sites":[{"city":"Graz","country":"Austria","facility":"Medizinische Universitaet Graz","lat":47.06733,"lon":15.44197,"state":null,"status":null},{"city":"Linz","country":"Austria","facility":"Krankenhaus der Barmherzigen Brueder Linz","lat":48.30639,"lon":14.28611,"state":null,"status":null},{"city":"Vienna","country":"Austria","facility":"Klinik Hietzing","lat":48.20849,"lon":16.37208,"state":null,"status":null},{"city":"Vienna","country":"Austria","facility":"Universitaetsklinikum Allgemeines Krankenhaus Wien","lat":48.20849,"lon":16.37208,"state":null,"status":null},{"city":"Athens","country":"Greece","facility":"Laiko General Hospital of Athens","l