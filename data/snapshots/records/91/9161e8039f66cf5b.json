{"acronym":"ASCEND-QW","arm_groups":[{"intervention_names":["Drug: Alirocumab"],"label":"Arm 1 - Low Dose","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Alirocumab"],"label":"Arm 2 - Medium Dose","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Alirocumab"],"label":"Arm 3 - High Dose","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Alirocumab"],"label":"Arm 4 - Control Dose","type":"EXPERIMENTAL"}],"brief_summary":"This study is researching an experimental drug called alirocumab, referred to as \"study drug\". In the United States, alirocumab is approved for the treatment of hypercholesterolemia (high blood cholesterol levels).\n\nThe aim of the study is to see how safe and effective alirocumab is when given weekly to adult participants who have hypercholesterolemia.\n\nThe study is looking at several other research questions, including:\n\n* What side effects may happen from taking the study drug once a week\n* How much study drug is in the blood at different times","brief_title":"A Study to See How Safe and Effective Alirocumab is When Given Weekly to Adult Participants Who Have Hypercholesterolemia","collaborators":[],"completion_date":{"date":"2027-02-23","type":"ESTIMATED"},"conditions":["Hypercholesterolemia"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"NONE","primary_purpose":"TREATMENT","who_masked":[]},"eligibility":{"criteria":"Key Inclusion Criteria:\n\n1\\. Participant has elevated LDL-C level, as defined in the protocol\n\nKey Exclusion Criteria:\n\n1. Participant plans to initiate or change dose of lipid-lowering therapy\n2. Use of any PCSK9 inhibitors\n\nNOTE: Other Protocol-Defined Inclusion/Exclusion Criteria Apply","healthy_volunteers":false,"maximum_age":"80 Years","minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":438,"type":"ACTUAL"},"first_posted":"2026-03-17","has_results":false,"interventions":[{"name":"Alirocumab","other_names":["Praluent®","REGN727","SAR236553"],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-10-15","lead_sponsor":{"class":"INDUSTRY","name":"Regeneron Pharmaceuticals"},"nct_id":"NCT07477704","official_title":"A Randomized, Open-Label, Dose-Ranging Study to Evaluate the Efficacy, Safety, and Pharmacokinetics of Weekly Alirocumab in Adults With Hypercholesterolemia","overall_status":"ACTIVE_NOT_RECRUITING","phases":["PHASE2"],"primary_completion_date":{"date":"2026-12-29","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Percent change in LDL-C","time_frame":"From Baseline through Week 12"}],"results_first_posted":null,"sites":[{"city":"Anniston","country":"United States","facility":"Pinnacle Research Group","lat":33.65983,"lon":-85.83163,"state":"Alabama","status":null},{"city":"Cullman","country":"United States","facility":"Cullman Clinical Trials","lat":34.17482,"lon":-86.84361,"state":"Alabama","status":null},{"city":"Anaheim","country":"United States","facility":"Anaheim Clinical Trials","lat":33.83529,"lon":-117.9145,"state":"California","status":null},{"city":"Los Alamitos","country":"United States","facility":"Cenexel CNS","lat":33.80307,"lon":-118.07256,"state":"California","status":null},{"city":"Walnut Creek","country":"United States","facility":"Diablo Clinical Research - Flourish Research","lat":37.90631,"lon":-122.06496,"state":"California","status":null},{"city":"Clearwater","country":"United States","facility":"Tampa Bay Medical Research","lat":27.96585,"lon":-82.8001,"state":"Florida","status":null},{"city":"Fort Myers","country":"United States","facility":"Southwest General Healthcare Center","lat":26.62168,"lon":-81.84059,"state":"Florida","status":null},{"city":"Sunrise","country":"United States","facility":"Precision Clinical Research","lat":26.13397,"lon":-80.1131,"state":"Florida","status":null},{"city":"The Villages","country":"United States","facility":"K2 Medical Research The Villages","lat":28.93408,"lon":-81.95994,"state":"Florida","status":nul