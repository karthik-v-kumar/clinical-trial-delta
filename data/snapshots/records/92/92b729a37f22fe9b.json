{"acronym":"TRIUMPH-6","arm_groups":[{"intervention_names":["Drug: Retatrutide"],"label":"Retatrutide Dose 1","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Retatrutide"],"label":"Retatrutide Dose 1 to Retatrutide Dose 2","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Retatrutide","Drug: Placebo"],"label":"Retatrutide Dose 1 to Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"This is a study of retatrutide in participants with obesity. The main purpose is to learn more about how retatrutide maintains body weight loss. The study will have two treatment phases: an 80 week lead-in phase in which all participants will take retatrutide dose 1 and a 36 week randomized, double-blinded phase in which participants will either take retatrutide dose 1, retatrutide dose 2, or switch to placebo. Participation in the study will last around 125 weeks.","brief_title":"A Study of Retatrutide (LY3437943) in the Maintenance of Weight Reduction in Individuals With Obesity","collaborators":[],"completion_date":{"date":"2028-04","type":"ESTIMATED"},"conditions":["Obesity"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have obesity and a history of at least one self-reported unsuccessful dietary effort to reduce body weight\n\nExclusion Criteria:\n\n* Have a self-reported change in body weight \\>5 kilograms (kg) (11 pounds) within 90 days before screening\n* Have a prior or planned surgical treatment for obesity\n* Have a prior or planned endoscopic procedure and/or device-based therapy for obesity\n* Have Type 1 Diabetes, Type 2 Diabetes, or any other type of diabetes\n* Have a family or personal history of medullary thyroid carcinoma (MTC) or multiple endocrine neoplasia syndrome type 2 (MEN-2)\n* Have had within the past 90 days before screening:\n\n  * acute myocardial infarction\n  * cerebrovascular accident (stroke)\n  * hospitalization for unstable angina, or\n  * hospitalization due to congestive heart failure\n* Have New York Heart Association Functional Classification Class IV congestive heart failure\n* Have a history of chronic or acute pancreatitis\n* Have taken weight loss drugs, including over-the-counter medications, within 90 days prior to screening","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":643,"type":"ESTIMATED"},"first_posted":"2025-03-05","has_results":false,"interventions":[{"name":"Retatrutide","other_names":["LY3437943"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-03-03","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT06859268","official_title":"A Phase 3b, Randomized, Double-Blind, Placebo-Controlled Study to Evaluate Retatrutide Treatment in the Maintenance of Weight Reduction in Individuals With Obesity","overall_status":"ACTIVE_NOT_RECRUITING","phases":["PHASE3"],"primary_completion_date":{"date":"2028-04","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Percent Change from Baseline in Body Weight","time_frame":"Week 0, Week 116"}],"results_first_posted":null,"sites":[{"city":"Brampton","country":"Canada","facility":"Aggarwal and Associates Limited","lat":43.68341,"lon":-79.76633,"state":null,"status":null},{"city":"Burlington","country":"Canada","facility":"Circulate Cardiac & Vascular Centre","lat":43.38621,"lon":-79.83713,"state":null,"status":null},{"city":"Courtice","country":"Canada","facility":"Med Trust Research","lat":43.91682,"lon":-78.76626,"state":null,"status":null},{"city":"Hamilton","country":"Canada","facility":"Winterberry Research Inc.","lat":43.25011,"lon":-79.84963,"state":null,"status":null},{"city":"Terrebonne","country":"Canada","facility":"Centre de Medecine Metabolique de Lanaudiere (CMML)","lat":45.70004,"lo