{"acronym":"CANVAS","arm_groups":[{"intervention_names":["Drug: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"},{"intervention_names":["Drug: Canagliflozin (JNJ-28431754) 100 mg"],"label":"Canagliflozin (JNJ-28431754) 100 mg","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Canagliflozin (JNJ-28431754) 300 mg"],"label":"Canagliflozin (JNJ-28431754) 300 mg","type":"EXPERIMENTAL"}],"brief_summary":"The study will assess canagliflozin (JNJ-28431754) in the treatment of patients with type 2 diabetes mellitus (T2DM) with regard to cardiovascular (CV) risk for major adverse cardiac events (MACE). Other objectives include evaluating the overall safety, tolerability, and effectiveness of canagliflozin.\n\nThe data from this study will be combined with the data from CANVAS-R study (Study of the Effects of Canagliflozin on Renal Endpoints in Adult Subjects with T2DM, NCT01989754) in a pre-specified integrated analysis of CV safety outcomes to satisfy US FDA post-marketing requirements for canagliflozin.","brief_title":"CANVAS - CANagliflozin cardioVascular Assessment Study","collaborators":["The George Institute for Global Health, Australia"],"completion_date":{"date":"2017-02-22","type":"ACTUAL"},"conditions":["Diabetes Mellitus, Type 2","Cardiovascular Diseases","Risk Factors"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"QUADRUPLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Patients must have a diagnosis of type 2 diabetes mellitus and greater than or equal to (\\>=) 30 yrs old with history of cardiovascular (CV) event, or \\>= 50 yrs old with high risk of CV events\n* Patients must have inadequate diabetes control (as defined by glycosylated hemoglobin greater than or equal to 7.0% to less than or equal to 10.5% at screening) and be either (1) not currently on diabetes drug therapy or (2) on therapy with any approved class of diabetes drugs\n\nExclusion Criteria:\n\n* A history of diabetic ketoacidosis, type 1 diabetes mellitus, pancreas or beta-cell transplantation, or diabetes secondary to pancreatitis or pancreatectomy\n* History of one or more severe hypoglycemic (ie, very low blood sugar) episode within 6 months before screening","healthy_volunteers":false,"maximum_age":null,"minimum_age":"30 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":4330,"type":"ACTUAL"},"first_posted":"2009-12-15","has_results":true,"interventions":[{"name":"Placebo","other_names":[],"type":"DRUG"},{"name":"Canagliflozin (JNJ-28431754) 100 mg","other_names":[],"type":"DRUG"},{"name":"Canagliflozin (JNJ-28431754) 300 mg","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2018-12-07","lead_sponsor":{"class":"INDUSTRY","name":"Janssen Research & Development, LLC"},"nct_id":"NCT01032629","official_title":"A Randomized, Multicenter, Double-Blind, Parallel, Placebo-Controlled Study of the Effects of JNJ-28431754 on Cardiovascular Outcomes in Adult Subjects With Type 2 Diabetes Mellitus","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2017-02-22","type":"ACTUAL"},"primary_outcomes":[{"measure":"Major Adverse Cardiovascular Events (MACE) Composite of Cardiovascular (CV) Death, Non-Fatal Myocardial Infarction (MI), and Non-Fatal Stroke","time_frame":"Up to approximately 8 years"}],"results_first_posted":"2018-12-07","sites":[{"city":"Buenos Aires","country":"Argentina","facility":null,"lat":-34.61315,"lon":-58.37723,"state":null,"status":null},{"city":"Capital Federal","country":"Argentina","facility":null,"lat":null,"lon":null,"state":null,"status":null},{"city":"Ciudad Autonma Buenos Aires","country":"Argentina","facility":null,"lat":null,"lon":null,"state":null,"status":null},{"city":"Corrientes","country":"Argentina","facility":null,"lat":-27.46784,"lon":-58.8344,"state":null,"status":null},{"city":"Có