{"acronym":"ATTAIN-NOW","arm_groups":[{"intervention_names":["Drug: Orforglipron"],"label":"Orforglipron","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Orforglipron","Drug: Placebo"],"label":"Orforglipron to Placebo","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Orforglipron","Drug: Placebo"],"label":"Placebo to Orforglipron","type":"EXPERIMENTAL"}],"brief_summary":"This study will evaluate the efficacy and safety of orforglipron in participants with overweight and assess whether it helps reduce the future risk of obesity-related conditions, including type 2 diabetes, hypertension, and dyslipidemia, and progression to class 1 obesity.","brief_title":"A Study of Orforglipron in Participants With Overweight at Risk of Development of Obesity-Related Complications or Progression to Class 1 Obesity","collaborators":[],"completion_date":{"date":"2030-09","type":"ESTIMATED"},"conditions":["Overweight","Prediabetic State","Prehypertension","Obesity, Abdominal"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have an increased waist-to-height ratio of ≥0.5\n* Have at least one pre-obesity-related complication (prediabetes, prehypertension, predyslipidemia)\n* Have at least one unsuccessful attempt to reduce body weight based on diet and exercise\n* Have a BMI greater than or equal to 25 to less than or equal to 29.9 kg/m2 or equivalent-/region-specific overweight thresholds\n\nExclusion Criteria:\n\n* Have type 1 diabetes, type 2 diabetes, or any other type of diabetes\n* Do not have a stable body weight within 90 days before screening\n* Have a documented obesity diagnosis or self-reported history of BMI ≥30 kg/m² (or an equivalent region-specific threshold)\n* Have taken medications for weight loss, including over-the counter medications or alternative therapies, within 180 days prior to screening\n* Have a prior or planned surgical treatment or procedure for obesity\n* Have hypertension or history of hypertension\n* Have dyslipidemia or history of dyslipidemia","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":2001,"type":"ESTIMATED"},"first_posted":"2026-08-31","has_results":false,"interventions":[{"name":"Orforglipron","other_names":["LY3502970"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-11-05","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT07794579","official_title":"A Phase 3, Randomized, Double-blind, Placebo-controlled Study to Investigate the Efficacy and Safety of Once-Daily Oral Orforglipron Compared With Placebo in Individuals With Overweight at Risk of Development of Obesity-Related Complications or Progression to Class 1 Obesity","overall_status":"RECRUITING","phases":["PHASE3"],"primary_completion_date":{"date":"2029-08","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Time to Onset of Obesity Related Complications or Class 1 Obesity","time_frame":"Baseline to Week 104"}],"results_first_posted":null,"sites":[{"city":"Buenos Aires","country":"Argentina","facility":"CARDIAMET Investigaciones Médicas","lat":-34.61315,"lon":-58.37723,"state":null,"status":"NOT_YET_RECRUITING"},{"city":"Buenos Aires","country":"Argentina","facility":"CEMEDIC","lat":-34.61315,"lon":-58.37723,"state":null,"status":"RECRUITING"},{"city":"Buenos Aires","country":"Argentina","facility":"Centro Médico Viamonte","lat":-34.61315,"lon":-58.37723,"state":null,"status":"NOT_YET_RECRUITING"},{"city":"Buenos Aires","country":"Argentina","facility":"CIPREC","lat":-34.61315,"lon":-58.37723,"state":null,"status":"NOT_YET_RECRUITING"},{"city":"Buenos Aires","country":"Argentina","facility":"CONEXA Investigacion Clinica S.A.","lat":-34.61315,"lon":-58.37723,"state":null,"status":"REC