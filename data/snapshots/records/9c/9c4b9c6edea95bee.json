{"acronym":"AMPLIFY-1","arm_groups":[{"intervention_names":["Drug: eloralintide and tirzepatide"],"label":"EloraTZP Dose 1","type":"EXPERIMENTAL"},{"intervention_names":["Drug: eloralintide and tirzepatide"],"label":"EloraTZP Dose 2","type":"EXPERIMENTAL"},{"intervention_names":["Drug: eloralintide and tirzepatide"],"label":"EloraTZP Dose 3","type":"EXPERIMENTAL"},{"intervention_names":["Drug: eloralintide and tirzepatide"],"label":"EloraTZP Dose 4","type":"EXPERIMENTAL"},{"intervention_names":["Drug: eloralintide and tirzepatide"],"label":"EloraTZP Dose 5","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Tirzepatide"],"label":"Tirzepatide","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Eloralintide"],"label":"Eloralintide","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"The purpose of this study is to investigate the efficacy and safety of eloralintide and tirzepatide coformulation (EloraTZP) compared with tirzepatide, eloralintide and placebo for body weight reduction in participants with obesity.\n\nParticipation in the study will last about 2 years.","brief_title":"A Study of EloraTZP in Adult Participants With Obesity Without Type 2 Diabetes","collaborators":[],"completion_date":{"date":"2029-11","type":"ESTIMATED"},"conditions":["Obesity"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have a stable self-reported body weight (\\<5% body weight change) for 90 days prior to screening\n* Have a BMI of ≥35 kg/m2 at screening\n* Have a history of at least 1 self-reported unsuccessful dietary effort to reduce body weight\n\nExclusion Criteria:\n\n* Have a prior or planned surgical treatment for obesity (liposuction, cryolipolysis, or abdominoplasty allowed if performed \\>1 year before screening)\n* Have a prior or planned endoscopic procedure and/or device-based therapy for obesity and/or type 2 diabetes (prior device-based therapy acceptable if device removal was more than 6 months prior to screening)\n* Have type 1 diabetes, type 2 diabetes, or any other type of diabetes\n* Have had within 90 days prior to screening:\n\n  * heart attack\n  * stroke\n  * coronary artery revascularization\n  * unstable angina, or\n  * hospitalization due to congestive heart failure\n* Have a history or diagnosis of New York Heart Association Functional Classification Class IV congestive heart failure\n* Have taken any glucose-lowering medication within 90 days of screening\n* Have taken medications or alternative remedies intended for weight loss within 90 days of screening","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":2115,"type":"ESTIMATED"},"first_posted":"2026-10-19","has_results":false,"interventions":[{"name":"eloralintide and tirzepatide","other_names":["LY900043"],"type":"DRUG"},{"name":"Eloralintide","other_names":["LY3841136"],"type":"DRUG"},{"name":"Tirzepatide","other_names":["LY3298176"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2026-11-03","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT07881432","official_title":"A Phase 3 Study to Investigate the Efficacy and Safety of LY900043 in Adult Participants With Obesity Without Type 2 Diabetes","overall_status":"NOT_YET_RECRUITING","phases":["PHASE3"],"primary_completion_date":{"date":"2029-10","type":"ESTIMATED"},"primary_outcomes":[{"measure":"Percent Change from Baseline in Body Weight","time_frame":"Baseline, Week 100"}],"results_first_posted":null,"sites":[{"city":"Bahía Blanca","country":"Argentina","facility":"Instituto de Investigaciones Clínicas Bahia Blanca","lat":-38.7176,"lon":-62.26545,"state":null,"status":null},{"city":"Bu