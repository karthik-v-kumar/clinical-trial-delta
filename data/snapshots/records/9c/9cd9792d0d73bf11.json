{"acronym":"SURPASS-1","arm_groups":[{"intervention_names":["Drug: Tirzepatide"],"label":"5 mg Tirzepatide","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Tirzepatide"],"label":"10 mg Tirzepatide","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Tirzepatide"],"label":"15 mg Tirzepatide","type":"EXPERIMENTAL"},{"intervention_names":["Drug: Placebo"],"label":"Placebo","type":"PLACEBO_COMPARATOR"}],"brief_summary":"The goal for this study is to evaluate the efficacy and safety of tirzepatide versus placebo in participants with type 2 diabetes not under control with diet and exercise alone. The study will last approximately 47 weeks and may include about 15 visits.","brief_title":"A Study of Tirzepatide (LY3298176) in Participants With Type 2 Diabetes Not Controlled With Diet and Exercise Alone","collaborators":[],"completion_date":{"date":"2020-10-28","type":"ACTUAL"},"conditions":["Type 2 Diabetes Mellitus"],"design":{"allocation":"RANDOMIZED","intervention_model":"PARALLEL","masking":"DOUBLE","primary_purpose":"TREATMENT","who_masked":["PARTICIPANT","INVESTIGATOR"]},"eligibility":{"criteria":"Inclusion Criteria:\n\n* Have been diagnosed with type 2 diabetes mellitus (T2DM).\n* Are naïve to diabetes injectable therapies and have not used any oral antihyperglycemic medications (OAMs) during the 3 months preceding screening.\n* Have HbA1c between ≥7.0% and ≤9.5%.\n* Be of stable weight (± 5%) for at least 3 months before screening.\n* Have a BMI ≥23 kilograms per meter squared (kg/m²) at screening.\n\nExclusion Criteria:\n\n* Have type 1 diabetes mellitus.\n* Have had chronic or acute pancreatitis any time prior to study entry.\n* Have proliferative diabetic retinopathy or diabetic maculopathy or nonproliferative diabetic retinopathy requiring acute treatment.\n* Have disorders associated with slowed emptying of the stomach, or have had any stomach surgeries for the purpose of weight loss.\n* Have an estimated glomerular filtration rate \\<30 mL/minute/1.73 m².\n* Have had a heart attack, stroke, or hospitalization for congestive heart failure in the past 2 months.\n* Have a personal or family history of medullary thyroid carcinoma or personal history of multiple endocrine neoplasia syndrome type 2.\n* Have been taking weight loss drugs, including over-the-counter medications during the last 3 months.","healthy_volunteers":false,"maximum_age":null,"minimum_age":"18 Years","sex":"ALL","std_ages":["ADULT","OLDER_ADULT"]},"enrollment":{"count":478,"type":"ACTUAL"},"first_posted":"2019-05-17","has_results":true,"interventions":[{"name":"Tirzepatide","other_names":["LY3298176"],"type":"DRUG"},{"name":"Placebo","other_names":[],"type":"DRUG"}],"last_known_status":null,"last_update_posted":"2021-10-20","lead_sponsor":{"class":"INDUSTRY","name":"Eli Lilly and Company"},"nct_id":"NCT03954834","official_title":"A Randomized, Double-blind, Placebo-Controlled Trial Comparing the Efficacy and Safety of Three Tirzepatide Doses Versus Placebo in Patients With Type 2 Diabetes, Inadequately Controlled With Diet and Exercise Alone","overall_status":"COMPLETED","phases":["PHASE3"],"primary_completion_date":{"date":"2020-10-05","type":"ACTUAL"},"primary_outcomes":[{"measure":"Change From Baseline in Hemoglobin A1c (HbA1c)","time_frame":"Baseline, Week 40"}],"results_first_posted":"2021-10-20","sites":[{"city":"Telangana","country":"India","facility":"Gandhi Hospital","lat":null,"lon":null,"state":null,"status":null},{"city":"Ahmedabad","country":"India","facility":"Dr. Jivraj Mehta Smarak Health Foundation","lat":23.02579,"lon":72.58727,"state":"Gujarat","status":null},{"city":"Bangalore","country":"India","facility":"Bangalore Medical College and Research Institute","lat":12.97194,"lon":77.59369,"state":"Karnataka","status":null},{"city":"Bangalore","country":"India","facility":"M S Ramaiah Medical College Hospital","lat":12.97194,"lon":77.59369,"state":"Karnataka","status":null},{"city":"Mumbai","country":"India","facility":"BSES Municipa